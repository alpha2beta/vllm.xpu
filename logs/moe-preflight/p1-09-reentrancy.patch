+#!/usr/bin/env python3
+"""P1-01 dispatch tests: dense -> Exl3LinearMethod, experts -> Exl3MoEMethod.
+
+Runs as a plain script (this venv has no pytest):
+
+    .venv/bin/python tests/test_dispatch.py [--verbose]
+
+Every case exercises ``Exl3Config.get_quant_method`` through vLLM's real
+``resolve_quant_method`` helper, so the tests cover the exact seam that used to
+produce ``UnquantizedFusedMoEMethod`` (``routed_experts.py:219-220``).
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+import traceback
+import types
+from collections.abc import Callable
+
+import torch
+from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
+from vllm.model_executor.layers.fused_moe.unquantized_fused_moe_method import (
+    UnquantizedFusedMoEMethod,
+)
+from vllm.model_executor.layers.linear import LinearBase, UnquantizedLinearMethod
+from vllm.model_executor.layers.quantization.base_config import resolve_quant_method
+
+from exl3xpu.moe import Exl3MoEMethod, Exl3MoEUnsupported
+from exl3xpu.vllm_plugin import Exl3Config, Exl3LinearMethod
+
+DENSE_PREFIX = "layers.0.mlp.gate_proj"
+UNQUANTIZED_DENSE_PREFIX = "layers.0.mlp.shared_expert_gate"
+EXPERTS_PREFIX = "layers.0.mlp.experts"
+
+
+# ---------------------------------------------------------------------------
+# fixtures
+# ---------------------------------------------------------------------------
+
+def expert_storage(
+    num_experts: int = 256,
+    K: int = 3,
+    skip: tuple[str, ...] = (),
+    overrides: dict[str, int] | None = None,
+) -> dict[str, int]:
+    """Checkpoint storage map for one routed-expert layer."""
+    st: dict[str, int] = {}
+    for e in range(num_experts):
+        for proj in ("gate_proj", "up_proj", "down_proj"):
+            st[f"{EXPERTS_PREFIX}.{e}.{proj}"] = K
+    for key in skip:
+        st.pop(key, None)
+    st.update(overrides or {})
+    return st
+
+
+def dense_storage() -> dict[str, int]:
+    # K=4 is what the real checkpoint uses for attention/shared-expert linears.
+    return {
+        DENSE_PREFIX: 4,
+        "layers.0.mlp.up_proj": 4,
+        "layers.0.mlp.down_proj": 4,
+        "lm_head": 6,
+    }
+
+
+def make_config(storage: dict[str, int], codebook: str = "mcg") -> Exl3Config:
+    cfg = Exl3Config(bits=3, head_bits=6, codebook=codebook, storage=dict(storage))
+    # One real-shaped entry exercises the member_trellis (n, K) path.
+    if f"{EXPERTS_PREFIX}.0.gate_proj" in cfg.storage:
+        cfg.member_trellis = {
+            f"{EXPERTS_PREFIX}.0.gate_proj": (512, cfg.storage[f"{EXPERTS_PREFIX}.0.gate_proj"]),
+        }
+    return cfg
+
+
+def dense_layer() -> LinearBase:
+    return object.__new__(LinearBase)
+
+
+def experts_layer(
+    num_experts: int = 256, tp_size: int = 1, ep_size: int = 1
+) -> RoutedExperts:
+    layer = object.__new__(RoutedExperts)
+    layer.layer_name = EXPERTS_PREFIX
+    layer.moe_config = types.SimpleNamespace(
+        num_experts=num_experts,
+        num_local_experts=num_experts,
+        hidden_dim=2048,
+        intermediate_size_per_partition=512,
+        activation="silu",
+        moe_parallel_config=types.SimpleNamespace(
+            tp_size=tp_size, ep_size=ep_size, use_ep=ep_size > 1
+        ),
+    )
+    layer.ckpt_gate_proj_name = "gate_proj"
+    layer.ckpt_up_proj_name = "up_proj"
+    layer.ckpt_down_proj_name = "down_proj"
+    return layer
+
+
+# ---------------------------------------------------------------------------
+# cases
+# ---------------------------------------------------------------------------
+
+def case_dense_resolves_to_exl3() -> None:
+    cfg = make_config(dense_storage())
+    method = resolve_quant_method(cfg, dense_layer(), DENSE_PREFIX)
+    assert isinstance(method, Exl3LinearMethod), type(method)
+    assert method.K == 4 and method.cb == 1, (method.K, method.cb)
+
+
+def case_unquantized_dense_still_unquantized() -> None:
+    cfg = make_config(dense_storage())
+    method = resolve_quant_method(cfg, dense_layer(), UNQUANTIZED_DENSE_PREFIX)
+    assert isinstance(method, UnquantizedLinearMethod), type(method)
+
+
+def case_experts_resolve_to_exl3_moe() -> None:
+    cfg = make_config(expert_storage())
+    layer = experts_layer()
+    method = resolve_quant_method(cfg, layer, EXPERTS_PREFIX)
+    assert isinstance(method, Exl3MoEMethod), type(method)
+    assert not isinstance(method, UnquantizedFusedMoEMethod)
+    assert method.K == 3 and method.cb == 1, (method.K, method.cb)
+    assert method.num_local_experts == 256
+    # Modular-kernel contract: no vLLM fused-MoE kernel, runner computes top-k
+    # and calls apply().
+    assert method.moe_kernel is None
+    assert method.supports_internal_mk is False
+    assert method.is_monolithic is False
+    assert method.get_fused_moe_quant_config(layer) is None
+
+
+def case_experts_direct_get_quant_method() -> None:
+    cfg = make_config(expert_storage())
+    method = cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX)
+    assert isinstance(method, Exl3MoEMethod), type(method)
+
+
+def case_model_qualified_prefix_normalizes() -> None:
+    # vLLM passes the full model prefix; checkpoint keys are normalized.
+    cfg = make_config(expert_storage())
+    qualified = "model.language_model.layers.0.mlp.experts"
+    method = cfg.get_quant_method(experts_layer(), qualified)
+    assert isinstance(method, Exl3MoEMethod), type(method)
+    assert method.key_prefix == EXPERTS_PREFIX, method.key_prefix
+
+
+def case_apply_stub_fails_closed() -> None:
+    cfg = make_config(expert_storage())
+    layer = experts_layer()
+    method = cfg.get_quant_method(layer, EXPERTS_PREFIX)
+    # P1-02 is implemented; execution (P1-03) must still refuse silently-wrong
+    # output and there is no fallback path.
+    try:
+        method.apply(layer, torch.zeros(4, 2048), torch.zeros(4, 8), torch.zeros(4, 8, dtype=torch.int32), None, None)
+    except NotImplementedError as exc:
+        assert "P1-06" in str(exc), exc
+    else:
+        raise AssertionError("apply must not silently succeed before P1-06")
+
+
+def expect_unsupported(
+    fn: Callable[[], object], contains: str, label: str
+) -> None:
+    try:
+        fn()
+    except Exl3MoEUnsupported as exc:
+        assert contains in str(exc), f"{label}: expected {contains!r} in {exc!s}"
+    else:
+        raise AssertionError(f"{label}: expected Exl3MoEUnsupported, got a method")
+
+
+def case_no_expert_tensors_raise() -> None:
+    cfg = make_config(dense_storage())
+    layer = experts_layer()
+    expect_unsupported(
+        lambda: cfg.get_quant_method(layer, EXPERTS_PREFIX),
+        "no EXL3 expert tensors",
+        "unquantized MoE",
+    )
+
+
+def case_partial_expert_raises() -> None:
+    st = expert_storage(skip=(f"{EXPERTS_PREFIX}.7.down_proj",))
+    cfg = make_config(st)
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "expert 7 is missing quantized projections ['down_proj']",
+        "partial expert",
+    )
+
+
+def case_expert_count_mismatch_raises() -> None:
+    cfg = make_config(expert_storage(num_experts=255))
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "checkpoint has 255 experts",
+        "expert count",
+    )
+
+
+def case_mixed_K_raises() -> None:
+    st = expert_storage(overrides={f"{EXPERTS_PREFIX}.0.gate_proj": 4})
+    cfg = make_config(st)
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "mixed trellis K",
+        "mixed K",
+    )
+
+
+def case_unsupported_K_raises() -> None:
+    cfg = make_config(expert_storage(K=5))
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "no ESIMD kernel for K=5",
+        "unsupported K",
+    )
+
+
+def case_empty_storage_raises() -> None:
+    cfg = make_config({})
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "storage map is empty",
+        "empty storage",
+    )
+
+
+def case_tp_ep_raise() -> None:
+    cfg = make_config(expert_storage())
+    for kwargs, label in (
+        ({"tp_size": 2}, "tp>1"),
+        ({"ep_size": 2}, "ep>1"),
+    ):
+        expect_unsupported(
+            lambda kw=kwargs: cfg.get_quant_method(experts_layer(**kw), EXPERTS_PREFIX),
+            "parallelism is not supported",
+            label,
+        )
+
+
+def case_unknown_codebook_raises() -> None:
+    cfg = make_config(expert_storage(), codebook="mul2")
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "unknown codebook",
+        "unknown codebook",
+    )
+
+
+def case_no_unquantized_symbol_in_moe_module() -> None:
+    import exl3xpu.moe as moe_mod
+
+    src = open(moe_mod.__file__).read()
+    # The MoE adapter must not import or construct the forbidden fallback. The
+    # class name may appear in prose (docstrings explain why), so key off code
+    # constructs only.
+    assert "import UnquantizedFusedMoEMethod" not in src
+    assert "UnquantizedFusedMoEMethod(" not in src
+
+
+CASES: list[tuple[str, Callable[[], None]]] = [
+    ("dense linear -> Exl3LinearMethod", case_dense_resolves_to_exl3),
+    ("unquantized dense stays unquantized", case_unquantized_dense_still_unquantized),
+    ("routed experts -> Exl3MoEMethod", case_experts_resolve_to_exl3_moe),
+    ("direct get_quant_method -> Exl3MoEMethod", case_experts_direct_get_quant_method),
+    ("model-qualified prefix normalizes", case_model_qualified_prefix_normalizes),
+    ("apply stub fails closed", case_apply_stub_fails_closed),
+    ("unquantized MoE raises", case_no_expert_tensors_raise),
+    ("partially-quantized expert raises", case_partial_expert_raises),
+    ("expert-count mismatch raises", case_expert_count_mismatch_raises),
+    ("mixed-K experts raise", case_mixed_K_raises),
+    ("unsupported K raises", case_unsupported_K_raises),
+    ("empty storage raises", case_empty_storage_raises),
+    ("TP/EP raise", case_tp_ep_raise),
+    ("unknown codebook raises", case_unknown_codebook_raises),
+    ("moe.py has no unquantized fallback", case_no_unquantized_symbol_in_moe_module),
+]
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--verbose", action="store_true")
+    ap.add_argument("--json-out", type=str, default=None,
+                    help="write a machine-readable summary (evidence artifact)")
+    args = ap.parse_args()
+
+    failures: list[str] = []
+    results: list[dict] = []
+    for name, fn in CASES:
+        try:
+            fn()
+        except Exception as exc:
+            failures.append(name)
+            results.append({"case": name, "ok": False, "error": f"{type(exc).__name__}: {exc}"})
+            print(f"FAIL {name}")
+            if args.verbose:
+                traceback.print_exc()
+        else:
+            results.append({"case": name, "ok": True})
+            print(f"OK   {name}")
+
+    print(f"\n{len(CASES) - len(failures)}/{len(CASES)} dispatch cases pass")
+
+    if args.json_out:
+        import hashlib
+        import json
+        from pathlib import Path
+
+        import exl3xpu.moe as moe_mod
+        from exl3xpu import ops
+
+        def sha(path: str) -> str:
+            return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+        summary = {
+            "task": "P1-01",
+            "pass": not failures,
+            "cases": results,
+            "failures": failures,
+            "device": torch.xpu.get_device_properties(0).name,
+            "torch": torch.__version__,
+            "requested_backend": __import__("os").environ.get("EXL3_BACKEND", "auto"),
+            "small_m_max_k3_cb1": ops.small_m_max(3, 1),
+            "moe_method_module": moe_mod.__file__,
+            "moe_method_sha256": sha(moe_mod.__file__),
+            "test_sha256": sha(__file__),
+        }
+        Path(args.json_out).write_text(json.dumps(summary, indent=2) + "\n")
+        print(f"wrote {args.json_out}")
+
+    if failures:
+        print("failures:", failures)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_expert_mlp.py
--- a/tests/test_expert_mlp.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_expert_mlp.py	2026-10-24 09:50:05.629020187 +0200
@@ -0,0 +1,373 @@
+#!/usr/bin/env python3
+"""P1-07: single-expert MLP forward pass on XPU.
+
+Runs the full routed-expert MLP for one expert through the production fused op
+(``exl3xpu.ops.exl3_linear``):
+
+    x -> gate = linear(x)          # FWHT(x*su) -> GEMV -> FWHT(.)*sv
+       -> up   = linear(x)
+       -> h    = SiLU(gate) * up   # activation strictly post-Hadamard
+       -> y    = linear(h)         # down projection, same transforms
+
+and compares it with the CPU dequantized reference MLP built from
+``exl3xpu.ref.weight_orig`` (fp32), gating on the P0-09 tolerances:
+
+* T-2  ``max_abs <= 0.08`` for M in {1,2,4,8};
+* T-5  repeat run is bit-identical;
+* T-6  zero NaN/Inf.
+
+It also replays the P0-08 oracle trace inputs for experts 0/255 and checks the
+end-to-end MLP output against ``expert/{id}/down_proj/y``.
+
+    .venv/bin/python tests/test_expert_mlp.py
+
+Evidence: ``logs/moe-p1/single-expert-eval.log`` (+ ``--json-out``).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import traceback
+from collections.abc import Callable
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from safetensors import safe_open
+
+from exl3xpu import ops
+from exl3xpu import ref
+
+ROOT = Path(__file__).resolve().parents[1]
+FIXTURES = ROOT / "fixtures" / "exl3-moe" / "moe-fixtures.safetensors"
+TRACES = ROOT / "fixtures" / "reference_moe_traces.npz"
+DEFAULT_MODEL = "/home/yanchun/models/Qwen3.5-35B-A3B-exl3-3.09bpw"
+PROJECTIONS = ("gate_proj", "up_proj", "down_proj")
+T2_MAX_ABS = 0.08
+M_VALUES = (1, 2, 4, 8)
+
+
+class ShardSource:
+    def __init__(self, model_dir: Path, layer: int):
+        self.model_dir = model_dir
+        self.layer = layer
+        self.prefix = f"model.language_model.layers.{layer}.mlp.experts"
+        self.weight_map = json.loads(
+            (model_dir / "model.safetensors.index.json").read_text()
+        )["weight_map"]
+        self._handles: dict[str, object] = {}
+
+    def _handle(self, shard: str):
+        if shard not in self._handles:
+            self._handles[shard] = safe_open(str(self.model_dir / shard), framework="pt")
+        return self._handles[shard]
+
+    def has(self, expert: int) -> bool:
+        key = f"{self.prefix}.{expert}.gate_proj.trellis"
+        shard = self.weight_map.get(key)
+        return shard is not None and (self.model_dir / shard).is_file()
+
+    def get(self, expert: int, proj: str, suffix: str) -> torch.Tensor:
+        key = f"{self.prefix}.{expert}.{proj}.{suffix}"
+        return self._handle(self.weight_map[key]).get_tensor(key)
+
+    def codebook(self, expert: int, proj: str) -> int:
+        for suffix, cb in (("mcg", ref.CB_MCG), ("mul1", ref.CB_MUL1)):
+            if f"{self.prefix}.{expert}.{proj}.{suffix}" in self.weight_map:
+                return cb
+        return ref.CB_3INST
+
+
+class FixtureSource:
+    def __init__(self, layer: int):
+        self.layer = layer
+        self.prefix = f"model.language_model.layers.{layer}.mlp.experts"
+        self._f = safe_open(str(FIXTURES), framework="pt")
+        self._keys = set(self._f.keys())
+
+    def has(self, expert: int) -> bool:
+        return f"{self.prefix}.{expert}.gate_proj.trellis" in self._keys
+
+    def get(self, expert: int, proj: str, suffix: str) -> torch.Tensor:
+        return self._f.get_tensor(f"{self.prefix}.{expert}.{proj}.{suffix}")
+
+    def codebook(self, expert: int, proj: str) -> int:
+        if f"{self.prefix}.{expert}.{proj}.mcg" in self._keys:
+            return ref.CB_MCG
+        if f"{self.prefix}.{expert}.{proj}.mul1" in self._keys:
+            return ref.CB_MUL1
+        return ref.CB_3INST
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+
+def load_modules(source, expert: int) -> dict[str, dict]:
+    out = {}
+    for proj in PROJECTIONS:
+        trellis = source.get(expert, proj, "trellis")
+        suh = source.get(expert, proj, "suh")
+        svh = source.get(expert, proj, "svh")
+        out[proj] = {
+            "trellis": trellis,
+            "suh": suh,
+            "svh": svh,
+            "K": trellis.shape[-1] // 16,
+            "cb": source.codebook(expert, proj),
+            "k": trellis.shape[0] * 16,
+            "n": trellis.shape[1] * 16,
+        }
+    return out
+
+
+def reference_mlp(x: torch.Tensor, modules: dict[str, dict]) -> tuple[torch.Tensor, dict]:
+    """Literal fp32 dequantized MLP in the original basis (CPU)."""
+    w = {
+        proj: ref.weight_orig(
+            m["trellis"].cpu(), m["suh"].cpu(), m["svh"].cpu(), m["K"], m["cb"]
+        )
+        for proj, m in modules.items()
+    }
+    g = x.float() @ w["gate_proj"]
+    u = x.float() @ w["up_proj"]
+    h = F.silu(g) * u
+    y = h @ w["down_proj"]
+    return y, {"gate": g, "up": u, "act": h}
+
+
+def kernel_mlp(x: torch.Tensor, modules: dict[str, dict]) -> tuple[torch.Tensor, dict]:
+    """Production fused path (all transforms inside ``ops.exl3_linear``)."""
+    def lin(t: torch.Tensor, m: dict) -> torch.Tensor:
+        n = m["n"]
+        nb = torch.zeros(n // 128, dtype=torch.int32, device=t.device)
+        return ops.exl3_linear(
+            t, m["trellis"], m["suh"], m["svh"], nb, [0, n], m["K"], m["cb"]
+        )
+
+    g = lin(x, modules["gate_proj"])
+    u = lin(x, modules["up_proj"])
+    h = F.silu(g) * u
+    y = lin(h, modules["down_proj"])
+    return y, {"gate": g, "up": u, "act": h}
+
+
+def metrics(got: torch.Tensor, want: torch.Tensor) -> dict[str, float]:
+    a = got.float()
+    b = want.float()
+    diff = (a - b).abs()
+    denom = b.abs().clamp_min(1e-3)
+    return {
+        "max_abs": float(diff.max().item()) if diff.numel() else 0.0,
+        "p99_abs": float(torch.quantile(diff.flatten(), 0.99).item())
+        if diff.numel() else 0.0,
+        "max_rel": float((diff / denom).max().item()) if diff.numel() else 0.0,
+        "nan_inf": int(torch.isnan(a).sum().item() + torch.isinf(a).sum().item()),
+    }
+
+
+def make_x(m: int, k: int, dtype: torch.dtype, seed: int) -> torch.Tensor:
+    g = torch.Generator(device="cpu").manual_seed(seed + m)
+    x = (torch.randn((m, k), generator=g, dtype=torch.float32) * 0.05).to(dtype)
+    return x
+
+
+# ---------------------------------------------------------------------------
+# cases
+# ---------------------------------------------------------------------------
+
+def case_mlp_vs_dequantized(source, expert: int, dtype_name: str,
+                            records: list[dict]) -> None:
+    dtype = {"float16": torch.float16, "bfloat16": torch.bfloat16}[dtype_name]
+    modules = load_modules(source, expert)
+    device = "xpu"
+    mods = {
+        proj: {
+            **m,
+            "trellis": m["trellis"].to(device),
+            "suh": m["suh"].to(device),
+            "svh": m["svh"].to(device),
+        }
+        for proj, m in modules.items()
+    }
+    k = modules["gate_proj"]["k"]
+    for m_tokens in M_VALUES:
+        x = make_x(m_tokens, k, dtype, seed=1234).to(device)
+        y_k, parts_k = kernel_mlp(x, mods)
+        y_k2, _ = kernel_mlp(x, mods)
+        y_ref, parts_ref = reference_mlp(x.cpu(), modules)
+
+        stat = metrics(y_k.cpu(), y_ref)
+        stat_gate = metrics(parts_k["gate"].cpu(), parts_ref["gate"])
+        stat_up = metrics(parts_k["up"].cpu(), parts_ref["up"])
+        stat_down = metrics(y_k.cpu(), y_ref)
+        det = bool(torch.equal(y_k, y_k2))
+        ok = (
+            stat["max_abs"] <= T2_MAX_ABS
+            and stat["nan_inf"] == 0
+            and det
+            and all(s["nan_inf"] == 0 for s in (stat_gate, stat_up, stat_down))
+        )
+        records.append({
+            "case": "mlp_vs_dequantized",
+            "expert": expert,
+            "dtype": dtype_name,
+            "M": m_tokens,
+            "K": modules["gate_proj"]["K"],
+            "cb": modules["gate_proj"]["cb"],
+            "down_max_abs": stat["max_abs"],
+            "down_p99_abs": stat["p99_abs"],
+            "down_max_rel": stat["max_rel"],
+            "gate_max_abs": stat_gate["max_abs"],
+            "up_max_abs": stat_up["max_abs"],
+            "deterministic": det,
+            "nan_inf": stat["nan_inf"],
+            "T2_pass": stat["max_abs"] <= T2_MAX_ABS,
+            "pass": ok,
+        })
+        assert ok, (expert, dtype_name, m_tokens, stat, det)
+
+
+def case_trace_mlp(source, expert: int, records: list[dict]) -> None:
+    """Replay the P0-08 trace input through the real MLP for one expert."""
+    if not TRACES.is_file():
+        records.append({"case": "trace_mlp", "expert": expert, "status": "missing"})
+        return
+    data = np.load(TRACES)
+    key = f"expert/{expert}/down_proj/y"
+    if key not in data or not source.has(expert):
+        records.append({"case": "trace_mlp", "expert": expert, "status": "missing"})
+        return
+    modules = load_modules(source, expert)
+    mods = {
+        proj: {
+            **m,
+            "trellis": m["trellis"].to("xpu"),
+            "suh": m["suh"].to("xpu"),
+            "svh": m["svh"].to("xpu"),
+        }
+        for proj, m in modules.items()
+    }
+    x = torch.from_numpy(data["inputs/x"].copy()).to(torch.float16).to("xpu")
+    y_k, _ = kernel_mlp(x, mods)
+    want = torch.from_numpy(data[key].copy()).float()
+    stat = metrics(y_k.cpu(), want)
+    ok = stat["max_abs"] <= T2_MAX_ABS and stat["nan_inf"] == 0
+    records.append({
+        "case": "trace_mlp",
+        "expert": expert,
+        "M": int(x.shape[0]),
+        "max_abs": stat["max_abs"],
+        "p99_abs": stat["p99_abs"],
+        "max_rel": stat["max_rel"],
+        "nan_inf": stat["nan_inf"],
+        "T2_pass": stat["max_abs"] <= T2_MAX_ABS,
+        "pass": ok,
+    })
+    assert ok, (expert, stat)
+
+
+# ---------------------------------------------------------------------------
+# runner
+# ---------------------------------------------------------------------------
+
+def make_source(model_dir: Path, layer: int):
+    index = model_dir / "model.safetensors.index.json"
+    if index.is_file():
+        src = ShardSource(model_dir, layer)
+        if any(src.has(e) for e in (0, 255)):
+            return src, "checkpoint"
+    if layer == 0:
+        src = FixtureSource(layer)
+        if any(src.has(e) for e in (0, 255)):
+            return src, "fixtures"
+    raise SystemExit(f"no EXL3 expert tensors available ({model_dir}, layer {layer})")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--expert", type=int, default=0)
+    ap.add_argument("--dtypes", nargs="*", default=["float16", "bfloat16"])
+    ap.add_argument("--log-out", default=str(ROOT / "logs/moe-p1/single-expert-eval.log"))
+    ap.add_argument("--json-out", default=str(ROOT / "logs/moe-p1/single-expert-eval.json"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not torch.xpu.is_available():
+        raise SystemExit("P1-07 needs the XPU; none available")
+    assert bool(ops._get_esimd().exl3_supported(3, 1)), "no (K=3, cb=1) kernel"
+
+    source, source_kind = make_source(Path(args.model_dir), args.layer)
+    records: list[dict] = []
+    failures: list[str] = []
+
+    cases: list[tuple[str, Callable[[], None]]] = []
+    for dtype_name in args.dtypes:
+        cases.append((
+            f"MLP vs dequantized ({dtype_name}, expert {args.expert})",
+            lambda d=dtype_name: case_mlp_vs_dequantized(source, args.expert, d, records),
+        ))
+    for expert in (0, 255):
+        if source.has(expert):
+            cases.append((
+                f"P0-08 trace MLP (expert {expert})",
+                lambda e=expert: case_trace_mlp(source, e, records),
+            ))
+
+    results = []
+    for label, fn in cases:
+        try:
+            fn()
+            results.append({"case": label, "pass": True})
+            print(f"OK   {label}")
+        except Exception as exc:  # noqa: BLE001
+            failures.append(f"{label}: {exc}")
+            results.append({"case": label, "pass": False, "error": str(exc)})
+            print(f"FAIL {label}: {exc}")
+            if args.verbose:
+                traceback.print_exc()
+
+    passes = [r for r in records if r.get("pass") is not None]
+    summary = {
+        "task": "P1-07",
+        "pass": not failures and all(r["pass"] for r in passes),
+        "source": source_kind,
+        "model_dir": str(args.model_dir),
+        "layer": args.layer,
+        "device": torch.xpu.get_device_properties(0).name,
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "cases": results,
+        "failures": failures,
+        "records": records,
+        "worst_max_abs": max((r.get("down_max_abs", r.get("max_abs", 0.0))
+                              for r in records), default=0.0),
+    }
+
+    log_path = Path(args.log_out)
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    lines = [
+        f"P1-07 single-expert MLP  source={source_kind} layer={args.layer}",
+        f"T2_max_abs={T2_MAX_ABS} worst={summary['worst_max_abs']:.6g}",
+    ]
+    for r in records:
+        lines.append("  " + json.dumps(r, sort_keys=True))
+    lines.append(f"pass={summary['pass']} failures={failures}")
+    log_path.write_text("\n".join(lines) + "\n")
+
+    if args.json_out:
+        out = Path(args.json_out)
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(summary, indent=2) + "\n")
+
+    print(f"\nworst max_abs={summary['worst_max_abs']:.6g} (T-2 <= {T2_MAX_ABS}); "
+          f"wrote {log_path}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_batch_sweep.py
--- a/tests/test_batch_sweep.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_batch_sweep.py	2026-10-24 09:55:47.896994825 +0200
@@ -0,0 +1,421 @@
+#!/usr/bin/env python3
+"""P1-08: token-batch sweep (M=0..256) + empty-work + crossover calibration.
+
+Sweeps the single-expert routed MLP over ``M in {0,1,2,4,8,16,32,64,128,256}``:
+
+* validates every M against the fp32 dequantized reference (P0-09 T-2/T-6);
+* proves **M=0 exits with zero XPU kernel launches** (XPU profiler);
+* measures the fused vector path (``exl3_gemm_small``) against the
+  reconstruct+GEMM path (``exl3_reconstruct`` + oneDNN fp16 GEMM) and records
+  the per-M times / speedup used to justify the small/large-M threshold.
+
+Arc 140V has no XMX/DPAS units, so "dequantize+XMX GEMM" is measured as the
+production large-M path: reconstruct the Hadamard-domain fp16 weight then oneDNN
+fp16 GEMM (the same code path ``ops.exl3_linear`` takes for M > small_m_max).
+
+    .venv/bin/python tests/test_batch_sweep.py
+
+Evidence: ``logs/moe-p1/crossover-calibration.json``,
+``logs/moe-p1/batch-sweep.log``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import statistics
+import time
+import traceback
+from collections.abc import Callable
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from safetensors import safe_open
+from torch.profiler import ProfilerActivity, profile
+
+from exl3xpu import ops
+from exl3xpu import ref
+
+ROOT = Path(__file__).resolve().parents[1]
+FIXTURES = ROOT / "fixtures" / "exl3-moe" / "moe-fixtures.safetensors"
+DEFAULT_MODEL = "/home/yanchun/models/Qwen3.5-35B-A3B-exl3-3.09bpw"
+PROJECTIONS = ("gate_proj", "up_proj", "down_proj")
+M_VALUES = (0, 1, 2, 4, 8, 16, 32, 64, 128, 256)
+T2_MAX_ABS = 0.08
+FUSED_M = (1, 2, 4, 8)  # largest M the no-DPAS vector kernel instantiates
+
+
+# ---------------------------------------------------------------------------
+# source
+# ---------------------------------------------------------------------------
+
+class ShardSource:
+    def __init__(self, model_dir: Path, layer: int):
+        self.model_dir = model_dir
+        self.prefix = f"model.language_model.layers.{layer}.mlp.experts"
+        self.weight_map = json.loads(
+            (model_dir / "model.safetensors.index.json").read_text()
+        )["weight_map"]
+        self._handles: dict[str, object] = {}
+
+    def _handle(self, shard: str):
+        if shard not in self._handles:
+            self._handles[shard] = safe_open(str(self.model_dir / shard), framework="pt")
+        return self._handles[shard]
+
+    def has(self, expert: int) -> bool:
+        key = f"{self.prefix}.{expert}.gate_proj.trellis"
+        shard = self.weight_map.get(key)
+        return shard is not None and (self.model_dir / shard).is_file()
+
+    def get(self, expert: int, proj: str, suffix: str) -> torch.Tensor:
+        key = f"{self.prefix}.{expert}.{proj}.{suffix}"
+        return self._handle(self.weight_map[key]).get_tensor(key)
+
+    def codebook(self, expert: int, proj: str) -> int:
+        for suffix, cb in (("mcg", ref.CB_MCG), ("mul1", ref.CB_MUL1)):
+            if f"{self.prefix}.{expert}.{proj}.{suffix}" in self.weight_map:
+                return cb
+        return ref.CB_3INST
+
+
+class FixtureSource:
+    def __init__(self, layer: int):
+        self.prefix = f"model.language_model.layers.{layer}.mlp.experts"
+        self._f = safe_open(str(FIXTURES), framework="pt")
+        self._keys = set(self._f.keys())
+
+    def has(self, expert: int) -> bool:
+        return f"{self.prefix}.{expert}.gate_proj.trellis" in self._keys
+
+    def get(self, expert: int, proj: str, suffix: str) -> torch.Tensor:
+        return self._f.get_tensor(f"{self.prefix}.{expert}.{proj}.{suffix}")
+
+    def codebook(self, expert: int, proj: str) -> int:
+        if f"{self.prefix}.{expert}.{proj}.mcg" in self._keys:
+            return ref.CB_MCG
+        if f"{self.prefix}.{expert}.{proj}.mul1" in self._keys:
+            return ref.CB_MUL1
+        return ref.CB_3INST
+
+
+# ---------------------------------------------------------------------------
+# MLP
+# ---------------------------------------------------------------------------
+
+def load_modules(source, expert: int, device: str = "xpu") -> dict[str, dict]:
+    out = {}
+    for proj in PROJECTIONS:
+        tr = source.get(expert, proj, "trellis")
+        n = tr.shape[1] * 16
+        out[proj] = {
+            "trellis": tr.to(device),
+            # Production dense contract: suh is [num_groups, k]. A 1-D suh
+            # makes the C++ set S=k and run k copies of the input Hadamard.
+            "suh": source.get(expert, proj, "suh").view(1, -1).to(device),
+            "svh": source.get(expert, proj, "svh").to(device),
+            # Precomputed once per module, exactly like
+            # Exl3LinearMethod.process_weights_after_loading.
+            "nb": torch.zeros(n // 128, dtype=torch.int32, device=device),
+            "K": tr.shape[-1] // 16,
+            "cb": source.codebook(expert, proj),
+            "k": tr.shape[0] * 16,
+            "n": n,
+            "trellis_cpu": tr,
+            "suh_cpu": source.get(expert, proj, "suh"),
+            "svh_cpu": source.get(expert, proj, "svh"),
+        }
+    return out
+
+
+def lin_call(x: torch.Tensor, m: dict) -> torch.Tensor:
+    """One linear using the module's precomputed ``shard_of_nb``."""
+    return ops.exl3_linear(
+        x, m["trellis"], m["suh"], m["svh"], m["nb"], [0, m["n"]], m["K"], m["cb"]
+    )
+
+
+def kernel_mlp(x: torch.Tensor, modules: dict[str, dict]) -> tuple[torch.Tensor, dict]:
+    def lin(t, m):
+        return lin_call(t, m)
+
+    g = lin(x, modules["gate_proj"])
+    u = lin(x, modules["up_proj"])
+    h = F.silu(g) * u
+    y = lin(h, modules["down_proj"])
+    return y, {"gate": g, "up": u, "act": h}
+
+
+def reference_mlp(x: torch.Tensor, modules: dict[str, dict]) -> torch.Tensor:
+    w = {
+        p: ref.weight_orig(m["trellis_cpu"], m["suh_cpu"], m["svh_cpu"], m["K"], m["cb"])
+        for p, m in modules.items()
+    }
+    g = x.float() @ w["gate_proj"]
+    u = x.float() @ w["up_proj"]
+    h = F.silu(g) * u
+    return h @ w["down_proj"]
+
+
+def metrics(got: torch.Tensor, want: torch.Tensor) -> dict[str, float]:
+    a, b = got.float(), want.float()
+    diff = (a - b).abs()
+    return {
+        "max_abs": float(diff.max().item()) if diff.numel() else 0.0,
+        "p99_abs": float(torch.quantile(diff.flatten(), 0.99).item()) if diff.numel() else 0.0,
+        "nan_inf": int(torch.isnan(a).sum().item() + torch.isinf(a).sum().item()),
+    }
+
+
+def make_x(m: int, k: int, seed: int = 1234) -> torch.Tensor:
+    g = torch.Generator(device="cpu").manual_seed(seed + m)
+    return (torch.randn((m, k), generator=g) * 0.05).half().to("xpu")
+
+
+# ---------------------------------------------------------------------------
+# measurement
+# ---------------------------------------------------------------------------
+
+def xpu_kernel_count(fn: Callable[[], object]) -> tuple[int, float]:
+    """Run fn under the XPU profiler; return (kernel launches, total XPU us).
+
+    ``key_averages`` aggregates by kernel name, so the launch count is the sum
+    of ``count`` over rows that actually spent time on the device.
+    """
+    with profile(activities=[ProfilerActivity.XPU]) as prof:
+        fn()
+        torch.xpu.synchronize()
+    rows = [r for r in prof.key_averages() if getattr(r, "self_device_time_total", 0) > 0]
+    return sum(int(r.count) for r in rows), sum(r.self_device_time_total for r in rows)
+
+
+def bench(fn: Callable[[], object], warmup: int = 3, iters: int = 10) -> float:
+    for _ in range(warmup):
+        fn()
+    torch.xpu.synchronize()
+    ts = []
+    for _ in range(iters):
+        torch.xpu.synchronize()
+        t0 = time.perf_counter()
+        fn()
+        torch.xpu.synchronize()
+        ts.append(time.perf_counter() - t0)
+    return statistics.median(ts)
+
+
+# ---------------------------------------------------------------------------
+# cases
+# ---------------------------------------------------------------------------
+
+def case_batch_sweep(source, expert: int, records: list[dict]) -> None:
+    modules = load_modules(source, expert)
+    k = modules["gate_proj"]["k"]
+    for m_tokens in M_VALUES:
+        x = make_x(m_tokens, k)
+        y_k, parts = kernel_mlp(x, modules)
+        ok = True
+        rec = {"M": m_tokens, "out_shape": list(y_k.shape), "dtype": str(y_k.dtype).removeprefix("torch.")}
+        if m_tokens == 0:
+            # Empty work: exact zero-size output, finite (empty) tensors.
+            ok = all(t.numel() == 0 for t in (y_k, parts["gate"], parts["up"], parts["act"]))
+            rec["empty"] = True
+            rec["zero_sized"] = ok
+            rec["nan_inf"] = 0
+        else:
+            ref_y = reference_mlp(x.cpu(), modules)
+            stat = metrics(y_k.cpu(), ref_y)
+            ok = stat["max_abs"] <= T2_MAX_ABS and stat["nan_inf"] == 0
+            rec.update(stat)
+            rec["T2_pass"] = stat["max_abs"] <= T2_MAX_ABS
+        rec["pass"] = ok
+        records.append(rec)
+        assert ok, (m_tokens, rec)
+
+
+def case_m0_zero_kernels(source, expert: int, records: list[dict]) -> None:
+    modules = load_modules(source, expert)
+    k = modules["gate_proj"]["k"]
+    x0 = torch.empty((0, k), dtype=torch.float16, device="xpu")
+    # Isolate the EXL3 op so SiLU/mul bookkeeping cannot be mistaken for it.
+    n_lin, us_lin = xpu_kernel_count(lambda: lin_call(x0, modules["gate_proj"]))
+    # Full MLP with M=0 too: no projection may launch a kernel.
+    n_mlp, us_mlp = xpu_kernel_count(lambda: kernel_mlp(x0, modules))
+    rec = {
+        "M": 0,
+        "exl3_linear_kernels": n_lin,
+        "exl3_linear_device_us": us_lin,
+        "full_mlp_kernels": n_mlp,
+        "full_mlp_device_us": us_mlp,
+        "pass": n_lin == 0 and n_mlp == 0,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_crossover(source, expert: int, records: list[dict]) -> None:
+    modules = load_modules(source, expert)
+    gate = modules["gate_proj"]
+    k, n = gate["k"], gate["n"]
+    orig_small_m_max = ops.small_m_max
+
+    rows = []
+
+    def fused(m_tokens):
+        x = make_x(m_tokens, k)
+        return bench(lambda: lin_call(x, gate))
+
+    def recon_gemm(m_tokens):
+        x = make_x(m_tokens, k)
+        # Force the production large-M path by reporting no small-M support.
+        ops.small_m_max = lambda K, cb: 0
+        try:
+            return bench(lambda: lin_call(x, gate))
+        finally:
+            ops.small_m_max = orig_small_m_max
+
+    for m_tokens in M_VALUES:
+        if m_tokens == 0:
+            continue
+        row = {"M": m_tokens}
+        if m_tokens in FUSED_M:
+            tf = fused(m_tokens)
+            row["fused_ms"] = tf * 1e3
+            # The fused path's per-token weight traffic is the win at low M.
+            row["fused_us_per_token"] = tf * 1e6 / m_tokens
+        tr = recon_gemm(m_tokens)
+        row["recon_gemm_ms"] = tr * 1e3
+        row["recon_gemm_us_per_token"] = tr * 1e6 / m_tokens
+        if "fused_ms" in row:
+            row["speedup_fused_over_recon"] = tr / (tf or 1e-12)
+            # Bit/loose correctness: both paths must agree within T-2.
+            x = make_x(m_tokens, k)
+            y_f = lin_call(x, gate).cpu()
+            ops.small_m_max = lambda K, cb: 0
+            try:
+                y_r = lin_call(x, gate).cpu()
+            finally:
+                ops.small_m_max = orig_small_m_max
+            row["path_max_abs"] = float((y_f.float() - y_r.float()).abs().max().item())
+        rows.append(row)
+        records.append({"case": "crossover", **row})
+
+    # Emit the calibration artifact.
+    out = Path("/home/yanchun/Projects/vllm.xpu/logs/moe-p1/crossover-calibration.json")
+    out.parent.mkdir(parents=True, exist_ok=True)
+    small_m_max = int(ops.small_m_max(3, 1))
+    payload = {
+        "task": "P1-08",
+        "device": torch.xpu.get_device_properties(0).name,
+        "has_xmx_dpas": False,
+        "note": (
+            "Arc 140V has no XMX/DPAS, so the large-M path is "
+            "exl3_reconstruct + oneDNN fp16 GEMM (not int8 XMX)."
+        ),
+        "small_m_max": small_m_max,
+        "fused_M_tested": list(FUSED_M),
+        "shape": {"k": k, "n": n},
+        "tolerance_T2_max_abs": T2_MAX_ABS,
+        "rows": rows,
+    }
+    out.write_text(json.dumps(payload, indent=2) + "\n")
+    print(f"wrote {out}")
+
+
+# ---------------------------------------------------------------------------
+# runner
+# ---------------------------------------------------------------------------
+
+def make_source(model_dir: Path, layer: int):
+    index = model_dir / "model.safetensors.index.json"
+    if index.is_file():
+        src = ShardSource(model_dir, layer)
+        if any(src.has(e) for e in (0, 255)):
+            return src, "checkpoint"
+    if layer == 0:
+        src = FixtureSource(layer)
+        if any(src.has(e) for e in (0, 255)):
+            return src, "fixtures"
+    raise SystemExit(f"no EXL3 expert tensors available ({model_dir}, layer {layer})")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--expert", type=int, default=0)
+    ap.add_argument("--log-out", default=str(ROOT / "logs/moe-p1/batch-sweep.log"))
+    ap.add_argument("--json-out", default=str(ROOT / "logs/moe-p1/batch-sweep.json"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not torch.xpu.is_available():
+        raise SystemExit("P1-08 needs the XPU")
+    assert bool(ops._get_esimd().exl3_supported(3, 1))
+
+    source, source_kind = make_source(Path(args.model_dir), args.layer)
+    records: list[dict] = []
+    failures: list[str] = []
+
+    cases: list[tuple[str, Callable[[], None]]] = [
+        ("batch sweep M=0..256 vs reference",
+         lambda: case_batch_sweep(source, args.expert, records)),
+        ("M=0 zero XPU kernel launches",
+         lambda: case_m0_zero_kernels(source, args.expert, records)),
+        ("fused vs reconstruct+GEMM crossover",
+         lambda: case_crossover(source, args.expert, records)),
+    ]
+
+    results = []
+    for label, fn in cases:
+        try:
+            fn()
+            results.append({"case": label, "pass": True})
+            print(f"OK   {label}")
+        except Exception as exc:  # noqa: BLE001
+            failures.append(f"{label}: {exc}")
+            results.append({"case": label, "pass": False, "error": str(exc)})
+            print(f"FAIL {label}: {exc}")
+            if args.verbose:
+                traceback.print_exc()
+
+    sweep = [r for r in records if r.get("case") != "crossover"]
+    summary = {
+        "task": "P1-08",
+        "pass": not failures and all(r.get("pass", True) for r in sweep),
+        "source": source_kind,
+        "model_dir": str(args.model_dir),
+        "layer": args.layer,
+        "expert": args.expert,
+        "device": torch.xpu.get_device_properties(0).name,
+        "small_m_max": int(ops.small_m_max(3, 1)),
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "cases": results,
+        "failures": failures,
+        "sweep": sweep,
+        "crossover": [r for r in records if r.get("case") == "crossover"],
+    }
+
+    log_path = Path(args.log_out)
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    lines = [
+        f"P1-08 batch sweep  source={source_kind} layer={args.layer} expert={args.expert}",
+        f"small_m_max={summary['small_m_max']} T2_max_abs={T2_MAX_ABS}",
+    ]
+    for r in sweep:
+        lines.append("  " + json.dumps(r, sort_keys=True))
+    lines.append(f"pass={summary['pass']} failures={failures}")
+    log_path.write_text("\n".join(lines) + "\n")
+
+    if args.json_out:
+        out = Path(args.json_out)
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(summary, indent=2) + "\n")
+
+    print(f"\npass={summary['pass']} failures={failures}")
+    print(f"wrote {log_path}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_reentrancy.py
--- a/tests/test_reentrancy.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_reentrancy.py	2026-10-24 10:02:29.924125284 +0200
@@ -0,0 +1,366 @@
+#!/usr/bin/env python3
+"""P1-09: reentrancy and reconstruction-workspace scratch audit.
+
+Audits the large-M reconstruction path at ``RECON_SLICE_N=1024`` and proves:
+
+1. **Small-M never materializes FP16 weights.** For M<=8 the XPU profiler shows
+   only ``HadInKernel`` + ``GemvKernel`` + ``HadOutKernel``; there is no
+   ``ReconstructKernel`` and no GEMM. Peak device memory is the bounded
+   split-K partial buffer, not a weight copy.
+2. **Large-M workspace is bounded, not persistent.** With
+   ``RECON_SLICE_N=1024`` the reconstruct slice is ``k*1024`` fp16 (<= 4 MiB at
+   k=2048); repeated calls do not grow the peak, and the slice is freed after
+   the call.
+3. **Reentrant across in-flight streams.** The old per-device static scratch
+   was replaced by a per-call stream-ordered allocation
+   (``at::empty({k, n1-n0})``), so concurrent calls on two XPU streams return
+   the same bits as serial execution.
+
+    .venv/bin/python tests/test_reentrancy.py
+
+Evidence: ``logs/moe-p1/reentrancy-audit.log``,
+``logs/moe-p1/reentrancy-memory.csv``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import traceback
+from collections.abc import Callable
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+from torch.profiler import ProfilerActivity, profile
+
+from exl3xpu import ops
+
+ROOT = Path(__file__).resolve().parents[1]
+FIXTURES = ROOT / "fixtures" / "exl3-moe" / "moe-fixtures.safetensors"
+DEFAULT_MODEL = "/home/yanchun/models/Qwen3.5-35B-A3B-exl3-3.09bpw"
+RECON_SLICE_N = 1024
+SMALL_M = 8
+LARGE_M = 64
+PEAK_SLACK_MIB = 1.0  # run-to-run allocator jitter
+
+
+class ShardSource:
+    def __init__(self, model_dir: Path, layer: int):
+        self.model_dir = model_dir
+        self.prefix = f"model.language_model.layers.{layer}.mlp.experts"
+        self.weight_map = json.loads(
+            (model_dir / "model.safetensors.index.json").read_text()
+        )["weight_map"]
+        self._handles: dict[str, object] = {}
+
+    def has(self, expert: int) -> bool:
+        key = f"{self.prefix}.{expert}.gate_proj.trellis"
+        shard = self.weight_map.get(key)
+        return shard is not None and (self.model_dir / shard).is_file()
+
+    def get(self, expert: int, proj: str, suffix: str) -> torch.Tensor:
+        key = f"{self.prefix}.{expert}.{proj}.{suffix}"
+        if key not in self.weight_map:
+            raise KeyError(key)
+        shard = self.weight_map[key]
+        if shard not in self._handles:
+            self._handles[shard] = safe_open(str(self.model_dir / shard), framework="pt")
+        return self._handles[shard].get_tensor(key)
+
+    def codebook(self, expert: int, proj: str) -> int:
+        for suffix, cb in (("mcg", 1), ("mul1", 2)):
+            if f"{self.prefix}.{expert}.{proj}.{suffix}" in self.weight_map:
+                return cb
+        return 0
+
+
+class FixtureSource:
+    def __init__(self, layer: int):
+        self.prefix = f"model.language_model.layers.{layer}.mlp.experts"
+        self._f = safe_open(str(FIXTURES), framework="pt")
+        self._keys = set(self._f.keys())
+
+    def has(self, expert: int) -> bool:
+        return f"{self.prefix}.{expert}.gate_proj.trellis" in self._keys
+
+    def get(self, expert: int, proj: str, suffix: str) -> torch.Tensor:
+        return self._f.get_tensor(f"{self.prefix}.{expert}.{proj}.{suffix}")
+
+    def codebook(self, expert: int, proj: str) -> int:
+        for suffix, cb in (("mcg", 1), ("mul1", 2)):
+            if f"{self.prefix}.{expert}.{proj}.{suffix}" in self._keys:
+                return cb
+        return 0
+
+
+def load_module(source, expert: int, proj: str) -> dict:
+    tr = source.get(expert, proj, "trellis")
+    n = tr.shape[1] * 16
+    return {
+        "trellis": tr.to("xpu"),
+        "suh": source.get(expert, proj, "suh").view(1, -1).to("xpu"),
+        "svh": source.get(expert, proj, "svh").to("xpu"),
+        "nb": torch.zeros(n // 128, dtype=torch.int32, device="xpu"),
+        "k": tr.shape[0] * 16,
+        "n": n,
+        "K": tr.shape[-1] // 16,
+        "cb": source.codebook(expert, proj),
+    }
+
+
+def lin(x: torch.Tensor, m: dict) -> torch.Tensor:
+    return ops.exl3_linear(
+        x, m["trellis"], m["suh"], m["svh"], m["nb"], [0, m["n"]], m["K"], m["cb"]
+    )
+
+
+def kernel_rows(fn: Callable[[], object]) -> list[dict]:
+    fn()
+    torch.xpu.synchronize()
+    with profile(activities=[ProfilerActivity.XPU]) as prof:
+        fn()
+        torch.xpu.synchronize()
+    return [
+        {"name": r.key, "count": int(r.count), "device_us": float(r.self_device_time_total)}
+        for r in prof.key_averages()
+        if getattr(r, "self_device_time_total", 0) > 0
+    ]
+
+
+def peak_delta_mib(fn: Callable[[], object], iters: int = 20) -> dict[str, float]:
+    fn()
+    torch.xpu.synchronize()
+    base = torch.xpu.memory_allocated()
+    torch.xpu.reset_peak_memory_stats()
+    torch.xpu.synchronize()
+    for _ in range(iters):
+        fn()
+    torch.xpu.synchronize()
+    peak = torch.xpu.max_memory_allocated()
+    after = torch.xpu.memory_allocated()
+    return {
+        "baseline_mib": base / 2**20,
+        "peak_mib": peak / 2**20,
+        "delta_mib": (peak - base) / 2**20,
+        "after_mib": after / 2**20,
+        "persistent_mib": (after - base) / 2**20,
+    }
+
+
+# ---------------------------------------------------------------------------
+# cases
+# ---------------------------------------------------------------------------
+
+def case_small_m_no_weight_materialization(mods, records, mem_rows) -> None:
+    assert ops.RECON_SLICE_N == RECON_SLICE_N
+    for proj in ("gate_proj", "down_proj"):
+        m = mods[proj]
+        x = (torch.randn(SMALL_M, m["k"]) * 0.05).half().to("xpu")
+        rows = kernel_rows(lambda: lin(x, m))
+        names = [r["name"] for r in rows]
+        has_recon = any("Reconstruct" in n for n in names)
+        has_gemm = any("gemm" in n.lower() for n in names)
+        has_gemv = any("Gemv" in n for n in names)
+        mem = peak_delta_mib(lambda: lin(x, m), iters=40)
+        rec = {
+            "case": "small_m_no_weight_materialization",
+            "proj": proj,
+            "M": SMALL_M,
+            "kernels": [{"name": r["name"].split("(")[0], "count": r["count"]} for r in rows],
+            "reconstruct_kernel": has_recon,
+            "gemm_kernel": has_gemm,
+            "gemv_kernel": has_gemv,
+            **mem,
+            "pass": (not has_recon) and (not has_gemm) and has_gemv and mem["persistent_mib"] <= 0.5,
+        }
+        records.append(rec)
+        mem_rows.append({**rec, "path": "fused_vector"})
+        assert rec["pass"], rec
+
+
+def case_large_m_workspace_bounded(mods, records, mem_rows) -> None:
+    for proj in ("gate_proj", "down_proj"):
+        m = mods[proj]
+        x = (torch.randn(LARGE_M, m["k"]) * 0.05).half().to("xpu")
+        rows = kernel_rows(lambda: lin(x, m))
+        recon = [r for r in rows if "Reconstruct" in r["name"]]
+        expected_slices = (m["n"] + RECON_SLICE_N - 1) // RECON_SLICE_N
+        recon_count = sum(r["count"] for r in recon)
+        mem1 = peak_delta_mib(lambda: lin(x, m), iters=1)
+        mem40 = peak_delta_mib(lambda: lin(x, m), iters=40)
+        # Slice bound: k*RECON_SLICE_N*2 bytes, plus xh/y; slack for overlapping
+        # slices and allocator padding.
+        slice_mib = m["k"] * min(RECON_SLICE_N, m["n"]) * 2 / 2**20
+        bound = slice_mib + (m["k"] * LARGE_M * 2 + LARGE_M * m["n"] * 2) / 2**20 + PEAK_SLACK_MIB
+        no_growth = mem40["delta_mib"] <= mem1["delta_mib"] + PEAK_SLACK_MIB
+        rec = {
+            "case": "large_m_workspace_bounded",
+            "proj": proj,
+            "M": LARGE_M,
+            "recon_slice_n": RECON_SLICE_N,
+            "reconstruct_launches": recon_count,
+            "expected_slices": expected_slices,
+            "slice_mib": slice_mib,
+            "bound_mib": bound,
+            "peak_1_call_delta_mib": mem1["delta_mib"],
+            "peak_40_calls_delta_mib": mem40["delta_mib"],
+            "persistent_mib": mem40["persistent_mib"],
+            "pass": (
+                len(recon) > 0
+                and recon_count == expected_slices
+                and mem40["delta_mib"] <= bound
+                and no_growth
+                and mem40["persistent_mib"] <= 0.5
+            ),
+        }
+        records.append(rec)
+        mem_rows.append({**rec, "path": "reconstruct_gemm"})
+        assert rec["pass"], rec
+
+
+def case_concurrent_streams_reentrant(mods, records) -> None:
+    """Two XPU streams must match serial execution (no shared scratch race)."""
+    gate = mods["gate_proj"]
+    g = torch.Generator().manual_seed(7)
+    x1 = (torch.randn(LARGE_M, gate["k"], generator=g) * 0.05).half().to("xpu")
+    x2 = (torch.randn(LARGE_M, gate["k"], generator=g) * 0.05).half().to("xpu")
+    xs = (torch.randn(SMALL_M, gate["k"], generator=g) * 0.05).half().to("xpu")
+
+    y1 = lin(x1, gate)
+    y2 = lin(x2, gate)
+    ys = lin(xs, gate)
+    torch.xpu.synchronize()
+
+    s1, s2 = torch.xpu.Stream(), torch.xpu.Stream()
+    mismatches = 0
+    trials = 100
+    for _ in range(trials):
+        with torch.xpu.stream(s1):
+            a = lin(x1, gate)
+        with torch.xpu.stream(s2):
+            b = lin(x2, gate)
+        with torch.xpu.stream(s1):
+            c = lin(xs, gate)
+        torch.xpu.synchronize()
+        if not (torch.equal(a, y1) and torch.equal(b, y2) and torch.equal(c, ys)):
+            mismatches += 1
+    rec = {
+        "case": "concurrent_streams_reentrant",
+        "trials": trials,
+        "streams": 2,
+        "mismatches": mismatches,
+        "pass": mismatches == 0,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+# ---------------------------------------------------------------------------
+# runner
+# ---------------------------------------------------------------------------
+
+def make_source(model_dir: Path, layer: int):
+    index = model_dir / "model.safetensors.index.json"
+    if index.is_file():
+        src = ShardSource(model_dir, layer)
+        if src.has(0):
+            return src, "checkpoint"
+    if layer == 0:
+        src = FixtureSource(layer)
+        if src.has(0):
+            return src, "fixtures"
+    raise SystemExit(f"no EXL3 expert tensors available ({model_dir}, layer {layer})")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--expert", type=int, default=0)
+    ap.add_argument("--log-out", default=str(ROOT / "logs/moe-p1/reentrancy-audit.log"))
+    ap.add_argument("--json-out", default=str(ROOT / "logs/moe-p1/reentrancy-audit.json"))
+    ap.add_argument("--csv-out", default=str(ROOT / "logs/moe-p1/reentrancy-memory.csv"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not torch.xpu.is_available():
+        raise SystemExit("P1-09 needs the XPU")
+    assert bool(ops._get_esimd().exl3_supported(3, 1))
+    ops.RECON_SLICE_N = RECON_SLICE_N
+
+    source, source_kind = make_source(Path(args.model_dir), args.layer)
+    mods = {p: load_module(source, args.expert, p) for p in ("gate_proj", "down_proj")}
+    records: list[dict] = []
+    mem_rows: list[dict] = []
+    failures: list[str] = []
+
+    cases: list[tuple[str, Callable[[], None]]] = [
+        ("small-M materializes no FP16 weights",
+         lambda: case_small_m_no_weight_materialization(mods, records, mem_rows)),
+        ("large-M workspace bounded at slice=1024",
+         lambda: case_large_m_workspace_bounded(mods, records, mem_rows)),
+        ("concurrent streams bit-identical to serial",
+         lambda: case_concurrent_streams_reentrant(mods, records)),
+    ]
+
+    results = []
+    for label, fn in cases:
+        try:
+            fn()
+            results.append({"case": label, "pass": True})
+            print(f"OK   {label}")
+        except Exception as exc:  # noqa: BLE001
+            failures.append(f"{label}: {exc}")
+            results.append({"case": label, "pass": False, "error": str(exc)})
+            print(f"FAIL {label}: {exc}")
+            if args.verbose:
+                traceback.print_exc()
+
+    summary = {
+        "task": "P1-09",
+        "pass": not failures,
+        "source": source_kind,
+        "model_dir": str(args.model_dir),
+        "device": torch.xpu.get_device_properties(0).name,
+        "recon_slice_n": RECON_SLICE_N,
+        "workspace": "per-call stream-ordered at::empty (no static scratch)",
+        "cases": results,
+        "failures": failures,
+        "records": records,
+    }
+
+    log_path = Path(args.log_out)
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    lines = [
+        f"P1-09 reentrancy audit  source={source_kind} RECON_SLICE_N={RECON_SLICE_N}",
+        "workspace: per-call stream-ordered at::empty (static per-device scratch removed)",
+    ]
+    for r in records:
+        lines.append("  " + json.dumps(r, sort_keys=True))
+    lines.append(f"pass={summary['pass']} failures={failures}")
+    log_path.write_text("\n".join(lines) + "\n")
+
+    if args.csv_out:
+        csv_path = Path(args.csv_out)
+        csv_path.parent.mkdir(parents=True, exist_ok=True)
+        fields = ["case", "path", "proj", "M", "baseline_mib", "peak_mib", "delta_mib",
+                  "after_mib", "persistent_mib", "slice_mib", "bound_mib", "pass"]
+        with csv_path.open("w", newline="") as f:
+            w = csv.DictWriter(f, fieldnames=fields, extrasaction="ignore")
+            w.writeheader()
+            for row in mem_rows:
+                w.writerow(row)
+
+    if args.json_out:
+        out = Path(args.json_out)
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(summary, indent=2) + "\n")
+
+    print(f"\npass={summary['pass']} failures={failures}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

