+#ifdef EXL3_DNNL
+#include <oneapi/dnnl/dnnl_graph.hpp>
+#include <oneapi/dnnl/dnnl_graph_sycl.hpp>
+#include <c10/xpu/XPUCachingAllocator.h>
+// Prefill attention through oneDNN Graph SDPA (fused, ~95 TF at head_dim 256 vs ~76 for FA2).
+// Head-major: q [Hq, Q, D], k/v [Hk, L, D] fp16 (GQA, Hq = G*Hk), out [Hq, Q, D]; causal = bottom-right aligned.
+// With lse defined ([Hq, Q] f32), the softmax log-sum-exp (natural log) is written there (softmax stats output).
+namespace sdpadnnl {
+using namespace dnnl::graph;
+using lt = logical_tensor;
+static void* alloc_fn(size_t n, size_t, const void*, const void*) { return c10::xpu::XPUCachingAllocator::raw_alloc(n); }
+static void free_fn(void* p, const void*, const void*, void*) { c10::xpu::XPUCachingAllocator::raw_delete(p); }
+struct Ctx { dnnl::engine eng; dnnl::stream strm; };
+static Ctx& ctx(sycl::queue& q) {
+    static std::map<void*, Ctx> m;
+    auto it = m.find((void*)&q);
+    if (it == m.end()) {
+        auto alloc = sycl_interop::make_allocator(alloc_fn, free_fn);
+        auto eng = sycl_interop::make_engine_with_allocator(q.get_device(), q.get_context(), alloc);
+        it = m.emplace((void*)&q, Ctx{eng, dnnl::sycl_interop::make_stream(eng, q)}).first;
+    }
+    return it->second;
+}
+struct Entry { compiled_partition cp; std::vector<lt> ins, outs; };
+static Entry& build(Ctx& c, int64_t Q, int64_t L, int64_t Hq, int64_t Hk, int64_t D, bool causal, bool with_lse) {
+    static std::map<std::tuple<int64_t, int64_t, int64_t, int64_t, int64_t, bool, bool>, Entry> cache;
+    auto key = std::make_tuple(Q, L, Hq, Hk, D, causal, with_lse);
+    auto it = cache.find(key);
+    if (it != cache.end()) return it->second;
+    const int64_t G = Hq / Hk;
+    using dt = lt::data_type;
+    size_t id = 0;
+    // 5D views of the natural vLLM layouts (no copies): [1, Hk, G, Q, D] / [1, Hk, 1, L, D]
+    lt query(id++, dt::f16, {1, Hk, G, Q, D}, {Hq * Q * D, G * Q * D, Q * D, D, 1});
+    lt keyt(id++, dt::f16, {1, Hk, 1, L, D}, {Hk * L * D, L * D, L * D, D, 1});
+    lt score(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+    op bmm1(id++, op::kind::MatMul, "bmm1"); bmm1.set_attr<bool>(op::attr::transpose_b, true);
+    bmm1.add_inputs({query, keyt}); bmm1.add_outputs({score});
+    lt scale(id++, dt::f16, lt::dims{1}, lt::layout_type::strided);   // divisor sqrt(D), as in oneDNN's gqa example
+    lt scaled(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+    op mul(id++, op::kind::Divide, "scale"); mul.add_inputs({score, scale}); mul.add_outputs({scaled});
+    std::vector<op> ops{bmm1, mul};
+    lt sm_in = scaled;
+    std::vector<lt> extra_ins;
+    if (causal) {
+        lt row(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op gr(id++, op::kind::GenIndex, "row"); gr.set_attr<int64_t>(op::attr::axis, -2); gr.add_inputs({scaled}); gr.add_outputs({row});
+        lt lk(id++, dt::s32, 0, lt::layout_type::strided, lt::property_type::host_scalar);
+        lt ra(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op add(id++, op::kind::Add, "row+L"); add.add_inputs({row, lk}); add.add_outputs({ra});
+        lt lq(id++, dt::s32, 0, lt::layout_type::strided, lt::property_type::host_scalar);
+        lt rs(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op sub(id++, op::kind::Subtract, "-Q"); sub.add_inputs({ra, lq}); sub.add_outputs({rs});
+        lt col(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op gc(id++, op::kind::GenIndex, "col"); gc.set_attr<int64_t>(op::attr::axis, -1); gc.add_inputs({scaled}); gc.add_outputs({col});
+        lt ge(id++, dt::boolean, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op gop(id++, op::kind::GreaterEqual, "ge"); gop.add_inputs({rs, col}); gop.add_outputs({ge});
+        lt ninf(id++, dt::f32, lt::dims{1}, lt::layout_type::strided);
+        lt masked(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op sel(id++, op::kind::Select, "sel"); sel.add_inputs({ge, scaled, ninf}); sel.add_outputs({masked});
+        ops.insert(ops.end(), {gr, add, sub, gc, gop, sel});
+        extra_ins = {lk, lq, ninf};
+        sm_in = masked;
+    }
+    lt probs(id++, dt::f16, {1, Hk, G, Q, L}, lt::layout_type::strided);
+    op sm(id++, op::kind::SoftMax, "softmax"); sm.set_attr<int64_t>(op::attr::axis, -1);
+    sm.set_attr<std::string>(op::attr::mode, "inf_as_zero");
+    sm.add_inputs({sm_in}); 
+    lt stats(id++, dt::f32, {1, Hk, G, Q, 1}, {Hq * Q, G * Q, Q, 1, 1});
+    if (with_lse) sm.add_outputs({probs, stats}); else sm.add_outputs({probs});
+    lt value(id++, dt::f16, {1, Hk, 1, L, D}, {Hk * L * D, L * D, L * D, D, 1});
+    lt output(id++, dt::f16, {1, Hk, G, Q, D}, {Hq * Q * D, G * Q * D, Q * D, D, 1});
+    op bmm2(id++, op::kind::MatMul, "bmm2"); bmm2.add_inputs({probs, value}); bmm2.add_outputs({output});
+    ops.insert(ops.end(), {sm, bmm2});
+    graph g(dnnl::engine::kind::gpu);
+    for (auto& o : ops) g.add_op(o);
+    g.finalize();
+    auto parts = g.get_partitions();
+    TORCH_CHECK(parts.size() == 1, "oneDNN SDPA: pattern not fused (", parts.size(), " partitions)");
+    std::vector<lt> ins{query, keyt, scale};
+    ins.insert(ins.end(), extra_ins.begin(), extra_ins.end());
+    ins.push_back(value);
+    std::vector<lt> outs{output};
+    if (with_lse) outs.push_back(stats);
+    auto cp = parts[0].compile(ins, outs, c.eng);
+    return cache.emplace(key, Entry{cp, ins, outs}).first->second;
+}
+}  // namespace sdpadnnl
+
+static void sdpa_impl(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
+                      int64_t len_k, int64_t len_q);
+void exl3_sdpa(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale) {
+    sdpa_impl(q, k, v, out, lse, causal, scale, k.size(1), q.size(1));
+}
+// Padded dims, real lengths for the bottom-right mask: keys >= len_k are masked for every row.
+void exl3_sdpa_len(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
+                   int64_t len_k, int64_t len_q) {
+    TORCH_CHECK(causal, "exl3_sdpa_len: causal only");
+    sdpa_impl(q, k, v, out, lse, causal, scale, len_k, len_q);
+}
+static void sdpa_impl(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
+                      int64_t len_k, int64_t len_q) {
+    TORCH_CHECK(q.scalar_type() == at::kHalf && k.scalar_type() == at::kHalf && v.scalar_type() == at::kHalf);
+    TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous() && out.is_contiguous());
+    int64_t Hq = q.size(0), Q = q.size(1), D = q.size(2), Hk = k.size(0), L = k.size(1);
+    auto& qq = queue_of(q);
+    auto& c = sdpadnnl::ctx(qq);
+    bool with_lse = lse.defined() && lse.numel() > 0;
+    auto& e = sdpadnnl::build(c, Q, L, Hq, Hk, D, causal, with_lse);
+    using dnnl::graph::tensor;
+    static std::vector<at::Tensor> sc(16), ni(16);
+    auto& st = sc.at(q.device().index());
+    if (!st.defined() || std::abs(st.item<float>() - (float)(1.0 / scale)) > 1e-3f) st = at::full({1}, (float)(1.0 / scale), q.options().dtype(at::kHalf));
+    auto& nt = ni.at(q.device().index());
+    if (!nt.defined()) nt = at::full({1}, -std::numeric_limits<float>::infinity(), q.options().dtype(at::kFloat));
+    int32_t lk = (int32_t)len_k, lq = (int32_t)len_q;
+    std::vector<tensor> ins{tensor(e.ins[0], c.eng, q.data_ptr()), tensor(e.ins[1], c.eng, k.data_ptr()),
+                            tensor(e.ins[2], c.eng, st.data_ptr())};
+    size_t vi = 3;
+    if (causal) {
+        ins.push_back(tensor::make_scalar_tensor(e.ins[3], &lk));
+        ins.push_back(tensor::make_scalar_tensor(e.ins[4], &lq));
+        ins.push_back(tensor(e.ins[5], c.eng, nt.data_ptr()));
+        vi = 6;
+    }
+    ins.push_back(tensor(e.ins[vi], c.eng, v.data_ptr()));
+    std::vector<tensor> outs{tensor(e.outs[0], c.eng, out.data_ptr())};
+    if (with_lse) outs.push_back(tensor(e.outs[1], c.eng, lse.data_ptr()));
+    dnnl::graph::sycl_interop::execute(e.cp, c.strm, ins, outs);
+}
+#endif
+
+// W8A8 prefill (opt-in): mul1 codebook values are bounded by 3.453125, one static int8 scale for every tensor
+static bool g_int8 = false;
+void exl3_set_int8(int64_t on) { g_int8 = on != 0; }
+constexpr float kQ8WMax = 3.453125f;
+
+template <int K>
+static void launch_reconstruct_q8(const at::Tensor& tr, at::Tensor& w, int n0, sycl::queue& q) {
+    int tk = tr.size(0), tiles_n = tr.size(1), n_out = w.size(1);
+    constexpr int NT = 8;
+    int n_strips = n_out / (16 * NT);
+    ReconstructKernel<K, 2, NT, int8_t> k{reinterpret_cast<const uint32_t*>(tr.data_ptr()),
+                                          reinterpret_cast<int8_t*>(w.data_ptr()), tiles_n, n0 / 16, n_out, n_strips, tk,
+                                          127.0f / kQ8WMax};
+    int n = n_strips * tk, local = 8;
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+}
+
+void exl3_reconstruct(at::Tensor trellis, at::Tensor w, int64_t n0, int64_t K, int64_t cb) {
+    TORCH_CHECK(w.scalar_type() == at::kHalf && w.is_contiguous() && w.size(1) % 128 == 0 && n0 % 128 == 0);
+    TORCH_CHECK(w.size(0) == trellis.size(0) * 16 && n0 + w.size(1) <= trellis.size(1) * 16);
+    auto& q = queue_of(w);
+    bool ok = true;
+    if (K == 4 && cb == 2) launch_reconstruct<4, 2>(trellis, w, n0, q);
+    else if (K == 6 && cb == 2) launch_reconstruct<6, 2>(trellis, w, n0, q);
+    // K=3 / MCG: the routed-expert format of Qwen3.5-35B-A3B (and a CUDA
+    // instantiation exllamav3 already ships as exl3_moe_inst_k3_cb1). Kept out
+    // of the ALL_CODEBOOKS block so the default build can always dequantize
+    // this checkpoint on the prefill (reconstruct + GEMM) path.
+    else if (K == 3 && cb == 1) launch_reconstruct<3, 1>(trellis, w, n0, q);
+#ifdef EXL3_ALL_CODEBOOKS
+    else if (K == 2 && cb == 2) launch_reconstruct<2, 2>(trellis, w, n0, q);
+    else if (K == 3 && cb == 2) launch_reconstruct<3, 2>(trellis, w, n0, q);
+    else if (K == 5 && cb == 2) launch_reconstruct<5, 2>(trellis, w, n0, q);
+    else if (K == 4 && cb == 1) launch_reconstruct<4, 1>(trellis, w, n0, q);
+    else if (K == 4 && cb == 0) launch_reconstruct<4, 0>(trellis, w, n0, q);
+#endif
+    else ok = false;
+    TORCH_CHECK(ok, "exl3_reconstruct: unsupported K/cb");
+}
+
+// Debug/verification: part = xh_blocked @ W_inner via a forced path (0 = vector, 1 = DPAS), summed over splits.
+at::Tensor exl3_gemm_raw(at::Tensor xh_blocked, at::Tensor trellis, at::Tensor shard_of_nb, int64_t N, int64_t K,
+                         int64_t cb, int64_t path) {
+    auto& q = queue_of(xh_blocked);
+    int S = xh_blocked.size(0), Kdim = xh_blocked.size(1) * 16, M = xh_blocked.size(2);
+    bool use_vec = path == 0;
+    if (!use_vec) {
+#if defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
+        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
+#elif defined(EXL3_DPAS_MB24)
+        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
+#else
+        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
+#endif
+        int Mp = (M + MBp - 1) / MBp * MBp;
+        if (Mp != M) xh_blocked = at::constant_pad_nd(xh_blocked, {0, 0, 0, Mp - M}).contiguous();
+    }
+    int MR = M <= 1 ? 1 : (M <= 2 ? 2 : (M <= 4 ? 4 : 8));
+#ifdef EXL3_DPAS_MB4
+    int MB = M <= 4 ? 4 : (M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64)));
+#elif defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
+#elif defined(EXL3_DPAS_MB24)
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
+#else
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
+#endif
+    int tk = Kdim / 16;
+    int P = 4, rps = (tk + P - 1) / P; P = (tk + rps - 1) / rps;
+    auto part = at::zeros({P, M, N}, xh_blocked.options().dtype(at::kFloat));
+    bool ok = false;
+    if (K == 4 && cb == 2) ok = use_vec ? dispatch_mr<4, 2>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q)
+                                        : dispatch_dpas<4, 2>(MB, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    if (K == 6 && cb == 2) ok = use_vec ? dispatch_mr<6, 2>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q)
+                                        : dispatch_dpas<6, 2>(MB, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    if (K == 3 && cb == 1) ok = use_vec && dispatch_mr<3, 1>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    TORCH_CHECK(ok);
+    (void)S;
+    return part.sum(0);
+}
+
+// Prefill helpers: row-major input Hadamard (GEMM operand) and fp16 output Hadamard.
+void exl3_had_in_rm(at::Tensor x, at::Tensor suh, at::Tensor xh) {
+    TORCH_CHECK(xh.scalar_type() == at::kHalf && xh.is_contiguous() && xh.size(1) == x.size(0));
+    auto& q = queue_of(x);
+    if (x.scalar_type() == at::kHalf) launch_had_in<fp16>(x, suh, xh, q, true);
+    else if (x.scalar_type() == at::kBFloat16) launch_had_in<sycl::ext::oneapi::bfloat16>(x, suh, xh, q, true);
+    else TORCH_CHECK(false, "x dtype");
+}
+
+void exl3_had_out_h(at::Tensor y, at::Tensor svh, at::Tensor out) {
+    TORCH_CHECK(y.scalar_type() == at::kHalf && y.is_contiguous() && y.sizes() == out.sizes());
+    auto& q = queue_of(y);
+    if (out.scalar_type() == at::kHalf) launch_had_out<fp16, fp16>(y, 1, svh, out, q);
+    else if (out.scalar_type() == at::kBFloat16) launch_had_out<sycl::ext::oneapi::bfloat16, fp16>(y, 1, svh, out, q);
+    else TORCH_CHECK(false, "out dtype");
+}
+
+// ---- flash-attention forward (prefill), fp16, head_dim 256, GQA; returns O and natural-log LSE
+void exl3_fa_fwd(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale) {
+    TORCH_CHECK(q.scalar_type() == at::kHalf && k.scalar_type() == at::kHalf && v.scalar_type() == at::kHalf);
+    TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous() && out.is_contiguous() && lse.is_contiguous());
+    TORCH_CHECK(q.size(2) == 256 && k.size(2) == 256, "head_dim 256 only");
+    int Lq = q.size(0), Hq = q.size(1), Lk = k.size(0), Hk = k.size(1);
+    TORCH_CHECK(Hq % Hk == 0);
+    int G = Hq / Hk;
+    auto& qq = queue_of(q);
+    exl3fa::FaKernel kern{reinterpret_cast<const sycl::half*>(q.data_ptr()), reinterpret_cast<const sycl::half*>(k.data_ptr()),
+                          reinterpret_cast<const sycl::half*>(v.data_ptr()), reinterpret_cast<sycl::half*>(out.data_ptr()),
+                          lse.data_ptr<float>(), Lq, Lk, Hq, Hk, G, (float)(scale * 1.4426950408889634), causal ? 1 : 0};
+    int qtiles = (Lq + exl3fa::QR - 1) / exl3fa::QR;
+    int n = qtiles * Hk * G;
+    sycl::ext::oneapi::experimental::properties props{sycl::ext::intel::experimental::grf_size<256>};
+    qq.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(n, G), props, kern); });
+}
+
+bool exl3_supported(int64_t K, int64_t cb);
+
+// ------------------------------------------------------------------------------------------------
+// The whole EXL3 linear as one C++ op (no Python on the per-call path).
+//   M <= small_m_max : fused decode-in-GEMM (vector / DPAS)
+//   otherwise        : row-major input Hadamard -> reconstruct W_inner slices -> oneDNN GEMM -> output Hadamard
+
+// NOTE: the large-M path used to reconstruct into a per-device static scratch
+// buffer. That buffer was not keyed by stream, so two in-flight calls on
+// different XPU streams would race on the same weight slice. Allocate the
+// slice per call instead: the caching allocator is stream-ordered, so
+// concurrent calls get distinct, safe buffers and the block is reused on the
+// same stream once the call returns. At RECON_SLICE_N=1024 this is a bounded
+// k*1024 fp16 slice (4 MiB at k=2048), never a persistent per-layer copy.
+
+at::Tensor exl3_linear(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
+                       std::vector<int64_t> group_bounds, int64_t K, int64_t cb, int64_t small_m_max,
+                       int64_t slice_n) {
+    auto shape = x.sizes().vec();
+    int64_t k = shape.back();
+    int64_t n = svh.size(0);
+    auto x2 = x.reshape({-1, k});
+    if (!x2.is_contiguous()) x2 = x2.contiguous();
+    int64_t M = x2.size(0);
+    shape.back() = n;
+    auto out = at::empty({M, n}, x.options());
+    if (M == 0) return out.view(shape);
+    if (M <= small_m_max && exl3_supported(K, cb)) {
+        exl3_gemm_small(x2, trellis, suh, svh, shard_of_nb, out, K, cb);
+        return out.view(shape);
+    }
+    int64_t S = suh.size(0);
+    if (g_int8 && cb == 2 && (K == 4 || K == 6) && M > 16) {
+        auto& q = queue_of(x2);
+#ifdef EXL3_DNNL
+        // GEMM rows padded to 256: bounds the number of oneDNN primitives (one per (Ms, K, N)) on real traffic
+        const int64_t Ms = (M + 255) / 256 * 256;
+#else
+        const int64_t Ms = M;
+#endif
+        auto xq = at::empty({S, Ms, k}, x.options().dtype(at::kChar));
+        auto sx = at::empty({S, Ms}, x.options().dtype(at::kFloat));
+        int n_in = S * M, local = 8;
+        auto run_in = [&](auto tag) {
+            using TIn = decltype(tag);
+            int kb_n = (int)(k / 128);
+            auto wg = [&](auto kern, int tpr) {
+                q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>((size_t)n_in * tpr, tpr), kern); });
+            };
+            if (kb_n <= 8 * 6) {
+                wg(HadInQ8WgKernel<TIn, 8, 6>{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
+                                              reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
+                                              (int)x2.stride(0), (int)Ms}, 8);
+                return;
+            }
+            if (kb_n <= 16 * 9) {
+                wg(HadInQ8WgKernel<TIn, 16, 9>{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
+                                               reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
+                                               (int)x2.stride(0), (int)Ms}, 16);
+                return;
+            }
+            HadInQ8Kernel<TIn> kin{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
+                                   reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
+                                   (int)x2.stride(0), (int)Ms};
+            q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n_in, local), local), kin); });
+        };
+        if (x2.scalar_type() == at::kHalf) run_in(fp16{});
+        else if (x2.scalar_type() == at::kBFloat16) run_in(sycl::ext::oneapi::bfloat16{});
+        else TORCH_CHECK(false, "x dtype");
+        const float sw = kQ8WMax / 127.0f;
+#ifdef EXL3_DNNL
+        {
+            static std::vector<at::Tensor> swd(16);
+            auto& swt = swd.at(x.device().index());
+            if (!swt.defined()) swt = at::full({1}, sw, x.options().dtype(at::kFloat));
+            auto y = at::empty({Ms, n}, x.options().dtype(at::kHalf));
+            for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
+                int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1], ng = g1 - g0;
+                auto w = at::empty({k, ng}, x.options().dtype(at::kChar));
+                if (K == 4) launch_reconstruct_q8<4>(trellis, w, g0, q); else launch_reconstruct_q8<6>(trellis, w, g0, q);
+                q8dnnl::gemm(q, x, reinterpret_cast<const int8_t*>(xq.data_ptr()) + g * Ms * k,
+                             reinterpret_cast<const int8_t*>(w.data_ptr()), swt.data_ptr<float>(),
+                             sx.data_ptr<float>() + g * Ms, reinterpret_cast<fp16*>(y.data_ptr()) + g0, Ms, k, ng, n);
+            }
+            exl3_had_out_h(y.narrow(0, 0, M), svh, out);
+            return out.view(shape);
+        }
+#endif
+        for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
+            int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1], ng = g1 - g0;
+            auto w = at::empty({k, ng}, x.options().dtype(at::kChar));
+            if (K == 4) launch_reconstruct_q8<4>(trellis, w, g0, q); else launch_reconstruct_q8<6>(trellis, w, g0, q);
+            auto y = at::_int_mm(xq[g], w);                                   // [M, ng] int32
+            int n_out = M * (ng / 128);
+            auto run_out = [&](auto tag) {
+                using TOut = decltype(tag);
+                HadOutQ8Kernel<TOut> ko{y.data_ptr<int32_t>(), sx.data_ptr<float>() + g * M,
+                                        reinterpret_cast<const fp16*>(svh.data_ptr()) + g0,
+                                        reinterpret_cast<TOut*>(out.data_ptr()) + g0, (int)M, (int)ng, (int)n, sw};
+                q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n_out, local), local), ko); });
+            };
+            if (out.scalar_type() == at::kHalf) run_out(fp16{});
+            else run_out(sycl::ext::oneapi::bfloat16{});
+        }
+        return out.view(shape);
+    }
+    auto xh = at::empty({S, M, k}, x.options().dtype(at::kHalf));
+    exl3_had_in_rm(x2, suh, xh);
+    auto y = at::empty({M, n}, x.options().dtype(at::kHalf));
+    for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
+        int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1];
+        for (int64_t n0 = g0; n0 < g1; n0 += slice_n) {
+            int64_t n1 = std::min(n0 + slice_n, g1);
+            auto w = at::empty({k, n1 - n0}, x.options().dtype(at::kHalf));
+            exl3_reconstruct(trellis, w, n0, K, cb);
+            auto yslice = y.narrow(1, n0, n1 - n0);
+            at::matmul_out(yslice, xh[g], w);
+        }
+    }
+    exl3_had_out_h(y, svh, out);
+    return out.view(shape);
+}
+
+at::Tensor exl3_linear_meta(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
+                            std::vector<int64_t> group_bounds, int64_t K, int64_t cb, int64_t small_m_max,
+                            int64_t slice_n) {
+    auto shape = x.sizes().vec();
+    shape.back() = svh.size(0);
+    return at::empty(shape, x.options());
+}
+
+bool exl3_supported(int64_t K, int64_t cb) {
+    if (cb == 2 && (K == 4 || K == 6)) return true;
+    if (cb == 1 && K == 3) return true;   // Qwen3.5-35B-A3B routed experts
+#ifdef EXL3_ALL_CODEBOOKS
+    if (cb == 2 && (K == 2 || K == 3 || K == 5)) return true;
+    if ((cb == 0 || cb == 1) && (K == 4 || K == 6)) return true;
+#endif
+    return false;
+}
+
+// Largest M the fused small-M path can serve for a given (K, cb).
+// Formats with a DPAS instantiation are bounded only by the caller's
+// SMALL_M_MAX (Python caps at 128); the vector-only K=3/mcg routed-expert
+// path is bounded by the vector kernel's row limit (g_vec_max_m == 8 on this
+// no-XMX part, where dispatch_dpas<K,1> is deliberately not instantiated).
+int64_t exl3_small_m_max(int64_t K, int64_t cb) {
+    if (!exl3_supported(K, cb)) return 0;
+    if (K == 3 && cb == 1) return g_vec_max_m;
+    return 1 << 20;
+}
+
+void exl3_set_target_threads(int64_t n) { g_target_threads = (int)n; }
+void exl3_set_target_threads_mb64(int64_t n) { g_target_threads_mb64 = (int)n; }
+void exl3_set_target_threads_mb16(int64_t n) { g_target_threads_mb16 = (int)n; }
+void exl3_set_vec_max_m(int64_t n) { g_vec_max_m = (int)n; }
