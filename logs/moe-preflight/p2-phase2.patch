+"""EXL3 routed-expert quantization method (Phase 1: dispatch + expert loading).
+
+Why this file exists
+--------------------
+``Exl3Config.get_quant_method`` used to return ``None`` for
+``RoutedExperts``.  vLLM turns ``None`` into
+``UnquantizedFusedMoEMethod`` (``routed_experts.py:219-220``), which allocates
+256 x (2 x 2048x512 + 512x2048) fp16 experts per layer -- ~64 GiB for this
+model -- before failing on the missing ``.weight`` tensors.  The project rule
+is fail-closed, so this module registers a real ``FusedMoEMethodBase`` that
+either serves the layer or raises.
+
+Stage boundary
+--------------
+P1-01 wired dispatch.  P1-02 registers one compressed allocation per tensor
+kind per layer (trellis / suh / svh / codebook scalars, no fp16 expert weights)
+and loads them through a purpose-built expert loader.  P1-03 packs int64
+per-expert descriptors, and P1-04 adds ``verify_expert_integrity`` (stride/
+offset tiling, no metadata aliasing, tile-not-dense trellis).  P1-05 streams
+shards; Phase 2 adds the eager routed-expert ``apply`` (per-expert grouping,
+weighted scatter-accumulate) and an optional intermediate-capture hook.  There
+is no unquantized or Triton-backed expert path to fall back to.
+
+Why a custom ``load_weights``
+-----------------------------
+``RoutedExperts.load_weights`` decides "fused checkpoint tensor" with
+``loaded_weight.dim() == 3`` and then chunks along dim 1 for ``w1``/``w3``.
+EXL3 trellis tensors are *also* 3-D (``[k/16, n/16, 16K]`` per expert), so the
+stock loader would split one expert's trellis into 64 fake experts.  The
+method therefore binds a per-layer loader that parses
+``<expert>.<proj>.<trellis|suh|svh|codebook>`` explicitly and copies each
+tensor into ``[expert, slot]``.  See ``docs/moe_api_audit.md`` §3.2.
+"""
+
+from __future__ import annotations
+
+import math
+import types
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, Iterable, Iterator
+
+import torch
+from torch.nn import Parameter
+
+from vllm.model_executor.layers.fused_moe.config import (
+    FusedMoEConfig,
+    FusedMoEQuantConfig,
+)
+from vllm.model_executor.layers.fused_moe.fused_moe_method_base import (
+    FusedMoEMethodBase,
+)
+
+if TYPE_CHECKING:  # pragma: no cover - typing only
+    from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
+
+    from .vllm_plugin import Exl3Config
+
+#: EXL3 codebook name -> numeric id used by the kernels and the checkpoint.
+CODEBOOK_IDS = {"3inst": 0, "mcg": 1, "mul1": 2}
+
+#: Projections every routed expert must provide in this checkpoint schema.
+CHECKPOINT_PROJECTIONS = ("gate_proj", "up_proj", "down_proj")
+
+
+class Exl3MoEUnsupported(NotImplementedError):
+    """The MoE layer cannot be served by EXL3.
+
+    Deliberately an exception rather than a ``None`` return: ``None`` makes
+    vLLM silently construct ``UnquantizedFusedMoEMethod`` (~64 GiB of fp16
+    experts).  Callers may catch this to produce a richer error, but must not
+    downgrade it to an unquantized path.
+    """
+
+
+#: Level Zero per-allocation ceiling from the P1-02 plan. Every registered
+#: expert tensor must stay below this *and* the per-layer total must too.
+MAX_ALLOCATION_BYTES = 4 * 1024**3
+
+#: MoE shard id -> fused slot index inside w13 (w2 has a single slot).
+_SHARD_SLOT = {"w1": 0, "w3": 1, "w2": 0}
+
+#: Canonical projection order used by the packed expert descriptors.
+_PROJ_ORDER = ("gate_proj", "up_proj", "down_proj")
+_PROJ_SHARDS = ("w1", "w3", "w2")
+
+#: Fields of one descriptor row (int64), indexed by
+#: ``layer.exl3_moe_descriptors[expert, projection, field]``.
+#: ``*_tensor`` indexes ``layer.exl3_moe_tensor_names``; ``*_offset`` is an
+#: element offset into that allocation. -1 marks an absent tensor (3inst has no
+#: codebook scalar).
+DESCRIPTOR_FIELDS = (
+    "trellis_tensor",
+    "trellis_offset",
+    "suh_tensor",
+    "suh_offset",
+    "svh_tensor",
+    "svh_offset",
+    "codebook_tensor",
+    "codebook_offset",
+    "k",
+    "n",
+    "K",
+    "cb",
+    "family",
+    "slot",
+)
+
+#: family id used in descriptor rows.
+_FAMILY_ID = {"w13": 0, "w2": 1}
+
+
+def _s32(value: int) -> int:
+    """Interpret an unsigned 32-bit constant as a signed int32 (checkpoint form)."""
+    return value - (1 << 32) if value >= (1 << 31) else value
+
+
+#: Value stored in the per-expert codebook scalar. The tensor's *presence*
+#: selects the codebook; its value is the codebook multiplier, so a mismatch
+#: means the checkpoint is not what the config claims.
+CODEBOOK_MULTIPLIERS = {
+    "mcg": _s32(0xCBAC1FED),
+    "mul1": _s32(0x83DCD12D),
+}
+
+
+def _trellis_shape(k: int, n: int, K: int) -> tuple[int, int, int]:
+    return (k // 16, n // 16, 16 * K)
+
+
+@dataclass(frozen=True)
+class ExpertTensorSpec:
+    """One per-layer stacked expert tensor (all experts share the layout)."""
+
+    name: str  # parameter name on RoutedExperts, e.g. "w13_trellis"
+    tensor: str  # checkpoint suffix: trellis | suh | svh | <codebook>
+    slots: int  # 2 for w13 (gate+up), 1 for w2 (down)
+    shape: tuple[int, ...]
+    dtype: torch.dtype
+
+    @property
+    def nbytes(self) -> int:
+        return math.prod(self.shape) * self.dtype.itemsize
+
+
+class Exl3ExpertStore:
+    """Shape/dtype/budget plan for one layer's compressed expert tensors.
+
+    All experts of a layer live in one allocation per tensor kind (eight
+    allocations per layer for the mcg checkpoint). At 3.09 bpw that is
+    ~192 MiB for ``w13_trellis`` and ~96 MiB for ``w2_trellis``, so each
+    allocation and the per-layer total stay far below
+    ``MAX_ALLOCATION_BYTES``.
+    """
+
+    def __init__(
+        self,
+        num_experts: int,
+        hidden_size: int,
+        intermediate_size: int,
+        K: int,
+        codebook: str,
+    ):
+        if num_experts <= 0:
+            raise Exl3MoEUnsupported(f"exl3: MoE: bad expert count {num_experts}")
+        for label, dim in (
+            ("hidden_size", hidden_size),
+            ("intermediate_size", intermediate_size),
+        ):
+            if dim % 128 != 0:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE: {label}={dim} must be a multiple of 128 "
+                    "(trellis tile / grouped-GEMV requirement)"
+                )
+        self.num_experts = num_experts
+        self.hidden_size = hidden_size
+        self.intermediate_size = intermediate_size
+        self.K = K
+        self.codebook = codebook
+
+        def spec(name, tensor, slots, shape, dtype):
+            return ExpertTensorSpec(name, tensor, slots, tuple(shape), dtype)
+
+        specs = [
+            spec(
+                "w13_trellis", "trellis", 2,
+                (num_experts, 2, *_trellis_shape(hidden_size, intermediate_size, K)),
+                torch.int16,
+            ),
+            spec("w13_suh", "suh", 2, (num_experts, 2, hidden_size), torch.float16),
+            spec("w13_svh", "svh", 2, (num_experts, 2, intermediate_size), torch.float16),
+            spec(
+                "w2_trellis", "trellis", 1,
+                (num_experts, 1, *_trellis_shape(intermediate_size, hidden_size, K)),
+                torch.int16,
+            ),
+            spec("w2_suh", "suh", 1, (num_experts, 1, intermediate_size), torch.float16),
+            spec("w2_svh", "svh", 1, (num_experts, 1, hidden_size), torch.float16),
+        ]
+        if codebook != "3inst":
+            specs += [
+                spec(f"w13_{codebook}", codebook, 2, (num_experts, 2), torch.int32),
+                spec(f"w2_{codebook}", codebook, 1, (num_experts, 1), torch.int32),
+            ]
+        self.specs: tuple[ExpertTensorSpec, ...] = tuple(specs)
+        self.total_bytes = sum(s.nbytes for s in self.specs)
+
+        oversized = [s for s in self.specs if s.nbytes >= MAX_ALLOCATION_BYTES]
+        if oversized:
+            raise Exl3MoEUnsupported(
+                "exl3: MoE: single-allocation limit exceeded: "
+                + ", ".join(
+                    f"{s.name}={s.nbytes / 2**30:.2f} GiB" for s in oversized
+                )
+                + f" (limit {MAX_ALLOCATION_BYTES / 2**30:.0f} GiB)"
+            )
+        if self.total_bytes >= MAX_ALLOCATION_BYTES:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE: per-layer expert buffers total "
+                f"{self.total_bytes / 2**30:.2f} GiB >= "
+                f"{MAX_ALLOCATION_BYTES / 2**30:.0f} GiB"
+            )
+
+    def get(self, name: str) -> ExpertTensorSpec:
+        for s in self.specs:
+            if s.name == name:
+                return s
+        raise KeyError(name)
+
+    def meta(self) -> dict[str, Any]:
+        return {
+            "num_experts": self.num_experts,
+            "hidden_size": self.hidden_size,
+            "intermediate_size": self.intermediate_size,
+            "K": self.K,
+            "total_bytes": self.total_bytes,
+            "max_allocation_bytes": MAX_ALLOCATION_BYTES,
+            "tensors": {
+                s.name: {
+                    "shape": list(s.shape),
+                    "dtype": str(s.dtype).removeprefix("torch."),
+                    "bytes": s.nbytes,
+                }
+                for s in self.specs
+            },
+        }
+
+
+class Exl3MoEMethod(FusedMoEMethodBase):
+    """Quantization method for EXL3-compressed routed experts.
+
+    Holds the per-layer format contract (K, codebook, expert count), registers
+    the compressed expert tensors in :meth:`create_weights`, loads them
+    through the per-layer expert loader described in the module docstring, and
+    verifies packed-arena integrity in :meth:`verify_expert_integrity`.
+    Execution (:meth:`apply`) is P1-05+.
+    """
+
+    def __init__(self, config: "Exl3Config", layer: "RoutedExperts", prefix: str):
+        moe: FusedMoEConfig = layer.moe_config
+        super().__init__(moe)
+
+        self.config = config
+        self.prefix = prefix
+        # Checkpoint storage keys are normalized ("layers.0..."), while vLLM
+        # passes the model-qualified prefix ("model.language_model.layers.0...").
+        from .vllm_plugin import _norm_key
+        self.key_prefix = _norm_key(prefix)
+        self.num_local_experts = int(moe.num_local_experts)
+        self.hidden_size = int(moe.hidden_dim)
+        self.intermediate_size_per_partition = int(moe.intermediate_size_per_partition)
+
+        self._validate_parallel(moe)
+
+        codebook = config.codebook
+        if codebook not in CODEBOOK_IDS:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {prefix}: unknown codebook {codebook!r}; "
+                f"expected one of {sorted(CODEBOOK_IDS)}"
+            )
+        self.cb = CODEBOOK_IDS[codebook]
+
+        # Raises if the checkpoint has no / inconsistent / unsupported expert
+        # format for this layer.  Resolved before the constructor returns so a
+        # bad checkpoint fails at model construction, not at first token.
+        self.K = self._resolve_expert_K(layer)
+        self._check_kernel_support()
+
+        # Reused read-only ``shard_of_nb`` buffers (one per (device, n)).
+        self._nb_cache: dict[tuple[torch.device, int], torch.Tensor] = {}
+        # Optional P2-08 diagnostic capture (None = disabled, zero overhead).
+        self._debug_capture: dict[str, Any] | None = None
+
+    # -- validation ---------------------------------------------------------
+
+    @staticmethod
+    def _validate_parallel(moe: FusedMoEConfig) -> None:
+        pc = moe.moe_parallel_config
+        if pc.tp_size > 1 or pc.ep_size > 1 or getattr(pc, "use_ep", False):
+            raise Exl3MoEUnsupported(
+                "exl3: MoE tensor/expert parallelism is not supported "
+                f"(tp_size={pc.tp_size}, ep_size={pc.ep_size}, use_ep={pc.use_ep}); "
+                "run with TP=1 and EP off"
+            )
+
+    def _checkpoint_projection_names(self, layer: "RoutedExperts") -> tuple[str, str, str]:
+        """Checkpoint-side projection names for gate/up/down.
+
+        ``RoutedExperts`` stores the ckpt names it was built with; defaults
+        match the EXL3 Qwen3.5 checkpoint.  Ordering is gate, up, down.
+        """
+        return (
+            getattr(layer, "ckpt_gate_proj_name", CHECKPOINT_PROJECTIONS[0]),
+            getattr(layer, "ckpt_up_proj_name", CHECKPOINT_PROJECTIONS[1]),
+            getattr(layer, "ckpt_down_proj_name", CHECKPOINT_PROJECTIONS[2]),
+        )
+
+    def _resolve_expert_K(self, layer: "RoutedExperts") -> int:
+        """Validate the checkpoint schema and return the routed trellis K."""
+        storage = self.config.storage
+        if not storage:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: checkpoint storage map is empty, so the "
+                "routed-expert format cannot be resolved (was "
+                "Exl3Config.maybe_update_config called?)"
+            )
+
+        prefix = self.key_prefix + "."
+        entries = {k: v for k, v in storage.items() if k.startswith(prefix)}
+        if not entries:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: no EXL3 expert tensors found for this "
+                "layer (partially-quantized or unquantized MoE is not supported)"
+            )
+
+        proj_names = set(self._checkpoint_projection_names(layer))
+        by_expert: dict[int, dict[str, int]] = {}
+        for key, bits in entries.items():
+            rest = key[len(prefix):].split(".")
+            if len(rest) != 2 or not rest[0].isdigit():
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected expert tensor name {key!r}"
+                )
+            expert_id, proj = int(rest[0]), rest[1]
+            if proj not in proj_names:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected projection {proj!r} in {key!r}"
+                )
+            info = self.config.member_trellis.get(key)
+            K = int(info[1]) if info is not None else int(bits)
+            by_expert.setdefault(expert_id, {})[proj] = K
+
+        # Completeness: an expert missing a projection would load partially and
+        # silently produce garbage, so reject the layer up front.
+        for expert_id, projs in sorted(by_expert.items()):
+            missing = proj_names - projs.keys()
+            if missing:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: expert {expert_id} is missing "
+                    f"quantized projections {sorted(missing)}"
+                )
+
+        if len(by_expert) != self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: checkpoint has {len(by_expert)} experts, "
+                f"layer expects {self.num_local_experts}"
+            )
+
+        Ks = {K for projs in by_expert.values() for K in projs.values()}
+        if len(Ks) != 1:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: mixed trellis K across experts: {sorted(Ks)}"
+            )
+        return Ks.pop()
+
+    def _check_kernel_support(self) -> None:
+        """Fail closed unless the built extension has a kernel for (K, cb)."""
+        from . import ops
+
+        try:
+            esimd = ops._get_esimd()
+        except RuntimeError as exc:  # library missing / ABI mismatch
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: ESIMD op library is not loadable and "
+                "routed experts have no Triton fallback"
+            ) from exc
+        if not esimd or not hasattr(esimd, "exl3_supported"):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: ESIMD op library is not available "
+                "(EXL3_BACKEND=triton disables it) and routed experts have no "
+                "fallback"
+            )
+        if not bool(esimd.exl3_supported(self.K, self.cb)):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: no ESIMD kernel for K={self.K}, "
+                f"codebook={self.config.codebook!r} (cb={self.cb}); rebuild with "
+                "-DEXL3_ALL_CODEBOOKS or use a supported bitrate"
+            )
+
+    # -- FusedMoEMethodBase contract ---------------------------------------
+
+    def create_weights(
+        self,
+        layer: "RoutedExperts",
+        num_experts: int,
+        hidden_size: int,
+        intermediate_size_per_partition: int,
+        params_dtype: torch.dtype,
+        **extra_weight_attrs: Any,
+    ) -> None:
+        """Register the compressed expert tensors for one layer.
+
+        Exactly one allocation per tensor kind:
+        ``w13_trellis[E,2,k/16,n/16,16K]``, ``w13_suh[E,2,k]``,
+        ``w13_svh[E,2,n]``, ``w2_trellis[E,1,n/16,k/16,16K]``, ``w2_suh``,
+        ``w2_svh`` and (for ``mcg``/``mul1``) one scalar ``int32`` per expert
+        and slot.  There is no fp16 copy of any expert matrix.
+        """
+        if int(num_experts) != self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: create_weights got num_experts="
+                f"{num_experts}, method was built for {self.num_local_experts}"
+            )
+        if int(hidden_size) != self.hidden_size:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: create_weights got hidden_size="
+                f"{hidden_size}, method was built for {self.hidden_size}"
+            )
+        if int(intermediate_size_per_partition) != self.intermediate_size_per_partition:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: create_weights got "
+                f"intermediate_size_per_partition={intermediate_size_per_partition}, "
+                f"method was built for {self.intermediate_size_per_partition}"
+            )
+
+        store = Exl3ExpertStore(
+            num_experts=self.num_local_experts,
+            hidden_size=self.hidden_size,
+            intermediate_size=self.intermediate_size_per_partition,
+            K=self.K,
+            codebook=self.config.codebook,
+        )
+        self.store = store
+        self._loaded: set[tuple[str, int, int]] = set()
+        self._load_attempted = False
+
+        for spec in store.specs:
+            # Allocate on the active device: vLLM constructs the model inside
+            # `with torch.device(target_device)` (base_loader.py:67).
+            param = Parameter(
+                torch.empty(spec.shape, dtype=spec.dtype), requires_grad=False
+            )
+            param.weight_loader = self._make_weight_loader(spec)
+            param.exl3_spec = spec
+            layer.register_parameter(spec.name, param)
+
+        tensor_names = [s.name for s in store.specs]
+        layer.exl3_moe_tensor_names = tensor_names
+        descriptors = self._build_descriptors(layer, tensor_names)
+        # Non-persistent: moves with the module, absent from state_dict, and
+        # skipped by the dummy loader.
+        layer.register_buffer(
+            "exl3_moe_descriptors", descriptors, persistent=False
+        )
+
+        meta = store.meta()
+        meta.update(
+            {
+                "prefix": self.key_prefix,
+                "codebook": self.config.codebook,
+                "codebook_id": self.cb,
+                "allocations": len(store.specs),
+                "tensor_order": tensor_names,
+                "descriptor_fields": list(DESCRIPTOR_FIELDS),
+                "descriptor_shape": list(descriptors.shape),
+            }
+        )
+        layer.exl3_moe_meta = meta
+
+        # Replace the generic expert loader (see module docstring): trellis
+        # tensors are 3-D and would otherwise be treated as fused w13 tensors.
+        layer.load_weights = types.MethodType(self._layer_load_weights, layer)
+
+    # -- expert weight loading ---------------------------------------------
+
+    def _make_weight_loader(self, spec: ExpertTensorSpec):
+        """Per-parameter loader used by the per-layer expert loader.
+
+        Signature mirrors vLLM's ``weight_loader`` protocol; ``return_success``
+        is honoured so the stock mapping bookkeeping keeps working.
+        """
+
+        def weight_loader(
+            param: Parameter,
+            loaded_weight: torch.Tensor,
+            weight_name: str = "",
+            shard_id: str | None = None,
+            expert_id: int | None = None,
+            return_success: bool = False,
+            **_: Any,
+        ):
+            self._copy_expert_tensor(
+                spec, param, loaded_weight, shard_id, expert_id, weight_name
+            )
+            return True if return_success else None
+
+        return weight_loader
+
+    def _copy_expert_tensor(
+        self,
+        spec: ExpertTensorSpec,
+        param: Parameter,
+        loaded_weight: torch.Tensor,
+        shard_id: str | None,
+        expert_id: int | None,
+        weight_name: str,
+    ) -> None:
+        if shard_id not in _SHARD_SLOT:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {spec.name} got unknown shard_id "
+                f"{shard_id!r} (expected one of {sorted(_SHARD_SLOT)}) for "
+                f"{weight_name!r}"
+            )
+        if spec.name.startswith("w13_") != (shard_id in ("w1", "w3")):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: shard_id {shard_id!r} does not match "
+                f"parameter {spec.name!r}"
+            )
+        if expert_id is None or not isinstance(expert_id, int):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {spec.name} requires an integer "
+                f"expert_id, got {expert_id!r} for {weight_name!r}"
+            )
+        if not 0 <= expert_id < self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: expert_id {expert_id} out of range "
+                f"for {spec.name} ({self.num_local_experts} experts)"
+            )
+
+        slot = _SHARD_SLOT[shard_id]
+        expected = spec.shape[2:]
+        if tuple(loaded_weight.shape) != expected:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {weight_name!r} has shape "
+                f"{tuple(loaded_weight.shape)}, expected {expected} for "
+                f"{spec.name} (expert {expert_id}, slot {slot})"
+            )
+        if loaded_weight.dtype != spec.dtype:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {weight_name!r} has dtype "
+                f"{loaded_weight.dtype}, expected {spec.dtype} for {spec.name}"
+            )
+
+        param.data[expert_id, slot].copy_(loaded_weight)
+        self._loaded.add((spec.name, expert_id, slot))
+
+    def _layer_load_weights(
+        self, layer: "RoutedExperts", weights: Iterable[tuple[str, torch.Tensor]]
+    ) -> Iterator[str]:
+        """Layer-bound replacement for ``RoutedExperts.load_weights``.
+
+        Consumes names relative to the ``RoutedExperts`` module (the form
+        ``AutoWeightsLoader`` passes after stripping the child prefix), e.g.
+        ``"0.gate_proj.trellis"``.
+
+        Kept as a plain function returning a generator so the "a real load was
+        attempted" flag is set eagerly, even if a caller forgets to iterate.
+        """
+        self._load_attempted = True
+        return self._iter_layer_weights(layer, weights)
+
+    def _iter_layer_weights(
+        self, layer: "RoutedExperts", weights: Iterable[tuple[str, torch.Tensor]]
+    ) -> Iterator[str]:
+        gate, up, down = self._checkpoint_projection_names(layer)
+        shard_of_proj = {gate: "w1", up: "w3", down: "w2"}
+
+        for name, loaded_weight in weights:
+            parts = name.split(".")
+            if len(parts) != 3 or not parts[0].isdigit():
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected routed-expert tensor "
+                    f"{name!r} (expected '<expert>.<projection>.<suffix>')"
+                )
+            expert_id, proj, suffix = int(parts[0]), parts[1], parts[2]
+            shard_id = shard_of_proj.get(proj)
+            if shard_id is None:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected projection {proj!r} in "
+                    f"{name!r} (expected one of {sorted(shard_of_proj)})"
+                )
+            family = "w13" if shard_id in ("w1", "w3") else "w2"
+            param_name = f"{family}_{suffix}"
+            try:
+                spec = self.store.get(param_name)
+            except KeyError:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected tensor suffix {suffix!r} "
+                    f"in {name!r}; expected "
+                    f"{sorted(s.tensor for s in self.store.specs)}"
+                ) from None
+            param = getattr(layer, param_name)
+            param.weight_loader(
+                param=param,
+                loaded_weight=loaded_weight,
+                weight_name=name,
+                shard_id=shard_id,
+                expert_id=expert_id,
+                return_success=True,
+            )
+            yield param_name
+
+    # -- packed expert descriptors (P1-03) ----------------------------------
+
+    def _build_descriptors(
+        self, layer: "RoutedExperts", tensor_names: list[str]
+    ) -> torch.Tensor:
+        """Build ``[E, 3, len(DESCRIPTOR_FIELDS)]`` int64 descriptor rows.
+
+        Rows are derived from the allocation plan only (no data), so every
+        expert/projection resolves to an explicit ``(allocation, element
+        offset, slot, k, n, K, cb)`` rather than an implicit concatenation.
+        """
+        index = {name: i for i, name in enumerate(tensor_names)}
+        rows: list[list[int]] = []
+        for expert_id in range(self.num_local_experts):
+            for proj_index, shard_id in enumerate(_PROJ_SHARDS):
+                family = "w13" if shard_id in ("w1", "w3") else "w2"
+                slot = _SHARD_SLOT[shard_id]
+                trellis = self.store.get(f"{family}_trellis")
+                suh = self.store.get(f"{family}_suh")
+                svh = self.store.get(f"{family}_svh")
+                if self.config.codebook == "3inst":
+                    cb_spec = None
+                else:
+                    cb_spec = self.store.get(f"{family}_{self.config.codebook}")
+
+                def offset(spec: ExpertTensorSpec) -> int:
+                    per_expert = math.prod(spec.shape[2:])
+                    return (expert_id * spec.slots + slot) * per_expert
+
+                # NOTE: projection identity follows _PROJ_ORDER/_PROJ_SHARDS;
+                # custom checkpoint projection names are resolved by the loader
+                # (``_checkpoint_projection_names``), not here.
+                if shard_id in ("w1", "w3"):
+                    k, n = self.hidden_size, self.intermediate_size_per_partition
+                else:
+                    k, n = self.intermediate_size_per_partition, self.hidden_size
+
+                rows.append(
+                    [
+                        index[trellis.name],
+                        offset(trellis),
+                        index[suh.name],
+                        offset(suh),
+                        index[svh.name],
+                        offset(svh),
+                        index[cb_spec.name] if cb_spec is not None else -1,
+                        offset(cb_spec) if cb_spec is not None else -1,
+                        k,
+                        n,
+                        self.K,
+                        self.cb,
+                        _FAMILY_ID[family],
+                        slot,
+                    ]
+                )
+        device = getattr(layer, tensor_names[0]).device
+        return torch.tensor(rows, dtype=torch.int64, device=device).reshape(
+            self.num_local_experts, len(_PROJ_ORDER), len(DESCRIPTOR_FIELDS)
+        )
+
+    def descriptor(self, layer: "RoutedExperts", expert_id: int, projection: str) -> dict[str, int]:
+        """One descriptor row as a named dict (raises on bad ids)."""
+        if projection not in _PROJ_ORDER:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: unknown projection {projection!r}"
+            )
+        if not 0 <= expert_id < self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: expert_id {expert_id} out of range"
+            )
+        row = layer.exl3_moe_descriptors[
+            expert_id, _PROJ_ORDER.index(projection)
+        ].tolist()
+        return dict(zip(DESCRIPTOR_FIELDS, row))
+
+    def expert_views(
+        self, layer: "RoutedExperts", expert_id: int
+    ) -> dict[str, dict[str, torch.Tensor | None]]:
+        """Actual parameter views for one expert, one dict per projection.
+
+        This is the P1-03/P1-04 bridge: consumers never index the stacked
+        allocation by hand, and tests can compare views against the descriptor
+        offsets.
+        """
+        out: dict[str, dict[str, torch.Tensor | None]] = {}
+        for projection in _PROJ_ORDER:
+            row = self.descriptor(layer, expert_id, projection)
+            shard_id = _PROJ_SHARDS[_PROJ_ORDER.index(projection)]
+            family = "w13" if shard_id in ("w1", "w3") else "w2"
+            slot = row["slot"]
+            codebook = None
+            if row["codebook_tensor"] >= 0:
+                cb_name = layer.exl3_moe_tensor_names[row["codebook_tensor"]]
+                codebook = getattr(layer, cb_name)[expert_id, slot]
+            out[projection] = {
+                "trellis": getattr(layer, f"{family}_trellis")[expert_id, slot],
+                "suh": getattr(layer, f"{family}_suh")[expert_id, slot],
+                "svh": getattr(layer, f"{family}_svh")[expert_id, slot],
+                "codebook": codebook,
+                "k": row["k"],
+                "n": row["n"],
+                "K": row["K"],
+                "cb": row["cb"],
+            }
+        return out
+
+    # -- integrity verification (P1-04) -------------------------------------
+
+    def verify_expert_integrity(self, layer: "RoutedExperts") -> dict[str, Any]:
+        """Assert the packed arenas keep per-expert metadata intact (P1-04).
+
+        Structural only (no checkpoint values), so it is safe for
+        ``--load-format dummy`` too:
+
+        * each tensor kind owns a distinct allocation;
+        * every ``(expert, slot)`` slice owns distinct storage, so ``suh``/``svh``
+          scales and Hadamard vectors are never shared between experts or
+          between gate and up;
+        * registered parameter shapes match the plan (tiled, not dense);
+        * the ``[E, slots, ...]`` arena is exactly tiled by the descriptor
+          offsets ``(expert*slots + slot) * per_expert``, so codes are always
+          addressed through explicit stride/offset tracking;
+        * trellis uses the tile layout ``[k/16, n/16, 16K]`` (``w2`` is
+          ``[n/16, k/16, 16K]``), never a dense ``[k, n]`` row store;
+        * ``suh``/``svh`` lengths equal ``k``/``n`` and codebook entries carry
+          the expected multiplier.
+
+        Returns a small summary (used in evidence) and raises
+        :class:`Exl3MoEUnsupported` on any violation.
+        """
+        names = list(getattr(layer, "exl3_moe_tensor_names", []))
+        if names != [s.name for s in self.store.specs]:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: expert tensor order {names} does not "
+                "match the allocation plan"
+            )
+
+        descriptors = getattr(layer, "exl3_moe_descriptors", None)
+        expected_shape = (
+            self.num_local_experts,
+            len(_PROJ_ORDER),
+            len(DESCRIPTOR_FIELDS),
+        )
+        if descriptors is None or tuple(descriptors.shape) != expected_shape:
+            got = None if descriptors is None else tuple(descriptors.shape)
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: descriptor shape {got} != {expected_shape}"
+            )
+        if descriptors.dtype != torch.int64:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: descriptor dtype {descriptors.dtype} "
+                "!= int64"
+            )
+
+        # 1. A distinct allocation per tensor kind.
+        owners: dict[int, str] = {}
+        for name in names:
+            ptr = getattr(layer, name).data_ptr()
+            if ptr in owners:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: {name} aliases the allocation of "
+                    f"{owners[ptr]}"
+                )
+            owners[ptr] = name
+
+        # 2. Registered shapes match the plan; every (expert, slot) slice owns
+        #    distinct storage and the arena is exactly tiled.
+        for spec in self.store.specs:
+            param = getattr(layer, spec.name)
+            if tuple(param.shape) != spec.shape:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: {spec.name} has shape "
+                    f"{tuple(param.shape)}, expected tiled {spec.shape} (codes must "
+                    "not be stored as concatenated dense rows)"
+                )
+            per = math.prod(spec.shape[2:])
+            if param.numel() != self.num_local_experts * spec.slots * per:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: {spec.name} arena size "
+                    f"{param.numel()} is not E*slots*per={self.num_local_experts}"
+                    f"*{spec.slots}*{per}"
+                )
+            seen: set[int] = set()
+            for expert_id in range(self.num_local_experts):
+                for slot in range(spec.slots):
+                    ptr = param[expert_id, slot].data_ptr()
+                    if ptr in seen:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: {spec.name}[expert="
+                            f"{expert_id},slot={slot}] aliases another expert slice"
+                        )
+                    seen.add(ptr)
+
+        expected_multiplier = CODEBOOK_MULTIPLIERS.get(self.config.codebook)
+        for expert_id in range(self.num_local_experts):
+            for proj_index, shard_id in enumerate(_PROJ_SHARDS):
+                family = "w13" if shard_id in ("w1", "w3") else "w2"
+                slot = _SHARD_SLOT[shard_id]
+                row = dict(
+                    zip(DESCRIPTOR_FIELDS, descriptors[expert_id, proj_index].tolist())
+                )
+                if row["family"] != _FAMILY_ID[family] or row["slot"] != slot:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] family/slot {row['family']}/{row['slot']} "
+                        f"!= {_FAMILY_ID[family]}/{slot}"
+                    )
+                if row["K"] != self.K or row["cb"] != self.cb:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] K/cb {row['K']}/{row['cb']} != "
+                        f"{self.K}/{self.cb}"
+                    )
+
+                if family == "w13":
+                    k = self.hidden_size
+                    n = self.intermediate_size_per_partition
+                else:
+                    k = self.intermediate_size_per_partition
+                    n = self.hidden_size
+                # Trellis tiles are always [k/16, n/16, 16K] (see
+                # docs/checkpoint_schema.md); w2 is *not* transposed.
+                tile = _trellis_shape(k, n, self.K)
+                if row["k"] != k or row["n"] != n:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] k/n {row['k']}/{row['n']} != {k}/{n}"
+                    )
+
+                for kind, spec_name in (
+                    ("trellis", f"{family}_trellis"),
+                    ("suh", f"{family}_suh"),
+                    ("svh", f"{family}_svh"),
+                ):
+                    spec = self.store.get(spec_name)
+                    per = math.prod(spec.shape[2:])
+                    if row[f"{kind}_tensor"] != names.index(spec.name):
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] {kind}_tensor {row[f'{kind}_tensor']} "
+                            f"!= {names.index(spec.name)} ({spec.name})"
+                        )
+                    expected_offset = (expert_id * spec.slots + slot) * per
+                    if row[f"{kind}_offset"] != expected_offset:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] {kind}_offset {row[f'{kind}_offset']} "
+                            f"!= strided offset {expected_offset}"
+                        )
+                    if expected_offset + per > getattr(layer, spec.name).numel():
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] {kind} slice runs past {spec.name}"
+                        )
+
+                trellis_spec = self.store.get(f"{family}_trellis")
+                if tuple(trellis_spec.shape[2:]) != tile:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {family}_trellis tile "
+                        f"{tuple(trellis_spec.shape[2:])} != {tile}"
+                    )
+                if self.store.get(f"{family}_suh").shape[2] != k:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {family}_suh length "
+                        f"{self.store.get(f'{family}_suh').shape[2]} != k={k}"
+                    )
+                if self.store.get(f"{family}_svh").shape[2] != n:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {family}_svh length "
+                        f"{self.store.get(f'{family}_svh').shape[2]} != n={n}"
+                    )
+
+                if self.config.codebook == "3inst":
+                    if row["codebook_tensor"] != -1 or row["codebook_offset"] != -1:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] has a codebook entry for 3inst"
+                        )
+                    continue
+                cb_spec = self.store.get(f"{family}_{self.config.codebook}")
+                if row["codebook_tensor"] != names.index(cb_spec.name):
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] codebook_tensor "
+                        f"{row['codebook_tensor']} != {names.index(cb_spec.name)}"
+                    )
+                if row["codebook_offset"] != expert_id * cb_spec.slots + slot:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] codebook_offset {row['codebook_offset']} "
+                        f"!= {expert_id * cb_spec.slots + slot}"
+                    )
+                if expected_multiplier is not None and self._load_attempted:
+                    value = int(
+                        getattr(layer, cb_spec.name).data[expert_id, slot].item()
+                    )
+                    if value != expected_multiplier:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: {cb_spec.name}[expert="
+                            f"{expert_id},slot={slot}] multiplier 0x"
+                            f"{value & 0xFFFFFFFF:08X} != 0x"
+                            f"{expected_multiplier & 0xFFFFFFFF:08X} "
+                            f"({self.config.codebook!r})"
+                        )
+
+        return {
+            "experts": self.num_local_experts,
+            "projections": len(_PROJ_ORDER),
+            "allocations": len(names),
+            "tiled_slices": sum(
+                self.num_local_experts * s.slots for s in self.store.specs
+            ),
+            "trellis_tile_w13": list(
+                self.store.get("w13_trellis").shape[2:]
+            ),
+            "trellis_tile_w2": list(self.store.get("w2_trellis").shape[2:]),
+        }
+
+    def process_weights_after_loading(self, layer: "RoutedExperts") -> None:
+        """Settle the layer after loading.
+
+        * fail closed if the checkpoint did not cover every expert/slot (a
+          missing slice would otherwise be uninitialised memory that silently
+          produces garbage tokens) — only when a real load was attempted, since
+          ``--load-format dummy`` never calls ``load_weights``;
+        * then run the P1-04 structural integrity check, which is safe on any
+          path because it reads the plan and descriptor buffer only.
+        """
+        if self._load_attempted:
+            self._require_complete(layer)
+            self._verify_codebook_multipliers(layer)
+        self.verify_expert_integrity(layer)
+
+    def _require_complete(self, layer: "RoutedExperts") -> None:
+        missing: list[tuple[str, int, int]] = []
+        for spec in self.store.specs:
+            for expert_id in range(self.num_local_experts):
+                for slot in range(spec.slots):
+                    if (spec.name, expert_id, slot) not in self._loaded:
+                        missing.append((spec.name, expert_id, slot))
+        if missing:
+            preview = ", ".join(
+                f"{name}[expert={e},slot={s}]" for name, e, s in missing[:6]
+            )
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {len(missing)} expert tensor slice(s) "
+                f"were not loaded ({preview}"
+                f"{', ...' if len(missing) > 6 else ''}); refusing to run with "
+                "uninitialised compressed experts"
+            )
+
+    def _verify_codebook_multipliers(self, layer: "RoutedExperts") -> None:
+        # The per-expert codebook scalar stores the codebook *multiplier*
+        # (presence selects the codebook; see ``exl3xpu/ref.py``). A config/
+        # checkpoint mismatch (e.g. `mcg` weights with a `mul1` config) would
+        # decode nonsense, so verify the value here.
+        expected_multiplier = CODEBOOK_MULTIPLIERS.get(self.config.codebook)
+        if expected_multiplier is not None:
+            for spec in self.store.specs:
+                if spec.tensor != self.config.codebook:
+                    continue
+                param = getattr(layer, spec.name)
+                if not bool(torch.all(param.data == expected_multiplier)):
+                    bad = int((param.data != expected_multiplier).sum().item())
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {spec.name} contains {bad} "
+                        f"codebook multiplier(s) != 0x"
+                        f"{expected_multiplier & 0xFFFFFFFF:08X} "
+                        f"({self.config.codebook!r} expected); checkpoint and "
+                        "config disagree"
+                    )
+
+    def get_fused_moe_quant_config(
+        self, layer: "RoutedExperts"
+    ) -> FusedMoEQuantConfig | None:
+        # EXL3 never calls a vLLM fused-MoE kernel, so there is no
+        # FusedMoEQuantConfig to publish.
+        return None
+
+    # -- eager execution (P2-01) -------------------------------------------
+
+    def _shard_of_nb(self, device: torch.device, n: int) -> torch.Tensor:
+        """Cached all-zero ``shard_of_nb`` for a single-group linear."""
+        key = (device, n)
+        cached = self._nb_cache.get(key)
+        if cached is None:
+            cached = torch.zeros(n // 128, dtype=torch.int32, device=device)
+            self._nb_cache[key] = cached
+        return cached
+
+    def _expert_linear(
+        self, views: dict[str, Any], projection: str, x: torch.Tensor
+    ) -> torch.Tensor:
+        """One projection of one expert through the verified fused op."""
+        from . import ops
+
+        m = views[projection]
+        # Production dense contract is suh:[num_groups, k]; the expert view is
+        # the per-expert [k] row (P1-08).
+        suh = m["suh"].unsqueeze(0)
+        return ops.exl3_linear(
+            x,
+            m["trellis"],
+            suh,
+            m["svh"],
+            self._shard_of_nb(x.device, m["n"]),
+            [0, m["n"]],
+            m["K"],
+            m["cb"],
+        )
+
+    def _expert_mlp(
+        self, layer: "RoutedExperts", expert_id: int, x: torch.Tensor
+    ) -> torch.Tensor:
+        """Routed-expert MLP: ``down(silu(gate(x)) * up(x))``."""
+        import torch.nn.functional as F
+
+        views = self.expert_views(layer, expert_id)
+        gate = self._expert_linear(views, "gate_proj", x)
+        up = self._expert_linear(views, "up_proj", x)
+        act = F.silu(gate) * up
+        down = self._expert_linear(views, "down_proj", act)
+        if self._debug_capture is not None:
+            self._debug_capture.setdefault("experts", {})[int(expert_id)] = {
+                "gate": gate.detach(),
+                "up": up.detach(),
+                "act": act.detach(),
+                "down": down.detach(),
+            }
+        return down
+
+    # -- P2-08 diagnostic hook ---------------------------------------------
+    def enable_debug_capture(self) -> None:
+        """Capture per-expert/router intermediates on the next ``apply``."""
+        self._debug_capture = {}
+
+    def disable_debug_capture(self) -> dict[str, Any] | None:
+        captured, self._debug_capture = self._debug_capture, None
+        return captured
+
+    def apply(
+        self,
+        layer: "RoutedExperts",
+        x: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        shared_experts: Any,
+        shared_experts_input: torch.Tensor | None,
+    ) -> torch.Tensor:
+        """Eager routed-expert execution (P2-01).
+
+        vLLM's modular runner already selected the experts and normalized the
+        weights, and computes/adds the shared expert itself (``_maybe_combine``
+        does ``shared_output + fused_output``). This method therefore computes
+        **only** the routed contribution:
+
+            Y[i] = sum_{j in top-k(i)} w[i, j] * MLP_{ids[i, j]}(X[i])
+
+        with the routing weight applied to the *down-projection output* (after
+        SiLU/up and the output Hadamard), never to the input activations
+        (P2-03). Experts receiving no tokens are skipped. A Python loop over
+        active experts is the Gate 2 baseline; grouped kernels come in Phase 4.
+        """
+        hidden = x.shape[-1]
+        x2 = x.reshape(-1, hidden)
+        if not x2.is_contiguous():
+            x2 = x2.contiguous()
+
+        if x2.shape[0] == 0:
+            return torch.zeros_like(x2)
+
+        if topk_ids.shape != topk_weights.shape or topk_ids.dim() != 2:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: topk_ids/topk_weights must be "
+                f"[tokens, k]; got {tuple(topk_ids.shape)} / "
+                f"{tuple(topk_weights.shape)}"
+            )
+        if topk_ids.shape[0] != x2.shape[0]:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {topk_ids.shape[0]} routing rows for "
+                f"{x2.shape[0]} tokens"
+            )
+        if topk_ids.numel() and (
+            int(topk_ids.min()) < 0 or int(topk_ids.max()) >= self.num_local_experts
+        ):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: routing index outside "
+                f"[0, {self.num_local_experts})"
+            )
+
+        # Routed output accumulated in fp32, cast back at the end.
+        out = torch.zeros(x2.shape, dtype=torch.float32, device=x2.device)
+        weights = topk_weights.to(torch.float32)
+
+        for expert_id in torch.unique(topk_ids).tolist():
+            token_idx, slot_idx = (topk_ids == expert_id).nonzero(as_tuple=True)
+            if token_idx.numel() == 0:
+                continue
+            rows = x2.index_select(0, token_idx)
+            y = self._expert_mlp(layer, int(expert_id), rows)
+            w = weights[token_idx, slot_idx].unsqueeze(-1)
+            out.index_add_(0, token_idx, y.to(torch.float32) * w)
+
+        if self._debug_capture is not None:
+            self._debug_capture.update({
+                "x": x2.detach(),
+                "topk_ids": topk_ids.detach(),
+                "topk_weights": topk_weights.detach(),
+                "routed_fp32": out.detach(),
+            })
+
+        return out.to(x2.dtype).reshape(x.shape)
+
+
+# ---------------------------------------------------------------------------
+# P1-05: shard-by-shard streaming loader
+# ---------------------------------------------------------------------------
+
+#: Checkpoint suffixes that make up one routed-expert module.
+EXPERT_SUFFIXES = frozenset({"trellis", "suh", "svh", "mcg", "mul1"})
+
+
+def split_expert_key(key: str) -> tuple[str | None, str | None]:
+    """Split a checkpoint key into ``(layer_key, relative_name)``.
+
+    ``layer_key`` is the normalized ``RoutedExperts`` key
+    (``"layers.3.mlp.experts"``); ``relative_name`` is the name the per-layer
+    loader consumes (``"0.gate_proj.trellis"``). Non-routed keys (shared
+    expert, attention, vision, embedding, ``lm_head``, MTP) return
+    ``(None, None)``.
+    """
+    stem, dot, suffix = key.rpartition(".")
+    if not dot or suffix not in EXPERT_SUFFIXES:
+        return None, None
+    from .vllm_plugin import _norm_key
+
+    parts = _norm_key(stem).split(".")
+    if (
+        len(parts) < 6
+        or parts[0] != "layers"
+        or parts[2] != "mlp"
+        or parts[3] != "experts"
+        or not parts[4].isdigit()
+    ):
+        return None, None
+    layer_key = ".".join(parts[:4])
+    relative = ".".join(parts[4:]) + "." + suffix
+    return layer_key, relative
+
+
+def stream_expert_shards(
+    shard_paths: Iterable[Any],
+    layers: dict[str, "RoutedExperts"],
+    *,
+    on_shard: Any = None,
+) -> dict[str, Any]:
+    """Pack routed experts into ``layers`` one ``safetensors`` shard at a time.
+
+    P1-05. On the unified-memory Arc part, holding several 8 GiB shards'
+    mmaps open while also touching the packed arenas duplicates host and
+    device traffic. This loader:
+
+    1. opens exactly one shard at a time with ``safe_open``;
+    2. reads each routed-expert tensor lazily via ``get_tensor`` inside a
+       generator, so at most one checkpoint tensor's payload is resident in
+       addition to the arenas;
+    3. feeds it to the layer's per-layer loader (``RoutedExperts.load_weights``
+       override), then tears the shard down with ``gc.collect()`` and
+       ``torch.xpu.empty_cache()`` before moving on.
+
+    ``layers`` maps a *normalized* layer key (``"layers.3.mlp.experts"``) to
+    its ``RoutedExperts`` whose ``create_weights`` has already run.
+
+    Returns a report with:
+
+    * ``consumed`` — routed-expert checkpoint keys handed to a layer loader;
+    * ``out_of_scope`` — routed keys for layers not in ``layers`` (deliberately
+      skipped, e.g. a ``--layers`` subset; the caller decides whether it
+      expects these);
+    * ``shards`` — per-shard timing/telemetry (fed to ``on_shard`` as it goes);
+    * ``expert_tensors`` — total routed tensors streamed.
+    """
+    import gc
+    import time
+
+    from safetensors import safe_open
+
+    consumed: list[str] = []
+    out_of_scope: list[str] = []
+    shards: list[dict[str, Any]] = []
+
+    for shard_index, path in enumerate(shard_paths):
+        t0 = time.perf_counter()
+        n_read = 0
+        by_layer: dict[str, list[tuple[str, str]]] = {}
+        with safe_open(str(path), framework="pt") as f:
+            for key in f.keys():
+                layer_key, relative = split_expert_key(key)
+                if layer_key is None:
+                    continue
+                by_layer.setdefault(layer_key, []).append((key, relative))
+
+            for layer_key, entries in by_layer.items():
+                layer = layers.get(layer_key)
+                if layer is None:
+                    out_of_scope.extend(key for key, _ in entries)
+                    continue
+
+                def _tensors(entries=entries, f=f):
+                    for key, relative in entries:
+                        yield relative, f.get_tensor(key)
+
+                list(layer.load_weights(_tensors()))
+                consumed.extend(key for key, _ in entries)
+                n_read += len(entries)
+            # Drop the key map before closing so mmap pages can be reclaimed.
+            del by_layer
+
+        gc.collect()
+        try:
+            torch.xpu.empty_cache()
+        except Exception:  # pragma: no cover - CPU-only / no XPU
+            pass
+
+        row = {
+            "shard_index": shard_index,
+            "shard": str(path),
+            "expert_tensors": n_read,
+            "seconds": time.perf_counter() - t0,
+        }
+        if on_shard is not None:
+            on_shard(row)
+        shards.append(row)
+
+    return {
+        "consumed": consumed,
+        "out_of_scope": out_of_scope,
+        "shards": shards,
+        "expert_tensors": sum(r["expert_tensors"] for r in shards),
+    }

## file: tests/test_dispatch.py
--- a/tests/test_dispatch.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_dispatch.py	2026-10-24 11:03:59.250142663 +0200
@@ -0,0 +1,343 @@
+#!/usr/bin/env python3
+"""P1-01 dispatch tests: dense -> Exl3LinearMethod, experts -> Exl3MoEMethod.
+
+Runs as a plain script (this venv has no pytest):
+
+    .venv/bin/python tests/test_dispatch.py [--verbose]
+
+Every case exercises ``Exl3Config.get_quant_method`` through vLLM's real
+``resolve_quant_method`` helper, so the tests cover the exact seam that used to
+produce ``UnquantizedFusedMoEMethod`` (``routed_experts.py:219-220``).
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+import traceback
+import types
+from collections.abc import Callable
+
+import torch
+from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
+from vllm.model_executor.layers.fused_moe.unquantized_fused_moe_method import (
+    UnquantizedFusedMoEMethod,
+)
+from vllm.model_executor.layers.linear import LinearBase, UnquantizedLinearMethod
+from vllm.model_executor.layers.quantization.base_config import resolve_quant_method
+
+from exl3xpu.moe import Exl3MoEMethod, Exl3MoEUnsupported
+from exl3xpu.vllm_plugin import Exl3Config, Exl3LinearMethod
+
+DENSE_PREFIX = "layers.0.mlp.gate_proj"
+UNQUANTIZED_DENSE_PREFIX = "layers.0.mlp.shared_expert_gate"
+EXPERTS_PREFIX = "layers.0.mlp.experts"
+
+
+# ---------------------------------------------------------------------------
+# fixtures
+# ---------------------------------------------------------------------------
+
+def expert_storage(
+    num_experts: int = 256,
+    K: int = 3,
+    skip: tuple[str, ...] = (),
+    overrides: dict[str, int] | None = None,
+) -> dict[str, int]:
+    """Checkpoint storage map for one routed-expert layer."""
+    st: dict[str, int] = {}
+    for e in range(num_experts):
+        for proj in ("gate_proj", "up_proj", "down_proj"):
+            st[f"{EXPERTS_PREFIX}.{e}.{proj}"] = K
+    for key in skip:
+        st.pop(key, None)
+    st.update(overrides or {})
+    return st
+
+
+def dense_storage() -> dict[str, int]:
+    # K=4 is what the real checkpoint uses for attention/shared-expert linears.
+    return {
+        DENSE_PREFIX: 4,
+        "layers.0.mlp.up_proj": 4,
+        "layers.0.mlp.down_proj": 4,
+        "lm_head": 6,
+    }
+
+
+def make_config(storage: dict[str, int], codebook: str = "mcg") -> Exl3Config:
+    cfg = Exl3Config(bits=3, head_bits=6, codebook=codebook, storage=dict(storage))
+    # One real-shaped entry exercises the member_trellis (n, K) path.
+    if f"{EXPERTS_PREFIX}.0.gate_proj" in cfg.storage:
+        cfg.member_trellis = {
+            f"{EXPERTS_PREFIX}.0.gate_proj": (512, cfg.storage[f"{EXPERTS_PREFIX}.0.gate_proj"]),
+        }
+    return cfg
+
+
+def dense_layer() -> LinearBase:
+    return object.__new__(LinearBase)
+
+
+def experts_layer(
+    num_experts: int = 256, tp_size: int = 1, ep_size: int = 1
+) -> RoutedExperts:
+    layer = object.__new__(RoutedExperts)
+    layer.layer_name = EXPERTS_PREFIX
+    layer.moe_config = types.SimpleNamespace(
+        num_experts=num_experts,
+        num_local_experts=num_experts,
+        hidden_dim=2048,
+        intermediate_size_per_partition=512,
+        activation="silu",
+        moe_parallel_config=types.SimpleNamespace(
+            tp_size=tp_size, ep_size=ep_size, use_ep=ep_size > 1
+        ),
+    )
+    layer.ckpt_gate_proj_name = "gate_proj"
+    layer.ckpt_up_proj_name = "up_proj"
+    layer.ckpt_down_proj_name = "down_proj"
+    return layer
+
+
+# ---------------------------------------------------------------------------
+# cases
+# ---------------------------------------------------------------------------
+
+def case_dense_resolves_to_exl3() -> None:
+    cfg = make_config(dense_storage())
+    method = resolve_quant_method(cfg, dense_layer(), DENSE_PREFIX)
+    assert isinstance(method, Exl3LinearMethod), type(method)
+    assert method.K == 4 and method.cb == 1, (method.K, method.cb)
+
+
+def case_unquantized_dense_still_unquantized() -> None:
+    cfg = make_config(dense_storage())
+    method = resolve_quant_method(cfg, dense_layer(), UNQUANTIZED_DENSE_PREFIX)
+    assert isinstance(method, UnquantizedLinearMethod), type(method)
+
+
+def case_experts_resolve_to_exl3_moe() -> None:
+    cfg = make_config(expert_storage())
+    layer = experts_layer()
+    method = resolve_quant_method(cfg, layer, EXPERTS_PREFIX)
+    assert isinstance(method, Exl3MoEMethod), type(method)
+    assert not isinstance(method, UnquantizedFusedMoEMethod)
+    assert method.K == 3 and method.cb == 1, (method.K, method.cb)
+    assert method.num_local_experts == 256
+    # Modular-kernel contract: no vLLM fused-MoE kernel, runner computes top-k
+    # and calls apply().
+    assert method.moe_kernel is None
+    assert method.supports_internal_mk is False
+    assert method.is_monolithic is False
+    assert method.get_fused_moe_quant_config(layer) is None
+
+
+def case_experts_direct_get_quant_method() -> None:
+    cfg = make_config(expert_storage())
+    method = cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX)
+    assert isinstance(method, Exl3MoEMethod), type(method)
+
+
+def case_model_qualified_prefix_normalizes() -> None:
+    # vLLM passes the full model prefix; checkpoint keys are normalized.
+    cfg = make_config(expert_storage())
+    qualified = "model.language_model.layers.0.mlp.experts"
+    method = cfg.get_quant_method(experts_layer(), qualified)
+    assert isinstance(method, Exl3MoEMethod), type(method)
+    assert method.key_prefix == EXPERTS_PREFIX, method.key_prefix
+
+
+def case_apply_implemented() -> None:
+    """P2-01: the eager routed-expert path is implemented (no stub/fallback)."""
+    cfg = make_config(expert_storage())
+    layer = experts_layer()
+    method = cfg.get_quant_method(layer, EXPERTS_PREFIX)
+    assert method.is_monolithic is False
+    assert callable(method.apply)
+    # Empty work returns an empty result before touching any expert weight.
+    out = method.apply(
+        layer, torch.zeros(0, 2048), torch.zeros(0, 8),
+        torch.zeros(0, 8, dtype=torch.int32), None, None,
+    )
+    assert tuple(out.shape) == (0, 2048), tuple(out.shape)
+
+
+def expect_unsupported(
+    fn: Callable[[], object], contains: str, label: str
+) -> None:
+    try:
+        fn()
+    except Exl3MoEUnsupported as exc:
+        assert contains in str(exc), f"{label}: expected {contains!r} in {exc!s}"
+    else:
+        raise AssertionError(f"{label}: expected Exl3MoEUnsupported, got a method")
+
+
+def case_no_expert_tensors_raise() -> None:
+    cfg = make_config(dense_storage())
+    layer = experts_layer()
+    expect_unsupported(
+        lambda: cfg.get_quant_method(layer, EXPERTS_PREFIX),
+        "no EXL3 expert tensors",
+        "unquantized MoE",
+    )
+
+
+def case_partial_expert_raises() -> None:
+    st = expert_storage(skip=(f"{EXPERTS_PREFIX}.7.down_proj",))
+    cfg = make_config(st)
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "expert 7 is missing quantized projections ['down_proj']",
+        "partial expert",
+    )
+
+
+def case_expert_count_mismatch_raises() -> None:
+    cfg = make_config(expert_storage(num_experts=255))
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "checkpoint has 255 experts",
+        "expert count",
+    )
+
+
+def case_mixed_K_raises() -> None:
+    st = expert_storage(overrides={f"{EXPERTS_PREFIX}.0.gate_proj": 4})
+    cfg = make_config(st)
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "mixed trellis K",
+        "mixed K",
+    )
+
+
+def case_unsupported_K_raises() -> None:
+    cfg = make_config(expert_storage(K=5))
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "no ESIMD kernel for K=5",
+        "unsupported K",
+    )
+
+
+def case_empty_storage_raises() -> None:
+    cfg = make_config({})
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "storage map is empty",
+        "empty storage",
+    )
+
+
+def case_tp_ep_raise() -> None:
+    cfg = make_config(expert_storage())
+    for kwargs, label in (
+        ({"tp_size": 2}, "tp>1"),
+        ({"ep_size": 2}, "ep>1"),
+    ):
+        expect_unsupported(
+            lambda kw=kwargs: cfg.get_quant_method(experts_layer(**kw), EXPERTS_PREFIX),
+            "parallelism is not supported",
+            label,
+        )
+
+
+def case_unknown_codebook_raises() -> None:
+    cfg = make_config(expert_storage(), codebook="mul2")
+    expect_unsupported(
+        lambda: cfg.get_quant_method(experts_layer(), EXPERTS_PREFIX),
+        "unknown codebook",
+        "unknown codebook",
+    )
+
+
+def case_no_unquantized_symbol_in_moe_module() -> None:
+    import exl3xpu.moe as moe_mod
+
+    src = open(moe_mod.__file__).read()
+    # The MoE adapter must not import or construct the forbidden fallback. The
+    # class name may appear in prose (docstrings explain why), so key off code
+    # constructs only.
+    assert "import UnquantizedFusedMoEMethod" not in src
+    assert "UnquantizedFusedMoEMethod(" not in src
+
+
+CASES: list[tuple[str, Callable[[], None]]] = [
+    ("dense linear -> Exl3LinearMethod", case_dense_resolves_to_exl3),
+    ("unquantized dense stays unquantized", case_unquantized_dense_still_unquantized),
+    ("routed experts -> Exl3MoEMethod", case_experts_resolve_to_exl3_moe),
+    ("direct get_quant_method -> Exl3MoEMethod", case_experts_direct_get_quant_method),
+    ("model-qualified prefix normalizes", case_model_qualified_prefix_normalizes),
+    ("apply implemented (empty work)", case_apply_implemented),
+    ("unquantized MoE raises", case_no_expert_tensors_raise),
+    ("partially-quantized expert raises", case_partial_expert_raises),
+    ("expert-count mismatch raises", case_expert_count_mismatch_raises),
+    ("mixed-K experts raise", case_mixed_K_raises),
+    ("unsupported K raises", case_unsupported_K_raises),
+    ("empty storage raises", case_empty_storage_raises),
+    ("TP/EP raise", case_tp_ep_raise),
+    ("unknown codebook raises", case_unknown_codebook_raises),
+    ("moe.py has no unquantized fallback", case_no_unquantized_symbol_in_moe_module),
+]
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--verbose", action="store_true")
+    ap.add_argument("--json-out", type=str, default=None,
+                    help="write a machine-readable summary (evidence artifact)")
+    args = ap.parse_args()
+
+    failures: list[str] = []
+    results: list[dict] = []
+    for name, fn in CASES:
+        try:
+            fn()
+        except Exception as exc:
+            failures.append(name)
+            results.append({"case": name, "ok": False, "error": f"{type(exc).__name__}: {exc}"})
+            print(f"FAIL {name}")
+            if args.verbose:
+                traceback.print_exc()
+        else:
+            results.append({"case": name, "ok": True})
+            print(f"OK   {name}")
+
+    print(f"\n{len(CASES) - len(failures)}/{len(CASES)} dispatch cases pass")
+
+    if args.json_out:
+        import hashlib
+        import json
+        from pathlib import Path
+
+        import exl3xpu.moe as moe_mod
+        from exl3xpu import ops
+
+        def sha(path: str) -> str:
+            return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+        summary = {
+            "task": "P1-01",
+            "pass": not failures,
+            "cases": results,
+            "failures": failures,
+            "device": torch.xpu.get_device_properties(0).name,
+            "torch": torch.__version__,
+            "requested_backend": __import__("os").environ.get("EXL3_BACKEND", "auto"),
+            "small_m_max_k3_cb1": ops.small_m_max(3, 1),
+            "moe_method_module": moe_mod.__file__,
+            "moe_method_sha256": sha(moe_mod.__file__),
+            "test_sha256": sha(__file__),
+        }
+        Path(args.json_out).write_text(json.dumps(summary, indent=2) + "\n")
+        print(f"wrote {args.json_out}")
+
+    if failures:
+        print("failures:", failures)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/_moe_harness.py
--- a/tests/_moe_harness.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/_moe_harness.py	2026-10-24 10:12:58.847025873 +0200
@@ -0,0 +1,213 @@
+"""Shared harness for Phase 2 MoE tests (P2-01..P2-09).
+
+Loads a fully-populated layer-0 routed-expert layer from the pinned 3.09bpw
+checkpoint, plus the router and shared expert, and exposes:
+
+* ``Harness.router`` / ``restricted_routing`` — reference routing;
+* ``Harness.routed`` — ``Exl3MoEMethod.apply``;
+* ``Harness.shared`` — the EXL3 shared expert with its learned gate;
+* ``Harness.free_routing_reference`` — CPU fp32 reference for selected experts.
+
+It is imported by ``tests/test_moe_block.py`` and ``tests/test_moe_routing.py``.
+"""
+
+from __future__ import annotations
+
+import json
+import types
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+import torch.nn as nn
+from safetensors import safe_open
+from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
+
+from exl3xpu import ops
+from exl3xpu import ref
+from exl3xpu.moe import Exl3MoEMethod, stream_expert_shards
+from exl3xpu.vllm_plugin import Exl3Config
+
+NUM_EXPERTS = 256
+HIDDEN = 2048
+INTERMEDIATE = 512
+TOPK = 8
+T2_MAX_ABS = 0.08
+PROJECTIONS = ("gate_proj", "up_proj", "down_proj")
+DEFAULT_MODEL = "/home/yanchun/models/Qwen3.5-35B-A3B-exl3-3.09bpw"
+
+
+class Checkpoint:
+    """Key -> tensor access through the shard index."""
+
+    def __init__(self, model_dir: Path):
+        self.model_dir = model_dir
+        self.weight_map = json.loads(
+            (model_dir / "model.safetensors.index.json").read_text()
+        )["weight_map"]
+        self._handles: dict[str, object] = {}
+
+    def has(self, key: str) -> bool:
+        return key in self.weight_map
+
+    def get(self, key: str) -> torch.Tensor:
+        shard = self.weight_map[key]
+        if shard not in self._handles:
+            self._handles[shard] = safe_open(str(self.model_dir / shard), framework="pt")
+        return self._handles[shard].get_tensor(key)
+
+
+def make_layer(layer_id: int) -> RoutedExperts:
+    """Minimal but faithful ``RoutedExperts`` (the real ctor needs an engine)."""
+    layer = object.__new__(RoutedExperts)
+    nn.Module.__init__(layer)
+    prefix = f"model.language_model.layers.{layer_id}.mlp.experts"
+    layer.layer_name = prefix
+    layer.ckpt_gate_proj_name = "gate_proj"
+    layer.ckpt_up_proj_name = "up_proj"
+    layer.ckpt_down_proj_name = "down_proj"
+    layer.lora_base_layer_prefix = ""
+    layer.is_fused_checkpoint_transposed = False
+    layer.moe_config = types.SimpleNamespace(
+        num_experts=NUM_EXPERTS,
+        num_local_experts=NUM_EXPERTS,
+        hidden_dim=HIDDEN,
+        intermediate_size_per_partition=INTERMEDIATE,
+        moe_parallel_config=types.SimpleNamespace(
+            tp_size=1, ep_size=1, use_ep=False, enable_eplb=False
+        ),
+    )
+    layer.expert_map_manager = types.SimpleNamespace(num_fused_shared_experts=0)
+    return layer
+
+
+class Harness:
+    """Layer-0 routed experts + shared expert + router, from the checkpoint."""
+
+    def __init__(self, model_dir: Path | str = DEFAULT_MODEL, layer_id: int = 0):
+        model_dir = Path(model_dir)
+        self.ckpt = Checkpoint(model_dir)
+        self.layer_id = layer_id
+        self.mlp = f"model.language_model.layers.{layer_id}.mlp"
+        # Platform baseline: M>8 never takes the DPAS path on Arc 140V.
+        ops.SMALL_M_MAX = 8
+
+        qc = json.loads((model_dir / "quantization_config.json").read_text())
+        self.config = Exl3Config(
+            bits=float(qc["bits"]),
+            head_bits=int(qc["head_bits"]),
+            codebook=qc["codebook"],
+        )
+        self.config.maybe_update_config(str(model_dir))
+
+        self.layer = make_layer(layer_id)
+        self.method = Exl3MoEMethod(self.config, self.layer, f"{self.mlp}.experts")
+        with torch.device("xpu"):
+            self.method.create_weights(
+                self.layer, NUM_EXPERTS, HIDDEN, INTERMEDIATE, torch.bfloat16
+            )
+        self.layer.quant_method = self.method
+        key = f"layers.{layer_id}.mlp.experts"
+        shards = sorted(set(self.ckpt.weight_map.values()))
+        stream_expert_shards([str(model_dir / s) for s in shards], {key: self.layer})
+        self.method.process_weights_after_loading(self.layer)
+
+        self.router_w = self.ckpt.get(f"{self.mlp}.gate.weight").float().to("xpu")
+        self.shared_gate_w = (
+            self.ckpt.get(f"{self.mlp}.shared_expert_gate.weight").float().to("xpu")
+        )
+        self._wcache: dict[int, dict[str, torch.Tensor]] = {}
+
+    # -- routing -----------------------------------------------------------
+    def router(self, x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        logits = x.float() @ self.router_w.T
+        top_w, top_i = torch.topk(logits, TOPK, dim=-1)
+        top_w = torch.softmax(top_w.float(), dim=-1)
+        return logits, top_i.to(torch.int32), top_w
+
+    def restricted_routing(self, x: torch.Tensor, experts=(0, 255)):
+        """Oracle block routing: softmax over two available experts."""
+        logits = x.float() @ self.router_w.T
+        w = torch.softmax(logits[:, list(experts)].float(), dim=-1)
+        ids = torch.tensor([list(experts)], dtype=torch.int32, device=x.device).repeat(
+            x.shape[0], 1
+        )
+        return ids, w
+
+    # -- execution ---------------------------------------------------------
+    def routed(self, x, ids, weights):
+        return self.method.apply(
+            layer=self.layer,
+            x=x,
+            topk_weights=weights,
+            topk_ids=ids,
+            shared_experts=None,
+            shared_experts_input=None,
+        )
+
+    def dense_linear(self, x, base: str):
+        tr = self.ckpt.get(f"{base}.trellis")
+        suh = self.ckpt.get(f"{base}.suh")
+        svh = self.ckpt.get(f"{base}.svh")
+        cb = 1 if self.ckpt.has(f"{base}.mcg") else (
+            2 if self.ckpt.has(f"{base}.mul1") else 0
+        )
+        K = tr.shape[-1] // 16
+        n = tr.shape[1] * 16
+        nb = torch.zeros(n // 128, dtype=torch.int32, device=x.device)
+        return ops.exl3_linear(
+            x, tr.to("xpu"), suh.view(1, -1).to("xpu"), svh.to("xpu"),
+            nb, [0, n], K, cb,
+        )
+
+    def shared(self, x: torch.Tensor) -> torch.Tensor:
+        base = f"{self.mlp}.shared_expert"
+        g = self.dense_linear(x, f"{base}.gate_proj")
+        u = self.dense_linear(x, f"{base}.up_proj")
+        h = self.dense_linear(F.silu(g) * u, f"{base}.down_proj")
+        scalar = torch.sigmoid(x.float() @ self.shared_gate_w.T)
+        return h.float() * scalar
+
+    # -- reference ---------------------------------------------------------
+    def _expert_weights_cpu(self, e: int) -> dict[str, torch.Tensor]:
+        if e not in self._wcache:
+            views = self.method.expert_views(self.layer, e)
+            self._wcache[e] = {
+                p: ref.weight_orig(
+                    views[p]["trellis"].cpu(),
+                    views[p]["suh"].cpu(),
+                    views[p]["svh"].cpu(),
+                    views[p]["K"],
+                    views[p]["cb"],
+                )
+                for p in PROJECTIONS
+            }
+        return self._wcache[e]
+
+    def expert_mlp_reference(self, e: int, x: torch.Tensor, w: float = 1.0) -> torch.Tensor:
+        m = self._expert_weights_cpu(e)
+        xi = x.float()
+        h = F.silu(xi @ m["gate_proj"]) * (xi @ m["up_proj"])
+        return w * (h @ m["down_proj"])
+
+    def free_routing_reference(
+        self, x: torch.Tensor, ids: torch.Tensor, weights: torch.Tensor
+    ) -> torch.Tensor:
+        out = torch.zeros(x.shape, dtype=torch.float32)
+        for t in range(x.shape[0]):
+            for slot in range(ids.shape[1]):
+                out[t] += self.expert_mlp_reference(
+                    int(ids[t, slot]), x[t], float(weights[t, slot])
+                )
+        return out
+
+
+def metrics(got: torch.Tensor, want: torch.Tensor) -> dict[str, float]:
+    a, b = got.float(), want.float()
+    diff = (a - b).abs()
+    return {
+        "max_abs": float(diff.max().item()) if diff.numel() else 0.0,
+        "p99_abs": float(torch.quantile(diff.flatten(), 0.99).item())
+        if diff.numel() else 0.0,
+        "nan_inf": int(torch.isnan(a).sum().item() + torch.isinf(a).sum().item()),
+    }

## file: tests/_dense_gdn_ref.py
--- a/tests/_dense_gdn_ref.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/_dense_gdn_ref.py	2026-10-24 10:49:34.991946571 +0200
@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+"""P2-09 helper: dense (unquantized) GDN attention reference on XPU.
+
+Runs in a clean process (the mixed-config/global-state collision between the
+EXL3 decoder layer and a second plain vLLM config makes an in-process second
+layer unreliable). Builds ``QwenGatedDeltaNetAttention`` from the probe config
+(quantization stripped), loads the layer-0 GDN weights with the EXL3
+projections dequantized through ``ref.weight_orig``, and writes the attention
+output for a given input.
+
+    python tests/_dense_gdn_ref.py --input norm1.npz --out attn_ref.npz
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+# The parent test process holds its own torch.distributed rendezvous; use a
+# distinct port so this reference process does not collide with it.
+import os
+os.environ["MASTER_PORT"] = "29631"
+
+import exl3xpu.vllm_plugin  # noqa: F401,E402
+from exl3xpu import ref  # noqa: E402
+from safetensors import safe_open  # noqa: E402
+
+import gdn_fixture_probe as gdn_probe  # noqa: E402
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default="/home/yanchun/models/Qwen3.5-35B-A3B-exl3-3.09bpw")
+    ap.add_argument("--input", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--fp16-weights", action="store_true",
+                    help="round dequantized projections to fp16 (sensitivity probe)")
+    ap.add_argument("--proj", default=None,
+                    help="npz with EXL3 qkvz/ba projections; bypass the linears")
+    args = ap.parse_args()
+
+    model_dir = Path(args.model_dir)
+    data = np.load(args.input)
+    x = torch.from_numpy(data["x"].copy()).to(torch.bfloat16).to("xpu")
+
+    probe_dir = gdn_probe.prepare_probe_config(model_dir)
+    vc = gdn_probe.make_vllm_config(probe_dir)
+    with gdn_probe.standalone_vllm(probe_dir):
+        cfg = vc.model_config.hf_text_config
+        torch.set_default_dtype(torch.bfloat16)
+        from vllm.config import set_current_vllm_config
+        from vllm.forward_context import set_forward_context
+        from vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn import (
+            QwenGatedDeltaNetAttention,
+        )
+        from vllm.model_executor.layers.mamba.mamba_utils import MambaStateShapeCalculator
+        from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+
+        ckpt_prefix = f"model.language_model.layers.{args.layer}.linear_attn"
+        prefix = f"model.language_model.layers.{args.layer}.linear_attn_ref"
+        layer = QwenGatedDeltaNetAttention(
+            config=cfg, vllm_config=vc, prefix=prefix, gqa_interleaved_layout=False
+        )
+        wm = json.loads((model_dir / "model.safetensors.index.json").read_text())["weight_map"]
+        handles: dict[str, object] = {}
+
+        def get(key: str) -> torch.Tensor:
+            shard = wm[key]
+            if shard not in handles:
+                handles[shard] = safe_open(str(model_dir / shard), framework="pt")
+            return handles[shard].get_tensor(key)
+
+        def dequant(base: str) -> torch.Tensor:
+            tr = get(f"{base}.trellis")
+            suh = get(f"{base}.suh")
+            svh = get(f"{base}.svh")
+            cb = 1 if f"{base}.mcg" in wm else (2 if f"{base}.mul1" in wm else 0)
+            w = ref.weight_orig(tr, suh, svh, tr.shape[-1] // 16, cb).t().contiguous()
+            if args.fp16_weights:
+                w = w.half().float()
+            return w
+
+        with torch.no_grad():
+            layer.in_proj_qkvz.weight.data.copy_(
+                torch.cat([dequant(f"{ckpt_prefix}.in_proj_qkv"),
+                           dequant(f"{ckpt_prefix}.in_proj_z")], 0)
+                .to(layer.in_proj_qkvz.weight.dtype)
+            )
+            layer.in_proj_ba.weight.data.copy_(
+                torch.cat([get(f"{ckpt_prefix}.in_proj_b.weight"),
+                           get(f"{ckpt_prefix}.in_proj_a.weight")], 0)
+                .to(layer.in_proj_ba.weight.dtype)
+            )
+            layer.out_proj.weight.data.copy_(
+                dequant(f"{ckpt_prefix}.out_proj").to(layer.out_proj.weight.dtype)
+            )
+            layer.conv1d.weight.data.copy_(get(f"{ckpt_prefix}.conv1d.weight"))
+            layer.A_log.data.copy_(get(f"{ckpt_prefix}.A_log"))
+            layer.dt_bias.data.copy_(get(f"{ckpt_prefix}.dt_bias"))
+            layer.norm.weight.data.copy_(get(f"{ckpt_prefix}.norm.weight"))
+
+        layer = layer.to("xpu")
+        if args.proj:
+            p = np.load(args.proj)
+            qkvz = torch.from_numpy(p["qkvz"]).to(torch.bfloat16).to("xpu")
+            ba = torch.from_numpy(p["ba"]).to(torch.bfloat16).to("xpu")
+            # Same input as the parent run, so the saved projections are valid.
+            object.__setattr__(layer, "in_proj_qkvz", lambda x: (qkvz, None))
+            object.__setattr__(layer, "in_proj_ba", lambda x: (ba, None))
+        conv_shape, ssm_shape = MambaStateShapeCalculator.gated_delta_net_state_shape(
+            tp_world_size=1, num_k_heads=cfg.linear_num_key_heads,
+            num_v_heads=cfg.linear_num_value_heads, head_k_dim=cfg.linear_key_head_dim,
+            head_v_dim=cfg.linear_value_head_dim, conv_kernel_size=cfg.linear_conv_kernel_dim,
+        )
+        op_in: dict[str, torch.Tensor] = {}
+        layer.out_proj.register_forward_hook(
+            lambda m, i, o: op_in.__setitem__("x", i[0].detach())
+        )
+        conv = torch.zeros((1, *conv_shape), dtype=torch.bfloat16, device="xpu")
+        ssm = torch.zeros((1, *ssm_shape), dtype=torch.float32, device="xpu")
+        layer.kv_cache = (conv, ssm)
+        vc.compilation_config.static_forward_context[prefix] = layer
+
+        n = x.shape[0]
+        meta = GDNAttentionMetadata(
+            num_prefills=1, num_prefill_tokens=n, num_decodes=0, num_decode_tokens=0,
+            num_spec_decodes=0, num_spec_decode_tokens=0, num_actual_tokens=n,
+            has_initial_state=torch.tensor([False], dtype=torch.bool, device="xpu"),
+            non_spec_query_start_loc=torch.tensor([0, n], dtype=torch.int32, device="xpu"),
+            non_spec_state_indices_tensor=torch.tensor([0], dtype=torch.int32, device="xpu"),
+        )
+        with set_forward_context(attn_metadata={prefix: meta}, vllm_config=vc, num_tokens=n):
+            out = layer.forward_xpu(x)
+        torch.xpu.synchronize()
+
+    np.savez(
+        args.out,
+        attn=out.float().cpu().numpy(),
+        out_proj_in=op_in["x"].float().cpu().numpy(),
+    )
+    print(f"dense GDN ref: {tuple(out.shape)} finite={bool(torch.isfinite(out.float()).all())} -> {args.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_moe_block.py
--- a/tests/test_moe_block.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_moe_block.py	2026-10-24 10:15:22.735546199 +0200
@@ -0,0 +1,226 @@
+#!/usr/bin/env python3
+"""P2-01/P2-04/P2-07: eager EXL3 MoE block.
+
+Builds a fully-loaded layer-0 routed-expert layer from the real 3.09bpw
+checkpoint, then exercises ``Exl3MoEMethod.apply`` (eager per-expert dispatch):
+
+* restricted-routing block vs the P0-08 oracle ``block/y`` (experts {0,255});
+* shared-expert isolation and routed+shared accumulation;
+* router logits / top-8 / renormalization vs ``router/*``;
+* free top-8 routing vs a CPU reference built from the same expert weights;
+* token accounting: every one of the B*k assignments contributes.
+
+    .venv/bin/python tests/test_moe_block.py
+
+Evidence: ``logs/moe-p2/moe-block-eval.{log,json}``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import traceback
+from collections.abc import Callable
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from _moe_harness import Harness, metrics, T2_MAX_ABS
+
+ROOT = Path(__file__).resolve().parents[1]
+TRACES = ROOT / "fixtures" / "reference_moe_traces.npz"
+DEFAULT_MODEL = "/home/yanchun/models/Qwen3.5-35B-A3B-exl3-3.09bpw"
+
+
+def case_router(h: Harness, traces, records) -> None:
+    x = torch.from_numpy(traces["inputs/x"].copy()).float().to("xpu")
+    logits, ids, weights = h.router(x)
+    ref_logits = torch.from_numpy(traces["router/logits"].copy()).float()
+    ref_ids = torch.from_numpy(traces["router/topk_ids"].copy()).long()
+    ref_w = torch.from_numpy(traces["router/topk_weights"].copy()).float()
+    cos = F.cosine_similarity(logits.cpu(), ref_logits, dim=-1)
+    agree = (torch.sort(ids.cpu(), dim=-1).values
+             == torch.sort(ref_ids, dim=-1).values).all().item()
+    w_err = float((weights.cpu() - ref_w).abs().max().item())
+    rec = {
+        "case": "router_alignment",
+        "cos_min": float(cos.min().item()),
+        "top8_agreement": float(agree),
+        "weight_max_abs": w_err,
+        "pass": float(cos.min().item()) >= 0.999 and bool(agree) and w_err <= 1e-5,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_restricted_block(h: Harness, traces, records) -> None:
+    x = torch.from_numpy(traces["inputs/x"].copy()).to(torch.float16).to("xpu")
+    ids, w = h.restricted_routing(x)
+    routed = h.routed(x, ids, w)
+    block = torch.from_numpy(traces["block/y"].copy()).float()
+    shared = torch.from_numpy(traces["shared/y"].copy()).float()
+    st = metrics(routed.cpu(), block - shared)
+    rec = {"case": "restricted_block_routed", **st, "pass": st["max_abs"] <= T2_MAX_ABS}
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_full_block(h: Harness, traces, records) -> None:
+    """Routed (restricted) + shared, with shared computed by the block itself."""
+    x = torch.from_numpy(traces["inputs/x"].copy()).to(torch.float16).to("xpu")
+    ids, w = h.restricted_routing(x)
+    got = h.routed(x, ids, w).float() + h.shared(x)
+    want = torch.from_numpy(traces["block/y"].copy()).float()
+    st = metrics(got.cpu(), want)
+    rec = {"case": "full_block_routed_plus_shared", **st, "pass": st["max_abs"] <= T2_MAX_ABS}
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_free_routing(h: Harness, traces, records) -> None:
+    x = torch.from_numpy(traces["inputs/x"].copy()).to(torch.float16).to("xpu")
+    _, ids, w = h.router(x)
+    got = h.routed(x, ids, w).cpu()
+    want = h.free_routing_reference(x.cpu().to(torch.float16), ids.cpu(), w.cpu())
+    st = metrics(got, want)
+    rec = {
+        "case": "free_routing_vs_reference",
+        "unique_experts": int(torch.unique(ids).numel()),
+        "assignments": int(ids.numel()),
+        **st,
+        "pass": st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+class _SharedMustNotRun:
+    """Sentinel: the runner owns the shared expert, so ``apply`` must not call it."""
+
+    def __call__(self, *args, **kwargs):
+        raise AssertionError("apply() must not execute the runner-owned shared expert")
+
+    def forward(self, *args, **kwargs):
+        raise AssertionError("apply() must not execute the runner-owned shared expert")
+
+
+def case_shared_ownership(h: Harness, traces, records) -> None:
+    """P2-04: shared expert is computed once, by MoERunner, not by ``apply``."""
+    x = torch.from_numpy(traces["inputs/x"].copy()).to(torch.float16).to("xpu")
+    ids, w = h.restricted_routing(x)
+    plain = h.routed(x, ids, w)
+    with_sentinel = h.method.apply(
+        layer=h.layer,
+        x=x,
+        topk_weights=w,
+        topk_ids=ids,
+        shared_experts=_SharedMustNotRun(),
+        shared_experts_input=x,
+    )
+    same = torch.equal(plain, with_sentinel)
+    rec = {
+        "case": "shared_ownership",
+        "apply_ignores_shared_argument": same,
+        "pass": same,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_token_accounting(h: Harness, traces, records) -> None:
+    """Every (token, slot) assignment must contribute (P2-07)."""
+    x = torch.from_numpy(traces["inputs/x"].copy()).to(torch.float16).to("xpu")
+    _, ids, w = h.router(x)
+    full = h.routed(x, ids, w).cpu().float()
+    zero = h.routed(x, ids, torch.zeros_like(w)).cpu().float()
+    per_slot = []
+    for slot in range(ids.shape[1]):
+        w_ablate = w.clone()
+        w_ablate[:, slot] = 0.0
+        per_slot.append(
+            float((full - h.routed(x, ids, w_ablate).cpu().float()).abs().max().item())
+        )
+    rec = {
+        "case": "token_accounting",
+        "assignments": int(ids.numel()),
+        "tokens": int(ids.shape[0]),
+        "topk": int(ids.shape[1]),
+        "zero_weights_max_abs": float(zero.abs().max().item()),
+        "per_slot_contribution_max_abs": per_slot,
+        "all_slots_contribute": all(v > 0 for v in per_slot),
+        "pass": float(zero.abs().max().item()) == 0.0 and all(v > 0 for v in per_slot),
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--log-out", default=str(ROOT / "logs/moe-p2/moe-block-eval.log"))
+    ap.add_argument("--json-out", default=str(ROOT / "logs/moe-p2/moe-block-eval.json"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not torch.xpu.is_available():
+        raise SystemExit("P2 block test needs the XPU")
+    if not TRACES.is_file():
+        raise SystemExit(f"missing oracle {TRACES}")
+
+    traces = np.load(TRACES)
+    h = Harness(args.model_dir, args.layer)
+    records: list[dict] = []
+    failures: list[str] = []
+
+    cases: list[tuple[str, Callable[[], None]]] = [
+        ("router alignment", lambda: case_router(h, traces, records)),
+        ("restricted-routing block vs oracle", lambda: case_restricted_block(h, traces, records)),
+        ("routed + shared block vs oracle", lambda: case_full_block(h, traces, records)),
+        ("free top-8 routing vs reference", lambda: case_free_routing(h, traces, records)),
+        ("shared ownership (no double compute)", lambda: case_shared_ownership(h, traces, records)),
+        ("token accounting (all 8 slots)", lambda: case_token_accounting(h, traces, records)),
+    ]
+    results = []
+    for label, fn in cases:
+        try:
+            fn()
+            results.append({"case": label, "pass": True})
+            print(f"OK   {label}")
+        except Exception as exc:  # noqa: BLE001
+            failures.append(f"{label}: {exc}")
+            results.append({"case": label, "pass": False, "error": str(exc)})
+            print(f"FAIL {label}: {exc}")
+            if args.verbose:
+                traceback.print_exc()
+
+    summary = {
+        "task": "P2-01/P2-04/P2-07",
+        "pass": not failures,
+        "model_dir": str(args.model_dir),
+        "layer": args.layer,
+        "device": torch.xpu.get_device_properties(0).name,
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "cases": results,
+        "failures": failures,
+        "records": records,
+    }
+    log_path = Path(args.log_out)
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    lines = [f"P2 MoE block layer={args.layer} T2={T2_MAX_ABS}"]
+    for r in records:
+        lines.append("  " + json.dumps(r, sort_keys=True))
+    lines.append(f"pass={summary['pass']} failures={failures}")
+    log_path.write_text("\n".join(lines) + "\n")
+    if args.json_out:
+        out = Path(args.json_out)
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(summary, indent=2) + "\n")
+    print(f"\npass={summary['pass']} failures={failures}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_moe_routing.py
--- a/tests/test_moe_routing.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_moe_routing.py	2026-10-24 10:14:47.977657488 +0200
@@ -0,0 +1,341 @@
+#!/usr/bin/env python3
+"""P2-02/P2-03/P2-06: routing alignment, weight application, edge cases.
+
+* P2-02: reference top-k + softmax-renormalization, and proof that ``apply``
+  consumes the precomputed ``(topk_ids, topk_weights)`` without recalculating
+  (output is exactly linear in the supplied weights).
+* P2-03: the routing weight multiplies the **down-projection output**, never the
+  input activations (``w*MLP(x) != MLP(w*x)``).
+* P2-06: extreme skew, uniform 256-way routing, zero-token experts, logit
+  near-ties, and M=0/M=1.
+
+    .venv/bin/python tests/test_moe_routing.py
+
+Evidence: ``logs/moe-p2/routing-eval.{log,json}`` and
+``logs/moe-p2/edge-cases.log``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import traceback
+from collections.abc import Callable
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.profiler import ProfilerActivity, profile
+
+from _moe_harness import Harness, metrics, T2_MAX_ABS, TOPK
+
+ROOT = Path(__file__).resolve().parents[1]
+TRACES = ROOT / "fixtures" / "reference_moe_traces.npz"
+DEFAULT_MODEL = "/home/yanchun/models/Qwen3.5-35B-A3B-exl3-3.09bpw"
+
+
+def xpu_launch_count(fn: Callable[[], object]) -> int:
+    with profile(activities=[ProfilerActivity.XPU]) as prof:
+        fn()
+        torch.xpu.synchronize()
+    return sum(
+        int(r.count) for r in prof.key_averages()
+        if getattr(r, "self_device_time_total", 0) > 0
+    )
+
+
+def make_x(m: int, seed: int = 11) -> torch.Tensor:
+    g = torch.Generator().manual_seed(seed)
+    return (torch.randn(m, 2048, generator=g) * 0.05).half().to("xpu")
+
+
+# ---------------------------------------------------------------------------
+# P2-02
+# ---------------------------------------------------------------------------
+
+def case_router_reference(h: Harness, traces, records) -> None:
+    x = torch.from_numpy(traces["inputs/x"].copy()).float().to("xpu")
+    logits, ids, weights = h.router(x)
+    ref_logits = torch.from_numpy(traces["router/logits"].copy()).float()
+    ref_ids = torch.from_numpy(traces["router/topk_ids"].copy()).long()
+    ref_w = torch.from_numpy(traces["router/topk_weights"].copy()).float()
+    cos = torch.nn.functional.cosine_similarity(logits.cpu(), ref_logits, dim=-1)
+    agree = (torch.sort(ids.cpu(), dim=-1).values
+             == torch.sort(ref_ids, dim=-1).values).all().item()
+    sums = weights.sum(-1)
+    rec = {
+        "case": "router_reference",
+        "cos_min": float(cos.min().item()),
+        "top8_agreement": float(agree),
+        "weight_max_abs": float((weights.cpu() - ref_w).abs().max().item()),
+        "weight_row_sum_min": float(sums.min().item()),
+        "weight_row_sum_max": float(sums.max().item()),
+        "pass": float(cos.min().item()) >= 0.999 and bool(agree)
+        and float((weights.cpu() - ref_w).abs().max().item()) <= 1e-5
+        and float((sums - 1).abs().max().item()) <= 1e-5,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_consumes_precomputed(h: Harness, records) -> None:
+    """Output must be exactly linear in the supplied weights (no renorm)."""
+    x = make_x(4)
+    _, ids, w = h.router(x)
+    y1 = h.routed(x, ids, w).float()
+    y2 = h.routed(x, ids, 2.0 * w).float()
+    err = float((y2 - 2.0 * y1).abs().max().item())
+    rec = {
+        "case": "consumes_precomputed_weights",
+        "scale_error": err,
+        "pass": err <= 2e-5,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+# ---------------------------------------------------------------------------
+# P2-03
+# ---------------------------------------------------------------------------
+
+def case_weight_after_down(h: Harness, records) -> None:
+    x = make_x(1, seed=21)
+    e, w = 0, 2.0
+    ids = torch.tensor([[e]], dtype=torch.int32, device="xpu")
+    weights = torch.tensor([[w]], dtype=torch.float32, device="xpu")
+    got = h.routed(x, ids, weights).cpu().float()
+
+    want_after = h.expert_mlp_reference(e, x.cpu(), w=w)
+    want_input = h.expert_mlp_reference(e, x.cpu() * w, w=1.0)
+
+    st_after = metrics(got, want_after)
+    st_input = metrics(got, want_input)
+    ratio = st_input["max_abs"] / max(st_after["max_abs"], 1e-12)
+    rec = {
+        "case": "weight_applied_after_down",
+        "vs_w_times_mlp_max_abs": st_after["max_abs"],
+        "vs_mlp_of_wx_max_abs": st_input["max_abs"],
+        "wrong_over_right_error_ratio": ratio,
+        # Correct = w*MLP(x); wrong = MLP(w*x). The latter is clearly worse
+        # even though SiLU is near-linear for these small activations.
+        "pass": st_after["max_abs"] <= T2_MAX_ABS and ratio >= 20.0,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_weight_not_on_input(h: Harness, records) -> None:
+    """Two experts with different weights: result == sum w_e * MLP_e(x)."""
+    x = make_x(2, seed=22)
+    ids = torch.tensor([[0, 255], [0, 255]], dtype=torch.int32, device="xpu")
+    weights = torch.tensor([[0.7, 0.3], [0.2, 0.8]], dtype=torch.float32, device="xpu")
+    got = h.routed(x, ids, weights).cpu().float()
+    want = torch.zeros_like(got)
+    for t in range(2):
+        for s in range(2):
+            want[t] += h.expert_mlp_reference(
+                int(ids[t, s]), x[t].cpu(), float(weights[t, s])
+            )
+    st = metrics(got, want)
+    rec = {"case": "weight_not_on_input", **st, "pass": st["max_abs"] <= T2_MAX_ABS}
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+# ---------------------------------------------------------------------------
+# P2-06 edge cases
+# ---------------------------------------------------------------------------
+
+def case_extreme_skew(h: Harness, records) -> None:
+    x = make_x(16, seed=31)
+    ids = torch.zeros((16, 1), dtype=torch.int32, device="xpu")
+    w = torch.ones((16, 1), dtype=torch.float32, device="xpu")
+    got = h.routed(x, ids, w).cpu().float()
+    want = torch.stack([h.expert_mlp_reference(0, x[t].cpu()) for t in range(16)])
+    st = metrics(got, want)
+    rec = {
+        "case": "extreme_skew_single_expert",
+        "tokens": 16,
+        "unique_experts": int(torch.unique(ids).numel()),
+        **st,
+        "pass": st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_uniform_256(h: Harness, records) -> None:
+    x = make_x(256, seed=32)
+    ids = torch.arange(256, dtype=torch.int32, device="xpu").reshape(-1, 1)
+    w = torch.ones((256, 1), dtype=torch.float32, device="xpu")
+    got = h.routed(x, ids, w).cpu().float()
+    # Numerically verify a spread sample; all 256 experts are exercised.
+    sample = [0, 1, 2, 63, 127, 128, 254, 255]
+    sample_err = 0.0
+    for e in sample:
+        want = h.expert_mlp_reference(e, x[e].cpu())
+        sample_err = max(sample_err, float((got[e] - want).abs().max().item()))
+    rec = {
+        "case": "uniform_256",
+        "tokens": 256,
+        "unique_experts": int(torch.unique(ids).numel()),
+        "sampled_experts": sample,
+        "sample_max_abs": sample_err,
+        "finite": bool(torch.isfinite(got).all()),
+        "pass": int(torch.unique(ids).numel()) == 256
+        and sample_err <= T2_MAX_ABS and bool(torch.isfinite(got).all()),
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_zero_token_experts(h: Harness, records) -> None:
+    x = make_x(8, seed=33)
+    ids = torch.tensor([[0], [5], [100], [0], [5], [100], [0], [5]],
+                       dtype=torch.int32, device="xpu")
+    w = torch.ones((8, 1), dtype=torch.float32, device="xpu")
+    got = h.routed(x, ids, w).cpu().float()
+    want = torch.stack([h.expert_mlp_reference(int(ids[t, 0]), x[t].cpu())
+                        for t in range(8)])
+    st = metrics(got, want)
+    rec = {
+        "case": "zero_token_experts",
+        "active": sorted({int(v) for v in ids.flatten().tolist()}),
+        "inactive_experts": 253,
+        **st,
+        "pass": st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_logit_near_ties(h: Harness, records) -> None:
+    x = torch.zeros((4, 2048), dtype=torch.float16, device="xpu")
+    logits, ids, w = h.router(x)
+    _, ids2, _ = h.router(x)
+    ids_set_ok = sorted(ids[0].cpu().tolist()) == list(range(TOPK))
+    w_err = float((w - 1.0 / TOPK).abs().max().item())
+    rec = {
+        "case": "logit_near_ties",
+        "logits_max_abs": float(logits.abs().max().item()),
+        "ids": ids[0].cpu().tolist(),
+        "ids_stable_across_calls": bool(torch.equal(ids, ids2)),
+        "ids_are_first_topk_set": ids_set_ok,
+        "weights_uniform": w_err <= 1e-6,
+        "pass": float(logits.abs().max().item()) == 0.0
+        and ids_set_ok and bool(torch.equal(ids, ids2)) and w_err <= 1e-6,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_empty_m0(h: Harness, records) -> None:
+    x = torch.empty((0, 2048), dtype=torch.float16, device="xpu")
+    ids = torch.zeros((0, TOPK), dtype=torch.int32, device="xpu")
+    w = torch.zeros((0, TOPK), dtype=torch.float32, device="xpu")
+    out = h.routed(x, ids, w)
+    launches = xpu_launch_count(lambda: h.routed(x, ids, w))
+    rec = {
+        "case": "empty_m0",
+        "shape": list(out.shape),
+        "kernels": launches,
+        "pass": tuple(out.shape) == (0, 2048) and launches == 0,
+    }
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def case_single_token(h: Harness, records) -> None:
+    x = make_x(1, seed=34)
+    _, ids, w = h.router(x)
+    got = h.routed(x, ids, w).cpu().float()
+    want = h.free_routing_reference(x.cpu(), ids.cpu(), w.cpu())
+    st = metrics(got, want)
+    rec = {"case": "single_token_decode", **st,
+           "pass": st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0}
+    records.append(rec)
+    assert rec["pass"], rec
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--log-out", default=str(ROOT / "logs/moe-p2/routing-eval.log"))
+    ap.add_argument("--json-out", default=str(ROOT / "logs/moe-p2/routing-eval.json"))
+    ap.add_argument("--edge-log", default=str(ROOT / "logs/moe-p2/edge-cases.log"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not torch.xpu.is_available():
+        raise SystemExit("P2 routing test needs the XPU")
+    traces = np.load(TRACES) if TRACES.is_file() else None
+    h = Harness(args.model_dir, args.layer)
+    records: list[dict] = []
+    failures: list[str] = []
+    edge_records: list[dict] = []
+
+    cases: list[tuple[str, Callable[[], None]]] = [
+        ("P2-02 router reference", lambda: case_router_reference(h, traces, records)),
+        ("P2-02 consumes precomputed weights", lambda: case_consumes_precomputed(h, records)),
+        ("P2-03 weight after down projection", lambda: case_weight_after_down(h, records)),
+        ("P2-03 weight not on input", lambda: case_weight_not_on_input(h, records)),
+        ("P2-06 extreme skew", lambda: case_extreme_skew(h, edge_records)),
+        ("P2-06 uniform 256", lambda: case_uniform_256(h, edge_records)),
+        ("P2-06 zero-token experts", lambda: case_zero_token_experts(h, edge_records)),
+        ("P2-06 logit near-ties", lambda: case_logit_near_ties(h, edge_records)),
+        ("P2-06 empty M=0", lambda: case_empty_m0(h, edge_records)),
+        ("P2-06 single token M=1", lambda: case_single_token(h, edge_records)),
+    ]
+    results = []
+    for label, fn in cases:
+        try:
+            fn()
+            results.append({"case": label, "pass": True})
+            print(f"OK   {label}")
+        except Exception as exc:  # noqa: BLE001
+            failures.append(f"{label}: {exc}")
+            results.append({"case": label, "pass": False, "error": str(exc)})
+            print(f"FAIL {label}: {exc}")
+            if args.verbose:
+                traceback.print_exc()
+
+    all_records = records + edge_records
+    summary = {
+        "task": "P2-02/P2-03/P2-06",
+        "pass": not failures,
+        "model_dir": str(args.model_dir),
+        "device": torch.xpu.get_device_properties(0).name,
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "cases": results,
+        "failures": failures,
+        "records": all_records,
+    }
+    log_path = Path(args.log_out)
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    lines = [f"P2 routing/edge checks layer={args.layer} T2={T2_MAX_ABS}"]
+    for r in all_records:
+        lines.append("  " + json.dumps(r, sort_keys=True))
+    lines.append(f"pass={summary['pass']} failures={failures}")
+    log_path.write_text("\n".join(lines) + "\n")
+
+    edge_path = Path(args.edge_log)
+    edge_path.parent.mkdir(parents=True, exist_ok=True)
+    edge_path.write_text(
+        "\n".join(
+            [f"P2-06 edge cases T2={T2_MAX_ABS}"]
+            + ["  " + json.dumps(r, sort_keys=True) for r in edge_records]
+            + [f"pass={all(r.get('pass') for r in edge_records)}"]
+        ) + "\n"
+    )
+
+    if args.json_out:
+        out = Path(args.json_out)
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(summary, indent=2) + "\n")
+    print(f"\npass={summary['pass']} failures={failures}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_fixed_routing.py
--- a/tests/test_fixed_routing.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_fixed_routing.py	2026-10-24 10:15:38.494496606 +0200
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""P2-05a: fixed-routing differential test.
+
+Forces every token onto the same fixed expert subset {0..7} with fixed weights,
+isolating expert execution from router selection, and compares the eager
+``apply`` output against a CPU fp32 reference.
+
+    .venv/bin/python tests/test_fixed_routing.py
+
+Evidence: ``logs/moe-p2/fixed-routing.{log,json}``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import torch
+
+from _moe_harness import Harness, metrics, T2_MAX_ABS, DEFAULT_MODEL
+
+ROOT = Path(__file__).resolve().parents[1]
+EXPERTS = (0, 1, 2, 3, 4, 5, 6, 7)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    args = ap.parse_args()
+
+    h = Harness(args.model_dir, args.layer)
+    records = []
+    failures = []
+
+    # Uniform fixed weights over {0..7}.
+    for tokens, seed in ((8, 101), (1, 102)):
+        g = torch.Generator().manual_seed(seed)
+        x = (torch.randn(tokens, 2048, generator=g) * 0.05).half().to("xpu")
+        ids = torch.tensor([list(EXPERTS)], dtype=torch.int32, device="xpu").repeat(tokens, 1)
+        w = torch.full((tokens, len(EXPERTS)), 1.0 / len(EXPERTS), device="xpu")
+        got = h.routed(x, ids, w).cpu().float()
+        want = torch.stack([
+            sum(h.expert_mlp_reference(e, x[t].cpu(), 1.0 / len(EXPERTS)) for e in EXPERTS)
+            for t in range(tokens)
+        ])
+        st = metrics(got, want)
+        rec = {"case": "fixed_uniform", "tokens": tokens, "experts": list(EXPERTS), **st,
+               "pass": st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0}
+        records.append(rec)
+        if not rec["pass"]:
+            failures.append(str(rec))
+
+    # Non-uniform fixed weights (still fixed routing).
+    g = torch.Generator().manual_seed(103)
+    x = (torch.randn(4, 2048, generator=g) * 0.05).half().to("xpu")
+    ids = torch.tensor([list(EXPERTS)], dtype=torch.int32, device="xpu").repeat(4, 1)
+    w = torch.softmax(torch.randn(4, len(EXPERTS), generator=torch.Generator().manual_seed(104)), -1).to("xpu")
+    got = h.routed(x, ids, w).cpu().float()
+    want = torch.stack([
+        sum(h.expert_mlp_reference(e, x[t].cpu(), float(w[t, j]))
+            for j, e in enumerate(EXPERTS))
+        for t in range(4)
+    ])
+    st = metrics(got, want)
+    rec = {"case": "fixed_nonuniform", "tokens": 4, "experts": list(EXPERTS), **st,
+           "pass": st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0}
+    records.append(rec)
+    if not rec["pass"]:
+        failures.append(str(rec))
+
+    summary = {
+        "task": "P2-05a",
+        "pass": not failures,
+        "device": torch.xpu.get_device_properties(0).name,
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "records": records,
+        "failures": failures,
+    }
+    out = ROOT / "logs/moe-p2/fixed-routing.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(summary, indent=2) + "\n")
+    (out.with_suffix(".log")).write_text(
+        "\n".join([f"P2-05a fixed routing T2={T2_MAX_ABS}"]
+                  + [json.dumps(r, sort_keys=True) for r in records]
+                  + [f"pass={summary['pass']}"]) + "\n"
+    )
+    for r in records:
+        print("OK  " if r["pass"] else "FAIL", json.dumps(r, sort_keys=True))
+    print(f"pass={summary['pass']}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_free_routing.py
--- a/tests/test_free_routing.py	2026-10-21 22:05:50.341775534 +0200
