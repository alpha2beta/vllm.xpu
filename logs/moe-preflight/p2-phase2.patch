@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""P2-05b: free-routing differential test.
+
+Runs the dynamic router (top-8 + softmax renormalization) on seeded random
+inputs for several batch sizes and compares the eager ``apply`` output against a
+CPU fp32 reference built from the same checkpoint experts.
+
+    .venv/bin/python tests/test_free_routing.py
+
+Evidence: ``logs/moe-p2/free-routing.{log,json}``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from _moe_harness import Harness, metrics, T2_MAX_ABS, DEFAULT_MODEL
+
+ROOT = Path(__file__).resolve().parents[1]
+TRACES = ROOT / "fixtures" / "reference_moe_traces.npz"
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    args = ap.parse_args()
+
+    h = Harness(args.model_dir, args.layer)
+    records = []
+    failures = []
+
+    # The oracle trace input must select exactly the recorded top-8.
+    if TRACES.is_file():
+        traces = np.load(TRACES)
+        x = torch.from_numpy(traces["inputs/x"].copy()).to(torch.float16).to("xpu")
+        _, ids, w = h.router(x)
+        ref_ids = torch.from_numpy(traces["router/topk_ids"].copy()).long()
+        agree = (torch.sort(ids.cpu(), dim=-1).values
+                 == torch.sort(ref_ids, dim=-1).values).all().item()
+        got = h.routed(x, ids, w).cpu().float()
+        want = h.free_routing_reference(x.cpu(), ids.cpu(), w.cpu())
+        st = metrics(got, want)
+        rec = {"case": "oracle_input_top8", "top8_agreement": float(agree), **st,
+               "pass": bool(agree) and st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0}
+        records.append(rec)
+        if not rec["pass"]:
+            failures.append(str(rec))
+
+    for tokens, seed in ((1, 201), (4, 202), (16, 203)):
+        g = torch.Generator().manual_seed(seed)
+        x = (torch.randn(tokens, 2048, generator=g) * 0.05).half().to("xpu")
+        _, ids, w = h.router(x)
+        got = h.routed(x, ids, w).cpu().float()
+        want = h.free_routing_reference(x.cpu(), ids.cpu(), w.cpu())
+        st = metrics(got, want)
+        rec = {
+            "case": "free_routing",
+            "tokens": tokens,
+            "unique_experts": int(torch.unique(ids).numel()),
+            "assignments": int(ids.numel()),
+            **st,
+            "pass": st["max_abs"] <= T2_MAX_ABS and st["nan_inf"] == 0,
+        }
+        records.append(rec)
+        if not rec["pass"]:
+            failures.append(str(rec))
+
+    summary = {
+        "task": "P2-05b",
+        "pass": not failures,
+        "device": torch.xpu.get_device_properties(0).name,
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "records": records,
+        "failures": failures,
+    }
+    out = ROOT / "logs/moe-p2/free-routing.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(summary, indent=2) + "\n")
+    (out.with_suffix(".log")).write_text(
+        "\n".join([f"P2-05b free routing T2={T2_MAX_ABS}"]
+                  + [json.dumps(r, sort_keys=True) for r in records]
+                  + [f"pass={summary['pass']}"]) + "\n"
+    )
+    for r in records:
+        print("OK  " if r["pass"] else "FAIL", json.dumps(r, sort_keys=True))
+    print(f"pass={summary['pass']}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_intermediate_probe.py
--- a/tests/test_intermediate_probe.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_intermediate_probe.py	2026-10-24 10:18:16.699024918 +0200
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""P2-08: intermediate-stage validation probe.
+
+Enables ``Exl3MoEMethod.enable_debug_capture`` and verifies each stage of the
+MoE block against the CPU reference / P0-08 oracle:
+
+1. router logits and normalized top-8 weights;
+2. per-expert pre-activation ``gate`` and ``up``;
+3. activated hidden state ``SiLU(gate) * up``;
+4. down-projection output;
+5. summed routed tensor and the shared-expert contribution.
+
+    .venv/bin/python tests/test_intermediate_probe.py
+
+Evidence: ``logs/moe-p2/intermediate-stage-validation.json``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import traceback
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from _moe_harness import Harness, metrics, T2_MAX_ABS, DEFAULT_MODEL
+from exl3xpu import ref
+
+ROOT = Path(__file__).resolve().parents[1]
+TRACES = ROOT / "fixtures" / "reference_moe_traces.npz"
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--json-out", default=str(ROOT / "logs/moe-p2/intermediate-stage-validation.json"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    traces = np.load(TRACES)
+    h = Harness(args.model_dir, args.layer)
+    x_h = torch.from_numpy(traces["inputs/x"].copy()).to(torch.float16).to("xpu")
+    x_ref = x_h.cpu()
+
+    stages: dict = {}
+    failures: list[str] = []
+
+    # 1. Router logits + normalized weights.
+    logits, ids, w = h.router(x_h)
+    ref_logits = torch.from_numpy(traces["router/logits"].copy()).float()
+    ref_w = torch.from_numpy(traces["router/topk_weights"].copy()).float()
+    stages["router"] = {
+        "logits": {**metrics(logits.cpu(), ref_logits)},
+        "weights": {**metrics(w.cpu(), ref_w)},
+        "top8_agreement": float(
+            (torch.sort(ids.cpu(), dim=-1).values
+             == torch.sort(torch.from_numpy(traces["router/topk_ids"].copy()).long(),
+                           dim=-1).values).all().item()
+        ),
+    }
+
+    # Run the block with capture on.
+    h.method.enable_debug_capture()
+    try:
+        routed = h.routed(x_h, ids, w)
+    finally:
+        cap = h.method.disable_debug_capture()
+    assert cap is not None, "capture hook returned nothing"
+
+    # 2-4. Per-expert stages.
+    per_expert = {}
+    for e, got in sorted(cap["experts"].items()):
+        token_idx, _ = (ids == e).nonzero(as_tuple=True)
+        rows = x_ref.index_select(0, token_idx.cpu())
+        v = h.method.expert_views(h.layer, e)
+        gate_ref = ref.linear_forward(
+            rows, v["gate_proj"]["trellis"].cpu(), v["gate_proj"]["suh"].cpu(),
+            v["gate_proj"]["svh"].cpu(), v["gate_proj"]["K"], v["gate_proj"]["cb"],
+        )
+        up_ref = ref.linear_forward(
+            rows, v["up_proj"]["trellis"].cpu(), v["up_proj"]["suh"].cpu(),
+            v["up_proj"]["svh"].cpu(), v["up_proj"]["K"], v["up_proj"]["cb"],
+        )
+        act_ref = torch.nn.functional.silu(gate_ref) * up_ref
+        down_ref = ref.linear_forward(
+            act_ref, v["down_proj"]["trellis"].cpu(), v["down_proj"]["suh"].cpu(),
+            v["down_proj"]["svh"].cpu(), v["down_proj"]["K"], v["down_proj"]["cb"],
+        )
+        per_expert[str(e)] = {
+            "rows": int(token_idx.numel()),
+            "gate": metrics(got["gate"].cpu(), gate_ref),
+            "up": metrics(got["up"].cpu(), up_ref),
+            "act": metrics(got["act"].cpu(), act_ref),
+            "down": metrics(got["down"].cpu(), down_ref),
+        }
+    stages["per_expert"] = per_expert
+
+    # 5. Summed routed + shared.
+    routed_ref = h.free_routing_reference(x_ref, ids.cpu(), w.cpu())
+    stages["routed_sum"] = metrics(cap["routed_fp32"].cpu(), routed_ref)
+    shared_ref = torch.from_numpy(traces["shared/y"].copy()).float()
+    stages["shared"] = metrics(h.shared(x_h).cpu(), shared_ref)
+
+    # Gate on the worst per-stage error (except router weights, tiny by nature).
+    worst = 0.0
+    for stage in ("router", "per_expert", "routed_sum", "shared"):
+        if stage == "per_expert":
+            for rec in stages[stage].values():
+                for k in ("gate", "up", "act", "down"):
+                    worst = max(worst, rec[k]["max_abs"])
+        elif stage == "router":
+            worst = max(worst, stages[stage]["logits"]["max_abs"],
+                        stages[stage]["weights"]["max_abs"])
+        else:
+            worst = max(worst, stages[stage]["max_abs"])
+    if stages["router"]["top8_agreement"] != 1.0:
+        failures.append("router top-8 disagreement")
+
+    summary = {
+        "task": "P2-08",
+        "pass": not failures and worst <= T2_MAX_ABS,
+        "device": torch.xpu.get_device_properties(0).name,
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "worst_max_abs": worst,
+        "experts_captured": len(per_expert),
+        "failures": failures,
+        "stages": stages,
+    }
+    out = Path(args.json_out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(summary, indent=2) + "\n")
+    (out.with_suffix(".log")).write_text(
+        "\n".join([
+            f"P2-08 intermediate stages: experts={len(per_expert)} worst={worst:.3e} T2={T2_MAX_ABS}",
+            "  router: " + json.dumps(stages["router"], sort_keys=True),
+            "  routed_sum: " + json.dumps(stages["routed_sum"], sort_keys=True),
+            "  shared: " + json.dumps(stages["shared"], sort_keys=True),
+            f"pass={summary['pass']}",
+        ]) + "\n"
+    )
+    print(f"experts captured: {len(per_expert)}, worst max_abs={worst:.3e}")
+    print(f"pass={summary['pass']} failures={failures}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: tests/test_hybrid_layer.py
--- a/tests/test_hybrid_layer.py	2026-10-21 22:05:50.341775534 +0200
+++ b/tests/test_hybrid_layer.py	2026-10-24 11:00:54.820920874 +0200
@@ -0,0 +1,309 @@
+#!/usr/bin/env python3
+"""P2-09: complete hybrid decoder layer (GDN + EXL3 MoE), end-to-end.
+
+Assembles the real layer-0 ``Qwen3_5DecoderLayer`` (input GemmaRMSNorm → GDN
+linear attention → post-attention GemmaRMSNorm → EXL3 MoE → residual) with the
+pinned checkpoint weights, and validates it stage by stage against independent
+references:
+
+* **attention** — a second, *unquantized* GDN layer on XPU loaded with the EXL3
+  projections dequantized through ``ref.weight_orig`` (same GDN core kernel,
+  plain projections);
+* **norms** — a CPU ``GemmaRMSNorm`` reference (``x*(1+w)``);
+* **MoE** — the CPU fp32 dequantized routed+shared reference from
+  ``tests/_moe_harness.py``;
+* **full layer** — ``residual + MoE(norm2(x + attn(x)))``.
+
+The P0-08 CUDA trace does not exist (documented deviation), so the CPU/dense
+references above are the authority.
+
+    .venv/bin/python tests/test_hybrid_layer.py
+
+Evidence: ``logs/moe-p2/full-layer-eval.{log,json}``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import traceback
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+sys.path.insert(0, str(ROOT / "tests"))
+
+import exl3xpu.vllm_plugin  # noqa: F401,E402  registers "exl3"
+from _moe_harness import Harness, metrics, T2_MAX_ABS, DEFAULT_MODEL  # noqa: E402
+from safetensors import safe_open  # noqa: E402
+
+
+def make_vc(model_dir: Path):
+    from vllm.config import CacheConfig, ModelConfig, ParallelConfig, VllmConfig
+
+    mc = ModelConfig(
+        model=str(model_dir), tokenizer=str(model_dir), dtype="bfloat16",
+        max_model_len=2048, trust_remote_code=True, enforce_eager=True,
+    )
+    return VllmConfig(
+        model_config=mc,
+        cache_config=CacheConfig(block_size=16, gpu_memory_utilization=0.5),
+        parallel_config=ParallelConfig(tensor_parallel_size=1),
+    )
+
+
+def standalone(vc):
+    import os
+    from contextlib import contextmanager
+    from vllm.config import set_current_vllm_config
+    from vllm.distributed import init_distributed_environment, initialize_model_parallel
+
+    os.environ.setdefault("VLLM_TARGET_DEVICE", "xpu")
+    os.environ.setdefault("MASTER_ADDR", "127.0.0.1")
+    os.environ.setdefault("MASTER_PORT", "29621")
+
+    @contextmanager
+    def _ctx():
+        with set_current_vllm_config(vc):
+            init_distributed_environment(world_size=1, rank=0, local_rank=0)
+            initialize_model_parallel(
+                tensor_model_parallel_size=1, pipeline_model_parallel_size=1
+            )
+            yield
+
+    return _ctx()
+
+
+class Ckpt:
+    def __init__(self, model_dir: Path):
+        self.dir = model_dir
+        self.wm = json.loads(
+            (model_dir / "model.safetensors.index.json").read_text()
+        )["weight_map"]
+        self._h: dict[str, object] = {}
+
+    def get(self, key: str) -> torch.Tensor:
+        shard = self.wm[key]
+        if shard not in self._h:
+            self._h[shard] = safe_open(str(self.dir / shard), framework="pt")
+        return self._h[shard].get_tensor(key)
+
+    def has(self, key: str) -> bool:
+        return key in self.wm
+
+    def batch(self, prefix: str):
+        for key in self.wm:
+            if key.startswith(prefix):
+                yield key, self.get(key)
+
+
+def gdn_state(cfg, device):
+    from vllm.model_executor.layers.mamba.mamba_utils import MambaStateShapeCalculator
+
+    conv_shape, ssm_shape = MambaStateShapeCalculator.gated_delta_net_state_shape(
+        tp_world_size=1, num_k_heads=cfg.linear_num_key_heads,
+        num_v_heads=cfg.linear_num_value_heads, head_k_dim=cfg.linear_key_head_dim,
+        head_v_dim=cfg.linear_value_head_dim, conv_kernel_size=cfg.linear_conv_kernel_dim,
+    )
+    conv = torch.zeros((1, *conv_shape), dtype=torch.bfloat16, device=device)
+    ssm = torch.zeros((1, *ssm_shape), dtype=torch.float32, device=device)
+    return conv, ssm
+
+
+def gdn_meta(prefix, num_tokens, device):
+    from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+
+    return GDNAttentionMetadata(
+        num_prefills=1, num_prefill_tokens=num_tokens, num_decodes=0,
+        num_decode_tokens=0, num_spec_decodes=0, num_spec_decode_tokens=0,
+        num_actual_tokens=num_tokens,
+        has_initial_state=torch.tensor([False], dtype=torch.bool, device=device),
+        non_spec_query_start_loc=torch.tensor([0, num_tokens], dtype=torch.int32, device=device),
+        non_spec_state_indices_tensor=torch.tensor([0], dtype=torch.int32, device=device),
+    )
+
+
+def gemma_rmsnorm(x: torch.Tensor, weight: torch.Tensor, eps: float) -> torch.Tensor:
+    var = x.float().pow(2).mean(-1, keepdim=True)
+    return (x.float() * torch.rsqrt(var + eps) * (1.0 + weight.float())).to(x.dtype)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", default=DEFAULT_MODEL)
+    ap.add_argument("--layer", type=int, default=0)
+    ap.add_argument("--log-out", default=str(ROOT / "logs/moe-p2/full-layer-eval.log"))
+    ap.add_argument("--json-out", default=str(ROOT / "logs/moe-p2/full-layer-eval.json"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    model_dir = Path(args.model_dir)
+    ckpt = Ckpt(model_dir)
+    records: list[dict] = []
+    failures: list[dict] = []
+    stages: dict = {}
+
+    exl3_vc = make_vc(model_dir)
+    x = (torch.randn(4, 2048, generator=torch.Generator().manual_seed(1234)) * 0.05)
+    x = x.to(torch.bfloat16).to("xpu")
+
+    # Reference MoE/shared/router (independent of the vLLM config context).
+    h = Harness(model_dir, args.layer)
+
+    try:
+        with standalone(exl3_vc):
+            cfg = exl3_vc.model_config.hf_text_config
+            torch.set_default_dtype(torch.bfloat16)
+
+            from vllm.model_executor.models.qwen3_5 import Qwen3_5DecoderLayer, Qwen3_5Model
+            from vllm.model_executor.models.utils import AutoWeightsLoader, WeightsMapper
+            from vllm.model_executor.model_loader.utils import process_weights_after_loading
+            from vllm.forward_context import set_forward_context
+
+            with torch.device("xpu"):
+                layer = Qwen3_5DecoderLayer(
+                    exl3_vc, "linear_attention", prefix=f"model.layers.{args.layer}"
+                )
+            mapper = (
+                WeightsMapper(orig_to_new_prefix={"model.language_model.": "model."})
+                | Qwen3_5Model.hf_to_vllm_mapper
+            )
+            import torch.nn as nn
+
+            class Wrapper(nn.Module):
+                def __init__(self, layer):
+                    super().__init__()
+                    self.model = nn.Module()
+                    self.model.layers = nn.ModuleList([layer])
+
+            wrapper = Wrapper(layer)
+            prefix = f"model.language_model.layers.{args.layer}."
+            AutoWeightsLoader(wrapper).load_weights(ckpt.batch(prefix), mapper=mapper)
+            process_weights_after_loading(wrapper, exl3_vc.model_config, torch.device("xpu"))
+
+            attn = layer.linear_attn
+            conv, ssm = gdn_state(cfg, "xpu")
+            attn.kv_cache = (conv, ssm)
+            exl3_vc.compilation_config.static_forward_context[attn.prefix] = attn
+
+            caps: dict[str, torch.Tensor] = {}
+
+            def norm_hook(name):
+                # GemmaRMSNorm returns a bare tensor when residual is None and
+                # ``(normed, residual)`` otherwise. Clone: the storage of these
+                # intermediates is recycled by later allocations.
+                def hook(m, i, o):
+                    caps[name] = (o[0] if isinstance(o, tuple) else o).detach().clone()
+                return hook
+
+            layer.input_layernorm.register_forward_hook(norm_hook("norm1"))
+            layer.linear_attn.register_forward_hook(
+                lambda m, i, o: caps.__setitem__("attn", o.detach().clone()))
+            layer.post_attention_layernorm.register_forward_hook(norm_hook("norm2"))
+            layer.mlp.register_forward_hook(
+                lambda m, i, o: caps.__setitem__("moe", o.detach().clone()))
+
+            # ``post_attention_layernorm`` uses fused_add_rms_norm, which
+            # mutates the residual (the input tensor) in place — keep a copy.
+            x_in = x.clone()
+            pos = torch.arange(x.shape[0], device="xpu")
+            meta = gdn_meta(attn.prefix, x.shape[0], "xpu")
+            with set_forward_context(attn_metadata={attn.prefix: meta},
+                                     vllm_config=exl3_vc, num_tokens=x.shape[0]):
+                moe_delta, residual = layer(x, None, pos)
+            torch.xpu.synchronize()
+            final = (residual + moe_delta).detach()
+
+            # -- dense attention reference (clean subprocess) --------------
+            import subprocess
+            import tempfile
+
+            work = Path(tempfile.mkdtemp(prefix="exl3-hybrid-", dir="/tmp/opencode"))
+            np.savez(work / "norm1.npz", x=caps["norm1"].float().cpu().numpy())
+            proc = subprocess.run(
+                [sys.executable, str(ROOT / "tests/_dense_gdn_ref.py"),
+                 "--model-dir", str(model_dir), "--layer", str(args.layer),
+                 "--input", str(work / "norm1.npz"),
+                 "--out", str(work / "attn_ref.npz")],
+                capture_output=True, text=True,
+            )
+            if proc.returncode != 0:
+                raise RuntimeError(
+                    "dense GDN reference failed:\n" + proc.stderr[-3000:]
+                )
+            attn_ref_f = (
+                torch.from_numpy(np.load(work / "attn_ref.npz")["attn"])
+                .float()
+                .to("xpu")
+            )
+            stages["attention_vs_dense"] = metrics(caps["attn"].cpu(), attn_ref_f.cpu())
+
+            # -- norms + MoE reference -------------------------------------
+            eps = cfg.rms_norm_eps
+            p_w = ckpt.get(f"model.language_model.layers.{args.layer}.post_attention_layernorm.weight")
+            # Compose the reference from the layer's actual attention output:
+            # the attention sublayer is validated independently above; this
+            # chain verifies the norms, residual wiring, MoE and final add.
+            residual_ref = x_in + caps["attn"]
+            norm2_ref = gemma_rmsnorm(residual_ref, p_w.to("xpu"), eps)
+            stages["norm2"] = metrics(caps["norm2"].cpu(), norm2_ref.cpu())
+
+            _, ids, w = h.router(norm2_ref)
+            moe_ref = (h.free_routing_reference(norm2_ref.cpu(), ids.cpu(), w.cpu())
+                       + h.shared(norm2_ref).cpu())
+            stages["moe"] = metrics(caps["moe"].cpu(), moe_ref)
+            out_ref = residual_ref.cpu().float() + moe_ref
+            stages["full_layer"] = metrics(final.cpu(), out_ref)
+
+            worst = max(v["max_abs"] for v in stages.values())
+            ok = worst <= T2_MAX_ABS and all(
+                v["nan_inf"] == 0 for v in stages.values()
+            )
+            stages["worst_max_abs"] = worst
+            stages["pass"] = ok
+            if not ok:
+                failures.append({"stage": "full_layer", "worst": worst})
+            print("stage max_abs:", {
+                k: (round(v["max_abs"], 8) if isinstance(v, dict) else v)
+                for k, v in stages.items()
+            })
+    except Exception as exc:  # noqa: BLE001
+        failures.append({"error": repr(exc)[:500]})
+        if args.verbose:
+            traceback.print_exc()
+        print(f"FAIL: {exc}")
+
+    summary = {
+        "task": "P2-09",
+        "pass": not failures and stages.get("pass", False),
+        "device": torch.xpu.get_device_properties(0).name,
+        "tolerance": {"T2_max_abs": T2_MAX_ABS},
+        "layer": args.layer,
+        "note": (
+            "P0-08 has no CUDA trace (documented deviation); references are a "
+            "dequantized dense GDN layer on XPU, a CPU GemmaRMSNorm, and the "
+            "CPU fp32 dequantized MoE."
+        ),
+        "stages": stages,
+        "failures": failures,
+    }
+    out = Path(args.json_out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(summary, indent=2) + "\n")
+    (out.with_suffix(".log")).write_text(
+        "\n".join([f"P2-09 hybrid layer {args.layer} T2={T2_MAX_ABS}"]
+                  + [f"  {k}: {json.dumps(v, sort_keys=True)}"
+                     for k, v in stages.items() if isinstance(v, dict)]
+                  + [f"pass={summary['pass']} failures={failures}"]) + "\n"
+    )
+    print(f"pass={summary['pass']} failures={failures}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

## file: scripts/run_phase2_tests.py
--- a/scripts/run_phase2_tests.py	2026-10-21 22:05:50.341775534 +0200
+++ b/scripts/run_phase2_tests.py	2026-10-24 11:01:42.346719322 +0200
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""P2-10: standardized Phase 2 test runner.
+
+Runs every Phase 2 suite in a subprocess, records wall time, pass/fail, case
+counts and the worst absolute deviation reported by each suite, and writes
+``logs/moe-p2/phase2-summary.json``.
+
+    .venv/bin/python scripts/run_phase2_tests.py
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# (label, script, json artifact it writes)
+SUITES = [
+    ("P2-01/04/07 MoE block", "tests/test_moe_block.py",
+     "logs/moe-p2/moe-block-eval.json"),
+    ("P2-02/03/06 routing + edge cases", "tests/test_moe_routing.py",
+     "logs/moe-p2/routing-eval.json"),
+    ("P2-05a fixed routing", "tests/test_fixed_routing.py",
+     "logs/moe-p2/fixed-routing.json"),
+    ("P2-05b free routing", "tests/test_free_routing.py",
+     "logs/moe-p2/free-routing.json"),
+    ("P2-08 intermediate stages", "tests/test_intermediate_probe.py",
+     "logs/moe-p2/intermediate-stage-validation.json"),
+    ("P2-09 hybrid decoder layer", "tests/test_hybrid_layer.py",
+     "logs/moe-p2/full-layer-eval.json"),
+]
+
+
+def collect_metrics(path: Path) -> dict:
+    if not path.is_file():
+        return {"available": False}
+    data = json.loads(path.read_text())
+    worst = None
+    n_cases = 0
+
+    def walk(obj):
+        nonlocal worst, n_cases
+        if isinstance(obj, dict):
+            if isinstance(obj.get("max_abs"), (int, float)):
+                worst = obj["max_abs"] if worst is None else max(worst, obj["max_abs"])
+            if "case" in obj and "pass" in obj:
+                n_cases += 1
+            for v in obj.values():
+                walk(v)
+        elif isinstance(obj, list):
+            for v in obj:
+                walk(v)
+
+    walk(data)
+    return {
+        "available": True,
+        "task": data.get("task"),
+        "pass": data.get("pass"),
+        "worst_max_abs": worst,
+        "case_records": n_cases,
+    }
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", default=str(ROOT / "logs/moe-p2/phase2-summary.json"))
+    ap.add_argument("--only", nargs="*", default=None,
+                    help="substring filter on suite labels")
+    args = ap.parse_args()
+
+    results = []
+    t_all = time.perf_counter()
+    for label, script, artifact in SUITES:
+        if args.only and not any(s in label for s in args.only):
+            continue
+        t0 = time.perf_counter()
+        proc = subprocess.run(
+            [sys.executable, str(ROOT / script)],
+            cwd=ROOT, capture_output=True, text=True,
+        )
+        seconds = time.perf_counter() - t0
+        metrics = collect_metrics(ROOT / artifact)
+        rec = {
+            "suite": label,
+            "script": script,
+            "artifact": artifact,
+            "exit_code": proc.returncode,
+            "seconds": round(seconds, 2),
+            "pass": proc.returncode == 0 and metrics.get("pass") is not False,
+            **metrics,
+        }
+        if proc.returncode != 0:
+            rec["stderr_tail"] = proc.stderr[-1500:]
+        results.append(rec)
+        print(f"{'PASS' if rec['pass'] else 'FAIL'}  {seconds:7.2f}s  {label}")
+
+    summary = {
+        "task": "P2-10",
+        "pass": all(r["pass"] for r in results),
+        "suites_run": len(results),
+        "total_seconds": round(time.perf_counter() - t_all, 2),
+        "worst_max_abs": max(
+            (r["worst_max_abs"] for r in results
+             if isinstance(r.get("worst_max_abs"), (int, float))),
+            default=None,
+        ),
+        "tolerance_T2_max_abs": 0.08,
+        "results": results,
+    }
+    out = Path(args.out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(summary, indent=2) + "\n")
+    print(f"\npass={summary['pass']} worst_max_abs={summary['worst_max_abs']} "
+          f"total={summary['total_seconds']}s")
+    print(f"wrote {out}")
+    return 0 if summary["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

