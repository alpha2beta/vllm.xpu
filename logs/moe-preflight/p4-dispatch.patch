+"""EXL3 routed-expert quantization method (Phase 1: dispatch + expert loading).
+
+Why this file exists
+--------------------
+``Exl3Config.get_quant_method`` used to return ``None`` for
+``RoutedExperts``.  vLLM turns ``None`` into
+``UnquantizedFusedMoEMethod`` (``routed_experts.py:219-220``), which allocates
+256 x (2 x 2048x512 + 512x2048) fp16 experts per layer -- ~64 GiB for this
+model -- before failing on the missing ``.weight`` tensors.  The project rule
+is fail-closed, so this module registers a real ``FusedMoEMethodBase`` that
+either serves the layer or raises.
+
+Stage boundary
+--------------
+P1-01 wired dispatch.  P1-02 registers one compressed allocation per tensor
+kind per layer (trellis / suh / svh / codebook scalars, no fp16 expert weights)
+and loads them through a purpose-built expert loader.  P1-03 packs int64
+per-expert descriptors, and P1-04 adds ``verify_expert_integrity`` (stride/
+offset tiling, no metadata aliasing, tile-not-dense trellis).  P1-05 streams
+shards; Phase 2 adds the eager routed-expert ``apply`` (per-expert grouping,
+weighted scatter-accumulate) and an optional intermediate-capture hook.  There
+is no unquantized or Triton-backed expert path to fall back to.
+
+Why a custom ``load_weights``
+-----------------------------
+``RoutedExperts.load_weights`` decides "fused checkpoint tensor" with
+``loaded_weight.dim() == 3`` and then chunks along dim 1 for ``w1``/``w3``.
+EXL3 trellis tensors are *also* 3-D (``[k/16, n/16, 16K]`` per expert), so the
+stock loader would split one expert's trellis into 64 fake experts.  The
+method therefore binds a per-layer loader that parses
+``<expert>.<proj>.<trellis|suh|svh|codebook>`` explicitly and copies each
+tensor into ``[expert, slot]``.  See ``docs/moe_api_audit.md`` §3.2.
+"""
+
+from __future__ import annotations
+
+import math
+import types
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, Iterable, Iterator
+
+import torch
+from torch.nn import Parameter
+
+from vllm.model_executor.layers.fused_moe.config import (
+    FusedMoEConfig,
+    FusedMoEQuantConfig,
+)
+from vllm.model_executor.layers.fused_moe.fused_moe_method_base import (
+    FusedMoEMethodBase,
+)
+
+if TYPE_CHECKING:  # pragma: no cover - typing only
+    from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
+
+    from .vllm_plugin import Exl3Config
+
+#: EXL3 codebook name -> numeric id used by the kernels and the checkpoint.
+CODEBOOK_IDS = {"3inst": 0, "mcg": 1, "mul1": 2}
+
+#: Projections every routed expert must provide in this checkpoint schema.
+CHECKPOINT_PROJECTIONS = ("gate_proj", "up_proj", "down_proj")
+
+
+class Exl3MoEUnsupported(NotImplementedError):
+    """The MoE layer cannot be served by EXL3.
+
+    Deliberately an exception rather than a ``None`` return: ``None`` makes
+    vLLM silently construct ``UnquantizedFusedMoEMethod`` (~64 GiB of fp16
+    experts).  Callers may catch this to produce a richer error, but must not
+    downgrade it to an unquantized path.
+    """
+
+
+#: Level Zero per-allocation ceiling from the P1-02 plan. Every registered
+#: expert tensor must stay below this *and* the per-layer total must too.
+MAX_ALLOCATION_BYTES = 4 * 1024**3
+
+#: MoE shard id -> fused slot index inside w13 (w2 has a single slot).
+_SHARD_SLOT = {"w1": 0, "w3": 1, "w2": 0}
+
+#: Canonical projection order used by the packed expert descriptors.
+_PROJ_ORDER = ("gate_proj", "up_proj", "down_proj")
+_PROJ_SHARDS = ("w1", "w3", "w2")
+
+#: Fields of one descriptor row (int64), indexed by
+#: ``layer.exl3_moe_descriptors[expert, projection, field]``.
+#: ``*_tensor`` indexes ``layer.exl3_moe_tensor_names``; ``*_offset`` is an
+#: element offset into that allocation. -1 marks an absent tensor (3inst has no
+#: codebook scalar).
+DESCRIPTOR_FIELDS = (
+    "trellis_tensor",
+    "trellis_offset",
+    "suh_tensor",
+    "suh_offset",
+    "svh_tensor",
+    "svh_offset",
+    "codebook_tensor",
+    "codebook_offset",
+    "k",
+    "n",
+    "K",
+    "cb",
+    "family",
+    "slot",
+)
+
+#: family id used in descriptor rows.
+_FAMILY_ID = {"w13": 0, "w2": 1}
+
+
+def _s32(value: int) -> int:
+    """Interpret an unsigned 32-bit constant as a signed int32 (checkpoint form)."""
+    return value - (1 << 32) if value >= (1 << 31) else value
+
+
+#: Value stored in the per-expert codebook scalar. The tensor's *presence*
+#: selects the codebook; its value is the codebook multiplier, so a mismatch
+#: means the checkpoint is not what the config claims.
+CODEBOOK_MULTIPLIERS = {
+    "mcg": _s32(0xCBAC1FED),
+    "mul1": _s32(0x83DCD12D),
+}
+
+
+def _trellis_shape(k: int, n: int, K: int) -> tuple[int, int, int]:
+    return (k // 16, n // 16, 16 * K)
+
+
+@dataclass(frozen=True)
+class ExpertTensorSpec:
+    """One per-layer stacked expert tensor (all experts share the layout)."""
+
+    name: str  # parameter name on RoutedExperts, e.g. "w13_trellis"
+    tensor: str  # checkpoint suffix: trellis | suh | svh | <codebook>
+    slots: int  # 2 for w13 (gate+up), 1 for w2 (down)
+    shape: tuple[int, ...]
+    dtype: torch.dtype
+
+    @property
+    def nbytes(self) -> int:
+        return math.prod(self.shape) * self.dtype.itemsize
+
+
+class Exl3ExpertStore:
+    """Shape/dtype/budget plan for one layer's compressed expert tensors.
+
+    All experts of a layer live in one allocation per tensor kind (eight
+    allocations per layer for the mcg checkpoint). At 3.09 bpw that is
+    ~192 MiB for ``w13_trellis`` and ~96 MiB for ``w2_trellis``, so each
+    allocation and the per-layer total stay far below
+    ``MAX_ALLOCATION_BYTES``.
+    """
+
+    def __init__(
+        self,
+        num_experts: int,
+        hidden_size: int,
+        intermediate_size: int,
+        K: int,
+        codebook: str,
+    ):
+        if num_experts <= 0:
+            raise Exl3MoEUnsupported(f"exl3: MoE: bad expert count {num_experts}")
+        for label, dim in (
+            ("hidden_size", hidden_size),
+            ("intermediate_size", intermediate_size),
+        ):
+            if dim % 128 != 0:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE: {label}={dim} must be a multiple of 128 "
+                    "(trellis tile / grouped-GEMV requirement)"
+                )
+        self.num_experts = num_experts
+        self.hidden_size = hidden_size
+        self.intermediate_size = intermediate_size
+        self.K = K
+        self.codebook = codebook
+
+        def spec(name, tensor, slots, shape, dtype):
+            return ExpertTensorSpec(name, tensor, slots, tuple(shape), dtype)
+
+        specs = [
+            spec(
+                "w13_trellis", "trellis", 2,
+                (num_experts, 2, *_trellis_shape(hidden_size, intermediate_size, K)),
+                torch.int16,
+            ),
+            spec("w13_suh", "suh", 2, (num_experts, 2, hidden_size), torch.float16),
+            spec("w13_svh", "svh", 2, (num_experts, 2, intermediate_size), torch.float16),
+            spec(
+                "w2_trellis", "trellis", 1,
+                (num_experts, 1, *_trellis_shape(intermediate_size, hidden_size, K)),
+                torch.int16,
+            ),
+            spec("w2_suh", "suh", 1, (num_experts, 1, intermediate_size), torch.float16),
+            spec("w2_svh", "svh", 1, (num_experts, 1, hidden_size), torch.float16),
+        ]
+        if codebook != "3inst":
+            specs += [
+                spec(f"w13_{codebook}", codebook, 2, (num_experts, 2), torch.int32),
+                spec(f"w2_{codebook}", codebook, 1, (num_experts, 1), torch.int32),
+            ]
+        self.specs: tuple[ExpertTensorSpec, ...] = tuple(specs)
+        self.total_bytes = sum(s.nbytes for s in self.specs)
+
+        oversized = [s for s in self.specs if s.nbytes >= MAX_ALLOCATION_BYTES]
+        if oversized:
+            raise Exl3MoEUnsupported(
+                "exl3: MoE: single-allocation limit exceeded: "
+                + ", ".join(
+                    f"{s.name}={s.nbytes / 2**30:.2f} GiB" for s in oversized
+                )
+                + f" (limit {MAX_ALLOCATION_BYTES / 2**30:.0f} GiB)"
+            )
+        if self.total_bytes >= MAX_ALLOCATION_BYTES:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE: per-layer expert buffers total "
+                f"{self.total_bytes / 2**30:.2f} GiB >= "
+                f"{MAX_ALLOCATION_BYTES / 2**30:.0f} GiB"
+            )
+
+    def get(self, name: str) -> ExpertTensorSpec:
+        for s in self.specs:
+            if s.name == name:
+                return s
+        raise KeyError(name)
+
+    def meta(self) -> dict[str, Any]:
+        return {
+            "num_experts": self.num_experts,
+            "hidden_size": self.hidden_size,
+            "intermediate_size": self.intermediate_size,
+            "K": self.K,
+            "total_bytes": self.total_bytes,
+            "max_allocation_bytes": MAX_ALLOCATION_BYTES,
+            "tensors": {
+                s.name: {
+                    "shape": list(s.shape),
+                    "dtype": str(s.dtype).removeprefix("torch."),
+                    "bytes": s.nbytes,
+                }
+                for s in self.specs
+            },
+        }
+
+
+class Exl3MoEMethod(FusedMoEMethodBase):
+    """Quantization method for EXL3-compressed routed experts.
+
+    Holds the per-layer format contract (K, codebook, expert count), registers
+    the compressed expert tensors in :meth:`create_weights`, loads them
+    through the per-layer expert loader described in the module docstring, and
+    verifies packed-arena integrity in :meth:`verify_expert_integrity`.
+    Execution (:meth:`apply`) is P1-05+.
+    """
+
+    def __init__(self, config: "Exl3Config", layer: "RoutedExperts", prefix: str):
+        moe: FusedMoEConfig = layer.moe_config
+        super().__init__(moe)
+
+        self.config = config
+        self.prefix = prefix
+        # Checkpoint storage keys are normalized ("layers.0..."), while vLLM
+        # passes the model-qualified prefix ("model.language_model.layers.0...").
+        from .vllm_plugin import _norm_key
+        self.key_prefix = _norm_key(prefix)
+        self.num_local_experts = int(moe.num_local_experts)
+        self.hidden_size = int(moe.hidden_dim)
+        self.intermediate_size_per_partition = int(moe.intermediate_size_per_partition)
+
+        self._validate_parallel(moe)
+
+        codebook = config.codebook
+        if codebook not in CODEBOOK_IDS:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {prefix}: unknown codebook {codebook!r}; "
+                f"expected one of {sorted(CODEBOOK_IDS)}"
+            )
+        self.cb = CODEBOOK_IDS[codebook]
+
+        # Raises if the checkpoint has no / inconsistent / unsupported expert
+        # format for this layer.  Resolved before the constructor returns so a
+        # bad checkpoint fails at model construction, not at first token.
+        self.K = self._resolve_expert_K(layer)
+        self._check_kernel_support()
+
+        # Reused read-only ``shard_of_nb`` buffers (one per (device, n)).
+        self._nb_cache: dict[tuple[torch.device, int], torch.Tensor] = {}
+        # P4-01 zero-copy execution cache (built lazily from the arenas).
+        self._exec_cache: dict[str, Any] | None = None
+        # Optional P2-08 diagnostic capture (None = disabled, zero overhead).
+        self._debug_capture: dict[str, Any] | None = None
+
+    # -- validation ---------------------------------------------------------
+
+    @staticmethod
+    def _validate_parallel(moe: FusedMoEConfig) -> None:
+        pc = moe.moe_parallel_config
+        if pc.tp_size > 1 or pc.ep_size > 1 or getattr(pc, "use_ep", False):
+            raise Exl3MoEUnsupported(
+                "exl3: MoE tensor/expert parallelism is not supported "
+                f"(tp_size={pc.tp_size}, ep_size={pc.ep_size}, use_ep={pc.use_ep}); "
+                "run with TP=1 and EP off"
+            )
+
+    def _checkpoint_projection_names(self, layer: "RoutedExperts") -> tuple[str, str, str]:
+        """Checkpoint-side projection names for gate/up/down.
+
+        ``RoutedExperts`` stores the ckpt names it was built with; defaults
+        match the EXL3 Qwen3.5 checkpoint.  Ordering is gate, up, down.
+        """
+        return (
+            getattr(layer, "ckpt_gate_proj_name", CHECKPOINT_PROJECTIONS[0]),
+            getattr(layer, "ckpt_up_proj_name", CHECKPOINT_PROJECTIONS[1]),
+            getattr(layer, "ckpt_down_proj_name", CHECKPOINT_PROJECTIONS[2]),
+        )
+
+    def _resolve_expert_K(self, layer: "RoutedExperts") -> int:
+        """Validate the checkpoint schema and return the routed trellis K."""
+        storage = self.config.storage
+        if not storage:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: checkpoint storage map is empty, so the "
+                "routed-expert format cannot be resolved (was "
+                "Exl3Config.maybe_update_config called?)"
+            )
+
+        prefix = self.key_prefix + "."
+        entries = {k: v for k, v in storage.items() if k.startswith(prefix)}
+        if not entries:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: no EXL3 expert tensors found for this "
+                "layer (partially-quantized or unquantized MoE is not supported)"
+            )
+
+        proj_names = set(self._checkpoint_projection_names(layer))
+        by_expert: dict[int, dict[str, int]] = {}
+        for key, bits in entries.items():
+            rest = key[len(prefix):].split(".")
+            if len(rest) != 2 or not rest[0].isdigit():
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected expert tensor name {key!r}"
+                )
+            expert_id, proj = int(rest[0]), rest[1]
+            if proj not in proj_names:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected projection {proj!r} in {key!r}"
+                )
+            info = self.config.member_trellis.get(key)
+            K = int(info[1]) if info is not None else int(bits)
+            by_expert.setdefault(expert_id, {})[proj] = K
+
+        # Completeness: an expert missing a projection would load partially and
+        # silently produce garbage, so reject the layer up front.
+        for expert_id, projs in sorted(by_expert.items()):
+            missing = proj_names - projs.keys()
+            if missing:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: expert {expert_id} is missing "
+                    f"quantized projections {sorted(missing)}"
+                )
+
+        if len(by_expert) != self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: checkpoint has {len(by_expert)} experts, "
+                f"layer expects {self.num_local_experts}"
+            )
+
+        Ks = {K for projs in by_expert.values() for K in projs.values()}
+        if len(Ks) != 1:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: mixed trellis K across experts: {sorted(Ks)}"
+            )
+        return Ks.pop()
+
+    def _check_kernel_support(self) -> None:
+        """Fail closed unless the built extension has a kernel for (K, cb)."""
+        from . import ops
+
+        try:
+            esimd = ops._get_esimd()
+        except RuntimeError as exc:  # library missing / ABI mismatch
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: ESIMD op library is not loadable and "
+                "routed experts have no Triton fallback"
+            ) from exc
+        if not esimd or not hasattr(esimd, "exl3_supported"):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: ESIMD op library is not available "
+                "(EXL3_BACKEND=triton disables it) and routed experts have no "
+                "fallback"
+            )
+        if not bool(esimd.exl3_supported(self.K, self.cb)):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: no ESIMD kernel for K={self.K}, "
+                f"codebook={self.config.codebook!r} (cb={self.cb}); rebuild with "
+                "-DEXL3_ALL_CODEBOOKS or use a supported bitrate"
+            )
+
+    # -- FusedMoEMethodBase contract ---------------------------------------
+
+    def create_weights(
+        self,
+        layer: "RoutedExperts",
+        num_experts: int,
+        hidden_size: int,
+        intermediate_size_per_partition: int,
+        params_dtype: torch.dtype,
+        **extra_weight_attrs: Any,
+    ) -> None:
+        """Register the compressed expert tensors for one layer.
+
+        Exactly one allocation per tensor kind:
+        ``w13_trellis[E,2,k/16,n/16,16K]``, ``w13_suh[E,2,k]``,
+        ``w13_svh[E,2,n]``, ``w2_trellis[E,1,n/16,k/16,16K]``, ``w2_suh``,
+        ``w2_svh`` and (for ``mcg``/``mul1``) one scalar ``int32`` per expert
+        and slot.  There is no fp16 copy of any expert matrix.
+        """
+        if int(num_experts) != self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: create_weights got num_experts="
+                f"{num_experts}, method was built for {self.num_local_experts}"
+            )
+        if int(hidden_size) != self.hidden_size:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: create_weights got hidden_size="
+                f"{hidden_size}, method was built for {self.hidden_size}"
+            )
+        if int(intermediate_size_per_partition) != self.intermediate_size_per_partition:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: create_weights got "
+                f"intermediate_size_per_partition={intermediate_size_per_partition}, "
+                f"method was built for {self.intermediate_size_per_partition}"
+            )
+
+        store = Exl3ExpertStore(
+            num_experts=self.num_local_experts,
+            hidden_size=self.hidden_size,
+            intermediate_size=self.intermediate_size_per_partition,
+            K=self.K,
+            codebook=self.config.codebook,
+        )
+        self.store = store
+        self._loaded: set[tuple[str, int, int]] = set()
+        self._load_attempted = False
+
+        for spec in store.specs:
+            # Allocate on the active device: vLLM constructs the model inside
+            # `with torch.device(target_device)` (base_loader.py:67).
+            param = Parameter(
+                torch.empty(spec.shape, dtype=spec.dtype), requires_grad=False
+            )
+            param.weight_loader = self._make_weight_loader(spec)
+            param.exl3_spec = spec
+            layer.register_parameter(spec.name, param)
+
+        tensor_names = [s.name for s in store.specs]
+        layer.exl3_moe_tensor_names = tensor_names
+        descriptors = self._build_descriptors(layer, tensor_names)
+        # Non-persistent: moves with the module, absent from state_dict, and
+        # skipped by the dummy loader.
+        layer.register_buffer(
+            "exl3_moe_descriptors", descriptors, persistent=False
+        )
+
+        meta = store.meta()
+        meta.update(
+            {
+                "prefix": self.key_prefix,
+                "codebook": self.config.codebook,
+                "codebook_id": self.cb,
+                "allocations": len(store.specs),
+                "tensor_order": tensor_names,
+                "descriptor_fields": list(DESCRIPTOR_FIELDS),
+                "descriptor_shape": list(descriptors.shape),
+            }
+        )
+        layer.exl3_moe_meta = meta
+
+        # Replace the generic expert loader (see module docstring): trellis
+        # tensors are 3-D and would otherwise be treated as fused w13 tensors.
+        layer.load_weights = types.MethodType(self._layer_load_weights, layer)
+
+    # -- expert weight loading ---------------------------------------------
+
+    def _make_weight_loader(self, spec: ExpertTensorSpec):
+        """Per-parameter loader used by the per-layer expert loader.
+
+        Signature mirrors vLLM's ``weight_loader`` protocol; ``return_success``
+        is honoured so the stock mapping bookkeeping keeps working.
+        """
+
+        def weight_loader(
+            param: Parameter,
+            loaded_weight: torch.Tensor,
+            weight_name: str = "",
+            shard_id: str | None = None,
+            expert_id: int | None = None,
+            return_success: bool = False,
+            **_: Any,
+        ):
+            self._copy_expert_tensor(
+                spec, param, loaded_weight, shard_id, expert_id, weight_name
+            )
+            return True if return_success else None
+
+        return weight_loader
+
+    def _copy_expert_tensor(
+        self,
+        spec: ExpertTensorSpec,
+        param: Parameter,
+        loaded_weight: torch.Tensor,
+        shard_id: str | None,
+        expert_id: int | None,
+        weight_name: str,
+    ) -> None:
+        if shard_id not in _SHARD_SLOT:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {spec.name} got unknown shard_id "
+                f"{shard_id!r} (expected one of {sorted(_SHARD_SLOT)}) for "
+                f"{weight_name!r}"
+            )
+        if spec.name.startswith("w13_") != (shard_id in ("w1", "w3")):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: shard_id {shard_id!r} does not match "
+                f"parameter {spec.name!r}"
+            )
+        if expert_id is None or not isinstance(expert_id, int):
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {spec.name} requires an integer "
+                f"expert_id, got {expert_id!r} for {weight_name!r}"
+            )
+        if not 0 <= expert_id < self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: expert_id {expert_id} out of range "
+                f"for {spec.name} ({self.num_local_experts} experts)"
+            )
+
+        slot = _SHARD_SLOT[shard_id]
+        expected = spec.shape[2:]
+        if tuple(loaded_weight.shape) != expected:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {weight_name!r} has shape "
+                f"{tuple(loaded_weight.shape)}, expected {expected} for "
+                f"{spec.name} (expert {expert_id}, slot {slot})"
+            )
+        if loaded_weight.dtype != spec.dtype:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {weight_name!r} has dtype "
+                f"{loaded_weight.dtype}, expected {spec.dtype} for {spec.name}"
+            )
+
+        param.data[expert_id, slot].copy_(loaded_weight)
+        self._loaded.add((spec.name, expert_id, slot))
+
+    def _layer_load_weights(
+        self, layer: "RoutedExperts", weights: Iterable[tuple[str, torch.Tensor]]
+    ) -> Iterator[str]:
+        """Layer-bound replacement for ``RoutedExperts.load_weights``.
+
+        Consumes names relative to the ``RoutedExperts`` module (the form
+        ``AutoWeightsLoader`` passes after stripping the child prefix), e.g.
+        ``"0.gate_proj.trellis"``.
+
+        Kept as a plain function returning a generator so the "a real load was
+        attempted" flag is set eagerly, even if a caller forgets to iterate.
+        """
+        self._load_attempted = True
+        return self._iter_layer_weights(layer, weights)
+
+    def _iter_layer_weights(
+        self, layer: "RoutedExperts", weights: Iterable[tuple[str, torch.Tensor]]
+    ) -> Iterator[str]:
+        gate, up, down = self._checkpoint_projection_names(layer)
+        shard_of_proj = {gate: "w1", up: "w3", down: "w2"}
+
+        for name, loaded_weight in weights:
+            parts = name.split(".")
+            if len(parts) != 3 or not parts[0].isdigit():
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected routed-expert tensor "
+                    f"{name!r} (expected '<expert>.<projection>.<suffix>')"
+                )
+            expert_id, proj, suffix = int(parts[0]), parts[1], parts[2]
+            shard_id = shard_of_proj.get(proj)
+            if shard_id is None:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected projection {proj!r} in "
+                    f"{name!r} (expected one of {sorted(shard_of_proj)})"
+                )
+            family = "w13" if shard_id in ("w1", "w3") else "w2"
+            param_name = f"{family}_{suffix}"
+            try:
+                spec = self.store.get(param_name)
+            except KeyError:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: unexpected tensor suffix {suffix!r} "
+                    f"in {name!r}; expected "
+                    f"{sorted(s.tensor for s in self.store.specs)}"
+                ) from None
+            param = getattr(layer, param_name)
+            param.weight_loader(
+                param=param,
+                loaded_weight=loaded_weight,
+                weight_name=name,
+                shard_id=shard_id,
+                expert_id=expert_id,
+                return_success=True,
+            )
+            yield param_name
+
+    # -- packed expert descriptors (P1-03) ----------------------------------
+
+    def _build_descriptors(
+        self, layer: "RoutedExperts", tensor_names: list[str]
+    ) -> torch.Tensor:
+        """Build ``[E, 3, len(DESCRIPTOR_FIELDS)]`` int64 descriptor rows.
+
+        Rows are derived from the allocation plan only (no data), so every
+        expert/projection resolves to an explicit ``(allocation, element
+        offset, slot, k, n, K, cb)`` rather than an implicit concatenation.
+        """
+        index = {name: i for i, name in enumerate(tensor_names)}
+        rows: list[list[int]] = []
+        for expert_id in range(self.num_local_experts):
+            for proj_index, shard_id in enumerate(_PROJ_SHARDS):
+                family = "w13" if shard_id in ("w1", "w3") else "w2"
+                slot = _SHARD_SLOT[shard_id]
+                trellis = self.store.get(f"{family}_trellis")
+                suh = self.store.get(f"{family}_suh")
+                svh = self.store.get(f"{family}_svh")
+                if self.config.codebook == "3inst":
+                    cb_spec = None
+                else:
+                    cb_spec = self.store.get(f"{family}_{self.config.codebook}")
+
+                def offset(spec: ExpertTensorSpec) -> int:
+                    per_expert = math.prod(spec.shape[2:])
+                    return (expert_id * spec.slots + slot) * per_expert
+
+                # NOTE: projection identity follows _PROJ_ORDER/_PROJ_SHARDS;
+                # custom checkpoint projection names are resolved by the loader
+                # (``_checkpoint_projection_names``), not here.
+                if shard_id in ("w1", "w3"):
+                    k, n = self.hidden_size, self.intermediate_size_per_partition
+                else:
+                    k, n = self.intermediate_size_per_partition, self.hidden_size
+
+                rows.append(
+                    [
+                        index[trellis.name],
+                        offset(trellis),
+                        index[suh.name],
+                        offset(suh),
+                        index[svh.name],
+                        offset(svh),
+                        index[cb_spec.name] if cb_spec is not None else -1,
+                        offset(cb_spec) if cb_spec is not None else -1,
+                        k,
+                        n,
+                        self.K,
+                        self.cb,
+                        _FAMILY_ID[family],
+                        slot,
+                    ]
+                )
+        device = getattr(layer, tensor_names[0]).device
+        return torch.tensor(rows, dtype=torch.int64, device=device).reshape(
+            self.num_local_experts, len(_PROJ_ORDER), len(DESCRIPTOR_FIELDS)
+        )
+
+    def descriptor(self, layer: "RoutedExperts", expert_id: int, projection: str) -> dict[str, int]:
+        """One descriptor row as a named dict (raises on bad ids)."""
+        if projection not in _PROJ_ORDER:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: unknown projection {projection!r}"
+            )
+        if not 0 <= expert_id < self.num_local_experts:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: expert_id {expert_id} out of range"
+            )
+        row = layer.exl3_moe_descriptors[
+            expert_id, _PROJ_ORDER.index(projection)
+        ].tolist()
+        return dict(zip(DESCRIPTOR_FIELDS, row))
+
+    def expert_views(
+        self, layer: "RoutedExperts", expert_id: int
+    ) -> dict[str, dict[str, torch.Tensor | None]]:
+        """Actual parameter views for one expert, one dict per projection.
+
+        This is the P1-03/P1-04 bridge: consumers never index the stacked
+        allocation by hand, and tests can compare views against the descriptor
+        offsets.
+        """
+        out: dict[str, dict[str, torch.Tensor | None]] = {}
+        for projection in _PROJ_ORDER:
+            row = self.descriptor(layer, expert_id, projection)
+            shard_id = _PROJ_SHARDS[_PROJ_ORDER.index(projection)]
+            family = "w13" if shard_id in ("w1", "w3") else "w2"
+            slot = row["slot"]
+            codebook = None
+            if row["codebook_tensor"] >= 0:
+                cb_name = layer.exl3_moe_tensor_names[row["codebook_tensor"]]
+                codebook = getattr(layer, cb_name)[expert_id, slot]
+            out[projection] = {
+                "trellis": getattr(layer, f"{family}_trellis")[expert_id, slot],
+                "suh": getattr(layer, f"{family}_suh")[expert_id, slot],
+                "svh": getattr(layer, f"{family}_svh")[expert_id, slot],
+                "codebook": codebook,
+                "k": row["k"],
+                "n": row["n"],
+                "K": row["K"],
+                "cb": row["cb"],
+            }
+        return out
+
+    # -- integrity verification (P1-04) -------------------------------------
+
+    def verify_expert_integrity(self, layer: "RoutedExperts") -> dict[str, Any]:
+        """Assert the packed arenas keep per-expert metadata intact (P1-04).
+
+        Structural only (no checkpoint values), so it is safe for
+        ``--load-format dummy`` too:
+
+        * each tensor kind owns a distinct allocation;
+        * every ``(expert, slot)`` slice owns distinct storage, so ``suh``/``svh``
+          scales and Hadamard vectors are never shared between experts or
+          between gate and up;
+        * registered parameter shapes match the plan (tiled, not dense);
+        * the ``[E, slots, ...]`` arena is exactly tiled by the descriptor
+          offsets ``(expert*slots + slot) * per_expert``, so codes are always
+          addressed through explicit stride/offset tracking;
+        * trellis uses the tile layout ``[k/16, n/16, 16K]`` (``w2`` is
+          ``[n/16, k/16, 16K]``), never a dense ``[k, n]`` row store;
+        * ``suh``/``svh`` lengths equal ``k``/``n`` and codebook entries carry
+          the expected multiplier.
+
+        Returns a small summary (used in evidence) and raises
+        :class:`Exl3MoEUnsupported` on any violation.
+        """
+        names = list(getattr(layer, "exl3_moe_tensor_names", []))
+        if names != [s.name for s in self.store.specs]:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: expert tensor order {names} does not "
+                "match the allocation plan"
+            )
+
+        descriptors = getattr(layer, "exl3_moe_descriptors", None)
+        expected_shape = (
+            self.num_local_experts,
+            len(_PROJ_ORDER),
+            len(DESCRIPTOR_FIELDS),
+        )
+        if descriptors is None or tuple(descriptors.shape) != expected_shape:
+            got = None if descriptors is None else tuple(descriptors.shape)
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: descriptor shape {got} != {expected_shape}"
+            )
+        if descriptors.dtype != torch.int64:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: descriptor dtype {descriptors.dtype} "
+                "!= int64"
+            )
+
+        # 1. A distinct allocation per tensor kind.
+        owners: dict[int, str] = {}
+        for name in names:
+            ptr = getattr(layer, name).data_ptr()
+            if ptr in owners:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: {name} aliases the allocation of "
+                    f"{owners[ptr]}"
+                )
+            owners[ptr] = name
+
+        # 2. Registered shapes match the plan; every (expert, slot) slice owns
+        #    distinct storage and the arena is exactly tiled.
+        for spec in self.store.specs:
+            param = getattr(layer, spec.name)
+            if tuple(param.shape) != spec.shape:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: {spec.name} has shape "
+                    f"{tuple(param.shape)}, expected tiled {spec.shape} (codes must "
+                    "not be stored as concatenated dense rows)"
+                )
+            per = math.prod(spec.shape[2:])
+            if param.numel() != self.num_local_experts * spec.slots * per:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: {spec.name} arena size "
+                    f"{param.numel()} is not E*slots*per={self.num_local_experts}"
+                    f"*{spec.slots}*{per}"
+                )
+            seen: set[int] = set()
+            for expert_id in range(self.num_local_experts):
+                for slot in range(spec.slots):
+                    ptr = param[expert_id, slot].data_ptr()
+                    if ptr in seen:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: {spec.name}[expert="
+                            f"{expert_id},slot={slot}] aliases another expert slice"
+                        )
+                    seen.add(ptr)
+
+        expected_multiplier = CODEBOOK_MULTIPLIERS.get(self.config.codebook)
+        for expert_id in range(self.num_local_experts):
+            for proj_index, shard_id in enumerate(_PROJ_SHARDS):
+                family = "w13" if shard_id in ("w1", "w3") else "w2"
+                slot = _SHARD_SLOT[shard_id]
+                row = dict(
+                    zip(DESCRIPTOR_FIELDS, descriptors[expert_id, proj_index].tolist())
+                )
+                if row["family"] != _FAMILY_ID[family] or row["slot"] != slot:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] family/slot {row['family']}/{row['slot']} "
+                        f"!= {_FAMILY_ID[family]}/{slot}"
+                    )
+                if row["K"] != self.K or row["cb"] != self.cb:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] K/cb {row['K']}/{row['cb']} != "
+                        f"{self.K}/{self.cb}"
+                    )
+
+                if family == "w13":
+                    k = self.hidden_size
+                    n = self.intermediate_size_per_partition
+                else:
+                    k = self.intermediate_size_per_partition
+                    n = self.hidden_size
+                # Trellis tiles are always [k/16, n/16, 16K] (see
+                # docs/checkpoint_schema.md); w2 is *not* transposed.
+                tile = _trellis_shape(k, n, self.K)
+                if row["k"] != k or row["n"] != n:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] k/n {row['k']}/{row['n']} != {k}/{n}"
+                    )
+
+                for kind, spec_name in (
+                    ("trellis", f"{family}_trellis"),
+                    ("suh", f"{family}_suh"),
+                    ("svh", f"{family}_svh"),
+                ):
+                    spec = self.store.get(spec_name)
+                    per = math.prod(spec.shape[2:])
+                    if row[f"{kind}_tensor"] != names.index(spec.name):
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] {kind}_tensor {row[f'{kind}_tensor']} "
+                            f"!= {names.index(spec.name)} ({spec.name})"
+                        )
+                    expected_offset = (expert_id * spec.slots + slot) * per
+                    if row[f"{kind}_offset"] != expected_offset:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] {kind}_offset {row[f'{kind}_offset']} "
+                            f"!= strided offset {expected_offset}"
+                        )
+                    if expected_offset + per > getattr(layer, spec.name).numel():
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] {kind} slice runs past {spec.name}"
+                        )
+
+                trellis_spec = self.store.get(f"{family}_trellis")
+                if tuple(trellis_spec.shape[2:]) != tile:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {family}_trellis tile "
+                        f"{tuple(trellis_spec.shape[2:])} != {tile}"
+                    )
+                if self.store.get(f"{family}_suh").shape[2] != k:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {family}_suh length "
+                        f"{self.store.get(f'{family}_suh').shape[2]} != k={k}"
+                    )
+                if self.store.get(f"{family}_svh").shape[2] != n:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {family}_svh length "
+                        f"{self.store.get(f'{family}_svh').shape[2]} != n={n}"
+                    )
+
+                if self.config.codebook == "3inst":
+                    if row["codebook_tensor"] != -1 or row["codebook_offset"] != -1:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                            f"{proj_index}] has a codebook entry for 3inst"
+                        )
+                    continue
+                cb_spec = self.store.get(f"{family}_{self.config.codebook}")
+                if row["codebook_tensor"] != names.index(cb_spec.name):
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] codebook_tensor "
+                        f"{row['codebook_tensor']} != {names.index(cb_spec.name)}"
+                    )
+                if row["codebook_offset"] != expert_id * cb_spec.slots + slot:
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: descriptor[{expert_id},"
+                        f"{proj_index}] codebook_offset {row['codebook_offset']} "
+                        f"!= {expert_id * cb_spec.slots + slot}"
+                    )
+                if expected_multiplier is not None and self._load_attempted:
+                    value = int(
+                        getattr(layer, cb_spec.name).data[expert_id, slot].item()
+                    )
+                    if value != expected_multiplier:
+                        raise Exl3MoEUnsupported(
+                            f"exl3: MoE {self.prefix}: {cb_spec.name}[expert="
+                            f"{expert_id},slot={slot}] multiplier 0x"
+                            f"{value & 0xFFFFFFFF:08X} != 0x"
+                            f"{expected_multiplier & 0xFFFFFFFF:08X} "
+                            f"({self.config.codebook!r})"
+                        )
+
+        return {
+            "experts": self.num_local_experts,
+            "projections": len(_PROJ_ORDER),
+            "allocations": len(names),
+            "tiled_slices": sum(
+                self.num_local_experts * s.slots for s in self.store.specs
+            ),
+            "trellis_tile_w13": list(
+                self.store.get("w13_trellis").shape[2:]
+            ),
+            "trellis_tile_w2": list(self.store.get("w2_trellis").shape[2:]),
+        }
+
+    def process_weights_after_loading(self, layer: "RoutedExperts") -> None:
+        """Settle the layer after loading.
+
+        * fail closed if the checkpoint did not cover every expert/slot (a
+          missing slice would otherwise be uninitialised memory that silently
+          produces garbage tokens) — only when a real load was attempted, since
+          ``--load-format dummy`` never calls ``load_weights``;
+        * then run the P1-04 structural integrity check, which is safe on any
+          path because it reads the plan and descriptor buffer only.
+        """
+        if self._load_attempted:
+            self._require_complete(layer)
+            self._verify_codebook_multipliers(layer)
+        self.verify_expert_integrity(layer)
+
+    def _require_complete(self, layer: "RoutedExperts") -> None:
+        missing: list[tuple[str, int, int]] = []
+        for spec in self.store.specs:
+            for expert_id in range(self.num_local_experts):
+                for slot in range(spec.slots):
+                    if (spec.name, expert_id, slot) not in self._loaded:
+                        missing.append((spec.name, expert_id, slot))
+        if missing:
+            preview = ", ".join(
+                f"{name}[expert={e},slot={s}]" for name, e, s in missing[:6]
+            )
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {len(missing)} expert tensor slice(s) "
+                f"were not loaded ({preview}"
+                f"{', ...' if len(missing) > 6 else ''}); refusing to run with "
+                "uninitialised compressed experts"
+            )
+
+    def _verify_codebook_multipliers(self, layer: "RoutedExperts") -> None:
+        # The per-expert codebook scalar stores the codebook *multiplier*
+        # (presence selects the codebook; see ``exl3xpu/ref.py``). A config/
+        # checkpoint mismatch (e.g. `mcg` weights with a `mul1` config) would
+        # decode nonsense, so verify the value here.
+        expected_multiplier = CODEBOOK_MULTIPLIERS.get(self.config.codebook)
+        if expected_multiplier is not None:
+            for spec in self.store.specs:
+                if spec.tensor != self.config.codebook:
+                    continue
+                param = getattr(layer, spec.name)
+                if not bool(torch.all(param.data == expected_multiplier)):
+                    bad = int((param.data != expected_multiplier).sum().item())
+                    raise Exl3MoEUnsupported(
+                        f"exl3: MoE {self.prefix}: {spec.name} contains {bad} "
+                        f"codebook multiplier(s) != 0x"
+                        f"{expected_multiplier & 0xFFFFFFFF:08X} "
+                        f"({self.config.codebook!r} expected); checkpoint and "
+                        "config disagree"
+                    )
+
+    def get_fused_moe_quant_config(
+        self, layer: "RoutedExperts"
+    ) -> FusedMoEQuantConfig | None:
+        # EXL3 never calls a vLLM fused-MoE kernel, so there is no
+        # FusedMoEQuantConfig to publish.
+        return None
+
+    # -- eager execution (P2-01) -------------------------------------------
+
+    def _shard_of_nb(self, device: torch.device, n: int) -> torch.Tensor:
+        """Cached all-zero ``shard_of_nb`` for a single-group linear."""
+        key = (device, n)
+        cached = self._nb_cache.get(key)
+        if cached is None:
+            cached = torch.zeros(n // 128, dtype=torch.int32, device=device)
+            self._nb_cache[key] = cached
+        return cached
+
+    def _expert_linear(
+        self, views: dict[str, Any], projection: str, x: torch.Tensor
+    ) -> torch.Tensor:
+        """One projection of one expert through the verified fused op."""
+        from . import ops
+
+        m = views[projection]
+        # Production dense contract is suh:[num_groups, k]; the expert view is
+        # the per-expert [k] row (P1-08).
+        suh = m["suh"].unsqueeze(0)
+        return ops.exl3_linear(
+            x,
+            m["trellis"],
+            suh,
+            m["svh"],
+            self._shard_of_nb(x.device, m["n"]),
+            [0, m["n"]],
+            m["K"],
+            m["cb"],
+        )
+
+    # -- P4-01: zero-copy execution cache ------------------------------------
+    def _build_exec_cache(self, layer: "RoutedExperts") -> None:
+        """Per-projection arena handles, sliced once (no per-call sync).
+
+        P4-01. The P2-01 ``apply`` built handles per call through
+        ``expert_views`` → ``descriptor`` → ``.tolist()``, which forces a
+        device→host sync per expert per projection (~24 syncs/token at decode).
+        These handles are *views* into the stacked arenas, so indexing them
+        with a Python expert id costs no copy and no sync. ``K``/``cb`` are
+        layer-constant (validated in the constructor), so they are read from
+        ``self`` rather than from the descriptor buffer.
+        """
+        self._exec_cache = {
+            # projection: (trellis[E,...], suh[E,k], svh[E,n], n)
+            "gate": (getattr(layer, "w13_trellis")[:, 0],
+                     getattr(layer, "w13_suh")[:, 0],
+                     getattr(layer, "w13_svh")[:, 0],
+                     self.intermediate_size_per_partition),
+            "up": (getattr(layer, "w13_trellis")[:, 1],
+                   getattr(layer, "w13_suh")[:, 1],
+                   getattr(layer, "w13_svh")[:, 1],
+                   self.intermediate_size_per_partition),
+            "down": (getattr(layer, "w2_trellis")[:, 0],
+                     getattr(layer, "w2_suh")[:, 0],
+                     getattr(layer, "w2_svh")[:, 0],
+                     self.hidden_size),
+        }
+
+    def _cached_linear(self, projection: str, expert_id: int, x: torch.Tensor) -> torch.Tensor:
+        from . import ops
+
+        tr, suh, svh, n = self._exec_cache[projection]
+        return ops.exl3_linear(
+            x,
+            tr[expert_id],
+            suh[expert_id].unsqueeze(0),
+            svh[expert_id],
+            self._shard_of_nb(x.device, n),
+            [0, n],
+            self.K,
+            self.cb,
+        )
+
+    def _expert_mlp_cached(self, expert_id: int, x: torch.Tensor) -> torch.Tensor:
+        """Routed-expert MLP via the zero-copy cache (no per-call sync)."""
+        import torch.nn.functional as F
+
+        gate = self._cached_linear("gate", expert_id, x)
+        up = self._cached_linear("up", expert_id, x)
+        act = F.silu(gate) * up
+        return self._cached_linear("down", expert_id, act)
+
+    def _expert_mlp(
+        self, layer: "RoutedExperts", expert_id: int, x: torch.Tensor
+    ) -> torch.Tensor:
+        """Routed-expert MLP: ``down(silu(gate(x)) * up(x))``."""
+        import torch.nn.functional as F
+
+        views = self.expert_views(layer, expert_id)
+        gate = self._expert_linear(views, "gate_proj", x)
+        up = self._expert_linear(views, "up_proj", x)
+        act = F.silu(gate) * up
+        down = self._expert_linear(views, "down_proj", act)
+        if self._debug_capture is not None:
+            self._debug_capture.setdefault("experts", {})[int(expert_id)] = {
+                "gate": gate.detach(),
+                "up": up.detach(),
+                "act": act.detach(),
+                "down": down.detach(),
+            }
+        return down
+
+    # -- P2-08 diagnostic hook ---------------------------------------------
+    def enable_debug_capture(self) -> None:
+        """Capture per-expert/router intermediates on the next ``apply``."""
+        self._debug_capture = {}
+
+    def disable_debug_capture(self) -> dict[str, Any] | None:
+        captured, self._debug_capture = self._debug_capture, None
+        return captured
+
+    def apply(
+        self,
+        layer: "RoutedExperts",
+        x: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        shared_experts: Any,
+        shared_experts_input: torch.Tensor | None,
+    ) -> torch.Tensor:
+        """Eager routed-expert execution (P2-01).
+
+        vLLM's modular runner already selected the experts and normalized the
+        weights, and computes/adds the shared expert itself (``_maybe_combine``
+        does ``shared_output + fused_output``). This method therefore computes
+        **only** the routed contribution:
+
+            Y[i] = sum_{j in top-k(i)} w[i, j] * MLP_{ids[i, j]}(X[i])
+
+        with the routing weight applied to the *down-projection output* (after
+        SiLU/up and the output Hadamard), never to the input activations
+        (P2-03). Experts receiving no tokens are skipped. A Python loop over
+        active experts is the Gate 2 baseline; grouped kernels come in Phase 4.
+
+        P4-01: the per-expert handles are sliced once into a zero-copy cache
+        and the single-token decode path reads the routing decision with one
+        host sync (instead of ~27 per-expert descriptor/validation syncs).
+        """
+        hidden = x.shape[-1]
+        x2 = x.reshape(-1, hidden)
+        if not x2.is_contiguous():
+            x2 = x2.contiguous()
+
+        if x2.shape[0] == 0:
+            return torch.zeros_like(x2)
+
+        if topk_ids.shape != topk_weights.shape or topk_ids.dim() != 2:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: topk_ids/topk_weights must be "
+                f"[tokens, k]; got {tuple(topk_ids.shape)} / "
+                f"{tuple(topk_weights.shape)}"
+            )
+        if topk_ids.shape[0] != x2.shape[0]:
+            raise Exl3MoEUnsupported(
+                f"exl3: MoE {self.prefix}: {topk_ids.shape[0]} routing rows for "
+                f"{x2.shape[0]} tokens"
+            )
+
+        if getattr(self, "_exec_cache", None) is None:
+            self._build_exec_cache(layer)
+
+        # Routed output accumulated in fp32, cast back at the end.
+        out = torch.zeros(x2.shape, dtype=torch.float32, device=x2.device)
+        weights = topk_weights.to(torch.float32)
+        tokens = x2.shape[0]
+
+        if self._debug_capture is None and tokens == 1:
+            # --- P4-01 single-token (decode) fast path ----------------------
+            # One host sync for the routing decision; every expert handle is a
+            # zero-copy cache view, so there are no further syncs.
+            ids = topk_ids.view(-1).tolist()
+            wts = weights.view(-1).tolist()
+            for expert_id, wt in zip(ids, wts):
+                y = self._expert_mlp_cached(int(expert_id), x2)
+                out += y.to(torch.float32) * wt
+            return out.to(x2.dtype).reshape(x.shape)
+
+        # --- general (prefill / multi-token) path ---------------------------
+        if self._debug_capture is not None and topk_ids.numel():
+            # Range validation is a device->host sync; keep it on the debug
+            # path only (the arena shape is asserted once at load time).
+            if int(topk_ids.min()) < 0 or int(topk_ids.max()) >= self.num_local_experts:
+                raise Exl3MoEUnsupported(
+                    f"exl3: MoE {self.prefix}: routing index outside "
+                    f"[0, {self.num_local_experts})"
+                )
+
+        for expert_id in torch.unique(topk_ids).tolist():
+            token_idx, slot_idx = (topk_ids == expert_id).nonzero(as_tuple=True)
+            if token_idx.numel() == 0:
+                continue
+            rows = x2.index_select(0, token_idx)
+            if self._debug_capture is not None:
+                y = self._expert_mlp(layer, int(expert_id), rows)
+            else:
+                y = self._expert_mlp_cached(int(expert_id), rows)
+            w = weights[token_idx, slot_idx].unsqueeze(-1)
+            out.index_add_(0, token_idx, y.to(torch.float32) * w)
+
+        if self._debug_capture is not None:
+            self._debug_capture.update({
+                "x": x2.detach(),
+                "topk_ids": topk_ids.detach(),
+                "topk_weights": topk_weights.detach(),
+                "routed_fp32": out.detach(),
+            })
+
+        return out.to(x2.dtype).reshape(x.shape)
+
+
+# ---------------------------------------------------------------------------
+# P1-05: shard-by-shard streaming loader
+# ---------------------------------------------------------------------------
+
+#: Checkpoint suffixes that make up one routed-expert module.
+EXPERT_SUFFIXES = frozenset({"trellis", "suh", "svh", "mcg", "mul1"})
+
+
+def split_expert_key(key: str) -> tuple[str | None, str | None]:
+    """Split a checkpoint key into ``(layer_key, relative_name)``.
+
+    ``layer_key`` is the normalized ``RoutedExperts`` key
+    (``"layers.3.mlp.experts"``); ``relative_name`` is the name the per-layer
+    loader consumes (``"0.gate_proj.trellis"``). Non-routed keys (shared
+    expert, attention, vision, embedding, ``lm_head``, MTP) return
+    ``(None, None)``.
+    """
+    stem, dot, suffix = key.rpartition(".")
+    if not dot or suffix not in EXPERT_SUFFIXES:
+        return None, None
+    from .vllm_plugin import _norm_key
+
+    parts = _norm_key(stem).split(".")
+    if (
+        len(parts) < 6
+        or parts[0] != "layers"
+        or parts[2] != "mlp"
+        or parts[3] != "experts"
+        or not parts[4].isdigit()
+    ):
+        return None, None
+    layer_key = ".".join(parts[:4])
+    relative = ".".join(parts[4:]) + "." + suffix
+    return layer_key, relative
+
+
+def stream_expert_shards(
+    shard_paths: Iterable[Any],
+    layers: dict[str, "RoutedExperts"],
+    *,
+    on_shard: Any = None,
+) -> dict[str, Any]:
+    """Pack routed experts into ``layers`` one ``safetensors`` shard at a time.
+
+    P1-05. On the unified-memory Arc part, holding several 8 GiB shards'
+    mmaps open while also touching the packed arenas duplicates host and
+    device traffic. This loader:
+
+    1. opens exactly one shard at a time with ``safe_open``;
+    2. reads each routed-expert tensor lazily via ``get_tensor`` inside a
+       generator, so at most one checkpoint tensor's payload is resident in
+       addition to the arenas;
+    3. feeds it to the layer's per-layer loader (``RoutedExperts.load_weights``
+       override), then tears the shard down with ``gc.collect()`` and
+       ``torch.xpu.empty_cache()`` before moving on.
+
+    ``layers`` maps a *normalized* layer key (``"layers.3.mlp.experts"``) to
+    its ``RoutedExperts`` whose ``create_weights`` has already run.
+
+    Returns a report with:
+
+    * ``consumed`` — routed-expert checkpoint keys handed to a layer loader;
+    * ``out_of_scope`` — routed keys for layers not in ``layers`` (deliberately
+      skipped, e.g. a ``--layers`` subset; the caller decides whether it
+      expects these);
+    * ``shards`` — per-shard timing/telemetry (fed to ``on_shard`` as it goes);
+    * ``expert_tensors`` — total routed tensors streamed.
+    """
+    import gc
+    import time
+
+    from safetensors import safe_open
+
+    consumed: list[str] = []
+    out_of_scope: list[str] = []
+    shards: list[dict[str, Any]] = []
+
+    for shard_index, path in enumerate(shard_paths):
+        t0 = time.perf_counter()
+        n_read = 0
+        by_layer: dict[str, list[tuple[str, str]]] = {}
+        with safe_open(str(path), framework="pt") as f:
+            for key in f.keys():
+                layer_key, relative = split_expert_key(key)
+                if layer_key is None:
+                    continue
+                by_layer.setdefault(layer_key, []).append((key, relative))
+
+            for layer_key, entries in by_layer.items():
+                layer = layers.get(layer_key)
+                if layer is None:
+                    out_of_scope.extend(key for key, _ in entries)
+                    continue
+
+                def _tensors(entries=entries, f=f):
+                    for key, relative in entries:
+                        yield relative, f.get_tensor(key)
+
+                list(layer.load_weights(_tensors()))
+                consumed.extend(key for key, _ in entries)
+                n_read += len(entries)
+            # Drop the key map before closing so mmap pages can be reclaimed.
+            del by_layer
+
+        gc.collect()
+        try:
+            torch.xpu.empty_cache()
+        except Exception:  # pragma: no cover - CPU-only / no XPU
+            pass
+
+        row = {
+            "shard_index": shard_index,
+            "shard": str(path),
+            "expert_tensors": n_read,
+            "seconds": time.perf_counter() - t0,
+        }
+        if on_shard is not None:
+            on_shard(row)
+        shards.append(row)
+
+    return {
+        "consumed": consumed,
+        "out_of_scope": out_of_scope,
+        "shards": shards,
+        "expert_tensors": sum(r["expert_tensors"] for r in shards),
+    }

## file: csrc/exl3_ops.sycl
--- a/csrc/exl3_ops.sycl	2026-10-21 22:05:50.341775534 +0200
+++ b/csrc/exl3_ops.sycl	2026-10-24 19:13:00.922002491 +0200
@@ -0,0 +1,847 @@
+#include <map>
+// Host launchers + torch bindings for EXL3 ESIMD kernels.
+#include <torch/all.h>
+#include <torch/library.h>
+#include <c10/xpu/XPUStream.h>
+#include "exl3_esimd.h"
+#include "fa_esimd.h"
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+using namespace exl3;
+
+static sycl::queue& queue_of(const at::Tensor& t) {
+    return c10::xpu::getCurrentXPUStream(t.device().index()).queue();
+}
+
+static int round_up(int a, int b) { return (a + b - 1) / b * b; }
+// MB=64 DPAS: two tiles per thread in 256-register mode (M=64 linears 120 -> 87 ms on B70)
+#ifndef EXL3_NO_DPAS64_LARGE_GRF
+#define EXL3_DPAS64_LARGE_GRF
+#endif
+#ifndef EXL3_DPAS64_NT
+#define EXL3_DPAS64_NT 2
+#endif
+static int g_local = 8;       // work-group size (threads) for the GEMV / DPAS launches
+// MB=24 DPAS block for 17..24 rows (3 x 8-row DPAS, 2 tiles/thread): all linears M=17 43.3 -> 41.1 ms,
+// M=24 45.0 -> 42.6 (NT=4 spills: ~110 ms). Opt out with EXL3_NO_DPAS_MB24.
+#ifndef EXL3_NO_DPAS_MB24
+#define EXL3_DPAS_MB24
+#endif
+// MB=40/48 blocks (256-GRF, NT=2, split-K target as MB=64) for 33..48 rows (C16 thinking-on runs ~10 streams =
+// ~40 rows): all linears M=33 59.7 -> 56.9, M=40 61.9 -> 58.5, M=48 64.3 -> 61.6 ms. Opt out: EXL3_NO_DPAS_MB48.
+#ifndef EXL3_NO_DPAS_MB48
+#define EXL3_DPAS_MB48
+#endif
+static int g_max_mb = 64;     // largest DPAS row block; M above it runs as several blocks
+void exl3_set_max_mb(int64_t n) { g_max_mb = (int)n; }
+void exl3_set_local(int64_t n) { g_local = (int)n; }
+
+template <typename TIn>
+static void launch_had_in(const at::Tensor& x, const at::Tensor& suh, at::Tensor& xh, sycl::queue& q,
+                          bool row_major = false) {
+    int M = x.size(0), Kdim = x.size(1), S = suh.size(0), Mp = xh.size(1);
+    int n = S * M * (Kdim / 128);
+    HadInKernel<TIn> k{reinterpret_cast<const TIn*>(x.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
+                       reinterpret_cast<fp16*>(xh.data_ptr()), M, Kdim, S, (int)x.stride(0), Mp, row_major ? 1 : 0};
+    int local = 8;
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+}
+
+template <typename TOut, typename TPart = float>
+static void launch_had_out(const at::Tensor& part, int P, const at::Tensor& svh, at::Tensor& out, sycl::queue& q) {
+    int M = out.size(0), N = out.size(1);
+    int n = M * (N / 128);
+    HadOutKernel<TOut, TPart> k{reinterpret_cast<const TPart*>(part.data_ptr()), reinterpret_cast<const fp16*>(svh.data_ptr()),
+                         reinterpret_cast<TOut*>(out.data_ptr()), M, N, P, (int)out.stride(0)};
+    int local = 8;
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+}
+
+#ifdef EXL3_LUT
+// one table per (device, codebook), built on first use from decode_cb_h itself (bit-exact by construction)
+static const fp16* lut_for(int cb, const at::Tensor& like, sycl::queue& q) {
+    static std::map<std::pair<int, int>, at::Tensor> tabs;
+    auto key = std::make_pair((int)like.device().index(), cb);
+    auto it = tabs.find(key);
+    if (it == tabs.end()) {
+        auto t = at::empty({65536}, like.options().dtype(at::kHalf));
+        fp16* p = reinterpret_cast<fp16*>(t.data_ptr());
+        q.submit([&](sycl::handler& h) {
+            if (cb == 1) h.parallel_for(sycl::nd_range<1>(4096, 16), LutKernel<1>{p});
+            else if (cb == 2) h.parallel_for(sycl::nd_range<1>(4096, 16), LutKernel<2>{p});
+            else h.parallel_for(sycl::nd_range<1>(4096, 16), LutKernel<0>{p});
+        });
+        q.wait();
+        it = tabs.emplace(key, t).first;
+    }
+    return reinterpret_cast<const fp16*>(it->second.data_ptr());
+}
+#endif
+
+template <int K, int CB, int MR, int NT>
+static void launch_gemv(const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard, at::Tensor& part,
+                        int M, int Kdim, int N, int P, int rows_per_split, sycl::queue& q) {
+    int tiles_n = N / 16;
+    int n_strips = tiles_n / NT;
+    GemvKernel<K, CB, MR, NT> k{reinterpret_cast<const fp16*>(xh.data_ptr()),
+                                reinterpret_cast<const uint32_t*>(tr.data_ptr()),
+                                shard.data_ptr<int>(), part.data_ptr<float>(),
+                                M, Kdim, N, tiles_n, rows_per_split, n_strips};
+#ifdef EXL3_LUT
+    k.lut = lut_for(CB, xh, q);
+#endif
+    int n = n_strips * P;
+    int local = g_local;
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+}
+
+template <int K, int CB, int MB, int NT>
+static void launch_dpas(const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard, at::Tensor& part,
+                        int M, int Kdim, int N, int P, int rows_per_split, sycl::queue& q) {
+    int tiles_n = N / 16;
+    int n_strips = tiles_n / NT;
+    int m_blocks = (M + MB - 1) / MB;
+    TORCH_CHECK(xh.size(-2) == m_blocks * MB || (xh.dim() == 4 && xh.size(2) == m_blocks * MB), "xh rows must be padded to MB");
+    DpasKernel<K, CB, MB, NT> k{reinterpret_cast<const fp16*>(xh.data_ptr()),
+                                reinterpret_cast<const uint32_t*>(tr.data_ptr()),
+                                shard.data_ptr<int>(), part.data_ptr<float>(),
+                                M, Kdim, N, tiles_n, rows_per_split, n_strips, m_blocks, m_blocks * MB};
+    int n = n_strips * m_blocks * P;
+    int local = g_local;
+#if defined(EXL3_DPAS_LARGE_GRF) || defined(EXL3_DPAS64_LARGE_GRF)
+#ifdef EXL3_DPAS_LARGE_GRF
+    constexpr bool large = true;
+#elif defined(EXL3_DPAS32_LARGE_GRF)
+    constexpr bool large = (MB >= 32);
+#else
+    constexpr bool large = (MB >= 40);
+#endif
+    if constexpr (large) {
+        // 256-register mode: room for the MB x 16 x NT accumulator without spills
+        sycl::ext::oneapi::experimental::properties props{sycl::ext::intel::experimental::grf_size<256>};
+        q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), props, k); });
+    } else {
+        q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+    }
+#else
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+#endif
+}
+
+template <int K, int CB>
+static bool dispatch_dpas(int MB, const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard,
+                          at::Tensor& part, int M, int Kdim, int N, int P, int rps, sycl::queue& q) {
+    switch (MB) {
+#ifndef EXL3_DPAS8_NT
+#define EXL3_DPAS8_NT 4
+#endif
+#ifndef EXL3_DPAS4_NT
+#define EXL3_DPAS4_NT 4
+#endif
+#ifdef EXL3_DPAS_MB4
+        case 4:  launch_dpas<K, CB, 4, EXL3_DPAS4_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+#endif
+        case 8:  launch_dpas<K, CB, 8, EXL3_DPAS8_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+        case 16: launch_dpas<K, CB, 16, 4>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+#ifdef EXL3_DPAS_MB24
+#ifndef EXL3_DPAS24_NT
+#define EXL3_DPAS24_NT 2
+#endif
+        case 24: launch_dpas<K, CB, 24, EXL3_DPAS24_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+#endif
+#ifndef EXL3_DPAS32_NT
+#define EXL3_DPAS32_NT 2
+#endif
+        case 32: launch_dpas<K, CB, 32, EXL3_DPAS32_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+#ifdef EXL3_DPAS_MB48
+        case 40: launch_dpas<K, CB, 40, 2>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+        case 48: launch_dpas<K, CB, 48, 2>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+#endif
+#ifndef EXL3_DPAS64_NT
+#define EXL3_DPAS64_NT 1
+#endif
+        case 64: launch_dpas<K, CB, 64, EXL3_DPAS64_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+    }
+    return false;
+}
+
+#ifndef EXL3_DPAS24_NT
+#define EXL3_DPAS24_NT 2
+#endif
+static int dpas_nt(int MB) { return MB == 4 ? EXL3_DPAS4_NT : MB == 8 ? EXL3_DPAS8_NT : MB == 24 ? EXL3_DPAS24_NT : (MB == 40 || MB == 48) ? 2 : (MB <= 16 ? 4 : (MB == 32 ? EXL3_DPAS32_NT : EXL3_DPAS64_NT)); }
+// Arc 140V baseline (no XMX/DPAS): vector kernel for M<=8 (dispatch_mr covers
+// MR=1/2/4/8 with tail guards). M above this must use reconstruct+GEMM.
+static int g_vec_max_m = 8;
+
+// Split-K sizing: threads to aim for when choosing the number of K splits. Measured on B70 (all linears,
+// graph-captured): 1024 beats 4096 by 10-20% for M=1..32 (fewer fp32 partials for had_out to reduce, and the
+// 256-GRF DPAS kernels only hold ~1024 resident threads); MB=64 prefers 2048 (77 vs 88 ms).
+static int g_target_threads = 1024;          // vector GEMV (M<=2) and DPAS MB=32
+static int g_target_threads_mb16 = 1408;     // DPAS MB=8/16: plateau 1280-1536 (M=4 35.1->32.2 ms, M=16 38.7->36.0), cliff at 1664
+static int g_target_threads_mb64 = 2048;
+
+// Column-strip width (tiles per thread) per case, from bench sweeps on B70:
+// K=4 M=1 -> 8 (longer contiguous reads), K=4 M=2..4 -> 4, K=6 -> 4 (two 32-lane tile pairs), M=8 -> 2.
+// Arc 140V / EXL3_ALL_CODEBOOKS: K=3,5 decode G=8 lanes per vector op (TP=4),
+// so an MR=8 thread needs NT>=4 to satisfy GemvKernel's NT%TP==0 (NT=2 fails
+// the static_assert). ACC stays smaller than the tuned K=4/MR=8 case, and no
+// previously-compiling case changes value.
+constexpr int nt_of(int K, int MR) {
+    if (MR == 8 && (K == 3 || K == 5)) return 4;
+    return MR == 8 ? 2 : (K <= 4 ? (MR == 1 ? 8 : 4) : 4);
+}
+static int nt_for(int K, int MR) { return nt_of(K, MR); }
+
+template <int K, int CB>
+static bool dispatch_mr(int MR, const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard,
+                        at::Tensor& part, int M, int Kdim, int N, int P, int rps, sycl::queue& q) {
+    switch (MR) {
+        case 1: launch_gemv<K, CB, 1, nt_of(K, 1)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+        case 2: launch_gemv<K, CB, 2, nt_of(K, 2)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+        case 4: launch_gemv<K, CB, 4, nt_of(K, 4)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+        case 8: launch_gemv<K, CB, 8, nt_of(K, 8)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
+    }
+    return false;
+}
+
+// ---- fused single-kernel path (M <= 8, fp16 in/out): input Hadamard + GEMM + split-K + output Hadamard
+static at::Tensor& fused_counters(const at::Device& dev) {
+    static std::vector<at::Tensor> bufs(16);
+    auto& b = bufs.at(dev.index());
+    if (!b.defined()) b = at::zeros({1 << 16}, at::TensorOptions().dtype(at::kInt).device(dev));
+    return b;
+}
+
+template <typename KernelT>
+static void launch_fused(KernelT k, int n, sycl::queue& q) {
+    int local = 8;
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+}
+
+template <int K, int CB>
+static bool fused_small(const at::Tensor& x, const at::Tensor& tr, const at::Tensor& suh, const at::Tensor& svh,
+                        const at::Tensor& shard, at::Tensor& out, int M, int Kdim, int N, sycl::queue& q) {
+    // Arc 140V baseline: the fused kernel only instantiates MR=1/2 (rows beyond
+    // m=1 are never computed). Decline larger M so the caller falls through to
+    // the unfused vector path, which covers MR up to 8.
+    if (M > 2) return false;
+    int tk = Kdim / 16, tiles_n = N / 16;
+    bool vec = M <= g_vec_max_m;
+    int NT = vec ? (M <= 1 ? nt_of(K, 1) : nt_of(K, 2)) : dpas_nt(8);
+    int n_strips = tiles_n / NT;
+    int P = std::max(1, std::min(tk / 8, (g_target_threads + n_strips - 1) / n_strips));
+    int rps = ((tk + P - 1) / P + 7) / 8 * 8;             // multiple of 8 tile-rows (one Hadamard block)
+    P = (tk + rps - 1) / rps;
+    auto part = at::empty({P, M, N}, x.options().dtype(at::kFloat));
+    FusedArgs fa{reinterpret_cast<const fp16*>(x.data_ptr()), (int)x.stride(0),
+                 reinterpret_cast<const fp16*>(suh.data_ptr()), reinterpret_cast<const fp16*>(svh.data_ptr()),
+                 reinterpret_cast<fp16*>(out.data_ptr()), (int)out.stride(0),
+                 reinterpret_cast<uint32_t*>(fused_counters(x.device()).data_ptr())};
+    const uint32_t* trp = reinterpret_cast<const uint32_t*>(tr.data_ptr());
+    const int* shp = shard.data_ptr<int>();
+    float* pp = part.data_ptr<float>();
+    int n = n_strips * P;
+    if (vec) {
+        if (M <= 1) {
+            GemvKernel<K, CB, 1, nt_of(K, 1), true> k{nullptr, trp, shp, pp, M, Kdim, N, tiles_n, rps, n_strips, fa, P};
+#ifdef EXL3_LUT
+            k.lut = lut_for(CB, x, q);
+#endif
+            launch_fused(k, n, q);
+        } else {
+            GemvKernel<K, CB, 2, nt_of(K, 2), true> k{nullptr, trp, shp, pp, M, Kdim, N, tiles_n, rps, n_strips, fa, P};
+#ifdef EXL3_LUT
+            k.lut = lut_for(CB, x, q);
+#endif
+            launch_fused(k, n, q);
+        }
+    } else {
+        DpasKernel<K, CB, 8, EXL3_DPAS8_NT, true> k{nullptr, trp, shp, pp, M, Kdim, N, tiles_n, rps, n_strips, 1, 8, fa, P};
+        launch_fused(k, n, q);
+    }
+    return true;
+}
+
+static bool g_fused = false;   // measured slower under XPU graphs (serialized split-K tail); opt in via exl3_set_fused
+void exl3_set_fused(int64_t on) { g_fused = on != 0; }
+
+void exl3_gemm_small(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
+                     at::Tensor out, int64_t K, int64_t cb) {
+    TORCH_CHECK(x.dim() == 2 && x.stride(1) == 1, "x must be 2D row-major");
+    TORCH_CHECK(trellis.scalar_type() == at::kShort && trellis.is_contiguous());
+    auto& q = queue_of(x);
+    int M = x.size(0), Kdim = x.size(1), N = svh.size(0), S = suh.size(0);
+    // Arc 140V baseline (no XMX/DPAS): fail loudly instead of dispatching DPAS.
+    // Production callers route M > g_vec_max_m via reconstruct+GEMM
+    // (EXL3_SMALL_M_MAX); direct op calls with M > 8 are a caller bug.
+    TORCH_CHECK(M <= g_vec_max_m, "exl3_gemm_small: M=", M,
+                " exceeds no-DPAS vector limit ", g_vec_max_m);
+    if (g_fused && M <= 8 && x.scalar_type() == at::kHalf && out.scalar_type() == at::kHalf && out.stride(1) == 1 &&
+        N / 128 <= (1 << 16)) {
+        bool done = false;
+        if (K == 4 && cb == 2) done = fused_small<4, 2>(x, trellis, suh, svh, shard_of_nb, out, M, Kdim, N, q);
+        else if (K == 6 && cb == 2) done = fused_small<6, 2>(x, trellis, suh, svh, shard_of_nb, out, M, Kdim, N, q);
+        if (done) return;
+    }
+    bool use_vec = M <= g_vec_max_m;
+    int MR = M <= 1 ? 1 : (M <= 2 ? 2 : (M <= 4 ? 4 : 8));
+#ifdef EXL3_DPAS_MB4
+    int MB = M <= 4 ? 4 : (M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64)));
+#elif defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
+#elif defined(EXL3_DPAS_MB24)
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
+#else
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
+#endif
+    if (MB > g_max_mb) MB = g_max_mb;
+    int m_blocks = use_vec ? 1 : (M + MB - 1) / MB;
+    int Mp = use_vec ? M : m_blocks * MB;
+    // blocked activations [S][Mp][Kdim] (row-blocked inside); pad rows must be zero for DPAS
+    auto xh = Mp == M ? at::empty({S, Mp, Kdim}, x.options().dtype(at::kHalf))
+                      : at::zeros({S, Mp, Kdim}, x.options().dtype(at::kHalf));
+    if (x.scalar_type() == at::kHalf) launch_had_in<fp16>(x, suh, xh, q);
+    else if (x.scalar_type() == at::kBFloat16) launch_had_in<sycl::ext::oneapi::bfloat16>(x, suh, xh, q);
+    else TORCH_CHECK(false, "x dtype");
+
+    int tk = Kdim / 16;
+    int n_strips = (N / 16) / (use_vec ? nt_for(K, MR) : dpas_nt(MB));
+    int units = n_strips * m_blocks;
+    int target = use_vec ? g_target_threads
+               : (MB <= 16 ? g_target_threads_mb16 : (MB >= 40 ? g_target_threads_mb64 : g_target_threads));
+    int P = std::max(1, std::min(tk, (target + units - 1) / units));
+    int rps = (tk + P - 1) / P;
+    P = (tk + rps - 1) / rps;
+    auto part = at::empty({P, M, N}, x.options().dtype(at::kFloat));
+
+    bool ok = false;
+#ifdef EXL3_DEBUG_SKIP_GEMV
+    ok = true; K = -1;
+#endif
+#define EXL3_CASE(KK, CC) \
+    if (K == KK && cb == CC) ok = use_vec ? dispatch_mr<KK, CC>(MR, xh, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q) \
+                                          : dispatch_dpas<KK, CC>(MB, xh, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    EXL3_CASE(4, 2) EXL3_CASE(6, 2)
+#ifdef EXL3_ALL_CODEBOOKS
+    EXL3_CASE(2, 2) EXL3_CASE(3, 2) EXL3_CASE(5, 2)
+    EXL3_CASE(4, 0) EXL3_CASE(4, 1) EXL3_CASE(6, 0) EXL3_CASE(6, 1)
+#endif
+#undef EXL3_CASE
+    // K=3 / MCG vector GEMV: the routed-expert format of Qwen3.5-35B-A3B
+    // (30 720 modules). Only the vector kernel is instantiated here; the DPAS
+    // table stays untouched because K=3 decode is not wired into it and the
+    // Arc 140V has no XMX units, so this path is unreachable there.
+    if (K == 3 && cb == 1 && use_vec)
+        ok = dispatch_mr<3, 1>(MR, xh, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    TORCH_CHECK(ok, "exl3_gemm_small: unsupported K/codebook ", K, "/", cb);
+
+    if (out.scalar_type() == at::kHalf) launch_had_out<fp16>(part, P, svh, out, q);
+    else if (out.scalar_type() == at::kBFloat16) launch_had_out<sycl::ext::oneapi::bfloat16>(part, P, svh, out, q);
+    else if (out.scalar_type() == at::kFloat) launch_had_out<float>(part, P, svh, out, q);
+    else TORCH_CHECK(false, "out dtype");
+}
+
+
+template <int K, int CB>
+static void launch_reconstruct(const at::Tensor& tr, at::Tensor& w, int n0, sycl::queue& q) {
+    int tk = tr.size(0), tiles_n = tr.size(1), n_out = w.size(1);
+    constexpr int NT = 8;   // 128 columns per thread (reconstruct slices are multiples of 128)
+    int n_strips = n_out / (16 * NT);
+    ReconstructKernel<K, CB, NT> k{reinterpret_cast<const uint32_t*>(tr.data_ptr()),
+                                   reinterpret_cast<fp16*>(w.data_ptr()), tiles_n, n0 / 16, n_out, n_strips, tk};
+    int n = n_strips * tk, local = 8;
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+}
+
+#ifdef EXL3_DNNL
+#include <oneapi/dnnl/dnnl.hpp>
+#include <oneapi/dnnl/dnnl_sycl.hpp>
+// y[:, cols] (fp16, row stride ldy) = (xq[M,K] @ wq[K,N]) * sw * sx[m]: int8 XMX GEMM with the dequant fused,
+// so the output Hadamard reads fp16 instead of int32. Primitives cached per (M, K, N, ldy).
+namespace q8dnnl {
+struct Ctx { dnnl::engine eng; dnnl::stream strm; };
+static Ctx& ctx(sycl::queue& q) {
+    static std::map<void*, Ctx> m;
+    void* key = (void*)&q;
+    auto it = m.find(key);
+    if (it == m.end()) {
+        auto eng = dnnl::sycl_interop::make_engine(q.get_device(), q.get_context());
+        it = m.emplace(key, Ctx{eng, dnnl::sycl_interop::make_stream(eng, q)}).first;
+    }
+    return it->second;
+}
+static void gemm(sycl::queue& q, const at::Tensor& like, const int8_t* xq, const int8_t* wq, const float* sw_dev, const float* sx, fp16* y,
+                   int64_t M, int64_t K, int64_t N, int64_t ldy) {
+    using namespace dnnl;
+    using dt = memory::data_type;
+    auto& c = ctx(q);
+    // scratchpad in user mode, allocated through torch (library-mode scratch lives outside vLLM's memory budget)
+    static std::map<std::tuple<int64_t, int64_t, int64_t, int64_t>, std::pair<dnnl::matmul, size_t>> cache;
+    auto key = std::make_tuple(M, K, N, ldy);
+    memory::desc a_md({M, K}, dt::s8, memory::dims{K, 1});
+    memory::desc b_md({K, N}, dt::s8, memory::dims{N, 1});
+    memory::desc c_md({M, N}, dt::f16, memory::dims{ldy, 1});
+    memory::desc sx_md({M, 1}, dt::f32, memory::dims{1, 1});
+    memory::desc sw_md({1}, dt::f32, memory::dims{1});
+    auto it = cache.find(key);
+    if (it == cache.end()) {
+        primitive_attr attr;
+        attr.set_scales_mask(DNNL_ARG_WEIGHTS, 0);
+        post_ops po;
+        po.append_binary(algorithm::binary_mul, sx_md);
+        attr.set_post_ops(po);
+        attr.set_scratchpad_mode(scratchpad_mode::user);
+        auto pd = dnnl::matmul::primitive_desc(c.eng, a_md, b_md, c_md, attr);
+        it = cache.emplace(key, std::make_pair(dnnl::matmul(pd), (size_t)pd.scratchpad_desc().get_size())).first;
+    }
+    at::Tensor scratch = at::empty({(int64_t)std::max<size_t>(it->second.second, 1)}, like.options().dtype(at::kByte));
+    auto mk = [&](const memory::desc& md, const void* p) {
+        return sycl_interop::make_memory(md, c.eng, sycl_interop::memory_kind::usm, const_cast<void*>(p));
+    };
+    memory::desc sp_md({(int64_t)it->second.second}, dt::u8, memory::dims{1});
+    sycl_interop::execute(it->second.first, c.strm,
+                          {{DNNL_ARG_SRC, mk(a_md, xq)}, {DNNL_ARG_WEIGHTS, mk(b_md, wq)}, {DNNL_ARG_DST, mk(c_md, y)},
+                           {DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, mk(sw_md, sw_dev)},
+                           {DNNL_ARG_ATTR_MULTIPLE_POST_OP(0) | DNNL_ARG_SRC_1, mk(sx_md, sx)},
+                           {DNNL_ARG_SCRATCHPAD, mk(sp_md, scratch.data_ptr())}});
+}
+}  // namespace q8dnnl
+#endif
+
+#ifdef EXL3_DNNL
+#include <oneapi/dnnl/dnnl_graph.hpp>
+#include <oneapi/dnnl/dnnl_graph_sycl.hpp>
+#include <c10/xpu/XPUCachingAllocator.h>
+// Prefill attention through oneDNN Graph SDPA (fused, ~95 TF at head_dim 256 vs ~76 for FA2).
+// Head-major: q [Hq, Q, D], k/v [Hk, L, D] fp16 (GQA, Hq = G*Hk), out [Hq, Q, D]; causal = bottom-right aligned.
+// With lse defined ([Hq, Q] f32), the softmax log-sum-exp (natural log) is written there (softmax stats output).
+namespace sdpadnnl {
+using namespace dnnl::graph;
+using lt = logical_tensor;
+static void* alloc_fn(size_t n, size_t, const void*, const void*) { return c10::xpu::XPUCachingAllocator::raw_alloc(n); }
+static void free_fn(void* p, const void*, const void*, void*) { c10::xpu::XPUCachingAllocator::raw_delete(p); }
+struct Ctx { dnnl::engine eng; dnnl::stream strm; };
+static Ctx& ctx(sycl::queue& q) {
+    static std::map<void*, Ctx> m;
+    auto it = m.find((void*)&q);
+    if (it == m.end()) {
+        auto alloc = sycl_interop::make_allocator(alloc_fn, free_fn);
+        auto eng = sycl_interop::make_engine_with_allocator(q.get_device(), q.get_context(), alloc);
+        it = m.emplace((void*)&q, Ctx{eng, dnnl::sycl_interop::make_stream(eng, q)}).first;
+    }
+    return it->second;
+}
+struct Entry { compiled_partition cp; std::vector<lt> ins, outs; };
+static Entry& build(Ctx& c, int64_t Q, int64_t L, int64_t Hq, int64_t Hk, int64_t D, bool causal, bool with_lse) {
+    static std::map<std::tuple<int64_t, int64_t, int64_t, int64_t, int64_t, bool, bool>, Entry> cache;
+    auto key = std::make_tuple(Q, L, Hq, Hk, D, causal, with_lse);
+    auto it = cache.find(key);
+    if (it != cache.end()) return it->second;
+    const int64_t G = Hq / Hk;
+    using dt = lt::data_type;
+    size_t id = 0;
+    // 5D views of the natural vLLM layouts (no copies): [1, Hk, G, Q, D] / [1, Hk, 1, L, D]
+    lt query(id++, dt::f16, {1, Hk, G, Q, D}, {Hq * Q * D, G * Q * D, Q * D, D, 1});
+    lt keyt(id++, dt::f16, {1, Hk, 1, L, D}, {Hk * L * D, L * D, L * D, D, 1});
+    lt score(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+    op bmm1(id++, op::kind::MatMul, "bmm1"); bmm1.set_attr<bool>(op::attr::transpose_b, true);
+    bmm1.add_inputs({query, keyt}); bmm1.add_outputs({score});
+    lt scale(id++, dt::f16, lt::dims{1}, lt::layout_type::strided);   // divisor sqrt(D), as in oneDNN's gqa example
+    lt scaled(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+    op mul(id++, op::kind::Divide, "scale"); mul.add_inputs({score, scale}); mul.add_outputs({scaled});
+    std::vector<op> ops{bmm1, mul};
+    lt sm_in = scaled;
+    std::vector<lt> extra_ins;
+    if (causal) {
+        lt row(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op gr(id++, op::kind::GenIndex, "row"); gr.set_attr<int64_t>(op::attr::axis, -2); gr.add_inputs({scaled}); gr.add_outputs({row});
+        lt lk(id++, dt::s32, 0, lt::layout_type::strided, lt::property_type::host_scalar);
+        lt ra(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op add(id++, op::kind::Add, "row+L"); add.add_inputs({row, lk}); add.add_outputs({ra});
+        lt lq(id++, dt::s32, 0, lt::layout_type::strided, lt::property_type::host_scalar);
+        lt rs(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op sub(id++, op::kind::Subtract, "-Q"); sub.add_inputs({ra, lq}); sub.add_outputs({rs});
+        lt col(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op gc(id++, op::kind::GenIndex, "col"); gc.set_attr<int64_t>(op::attr::axis, -1); gc.add_inputs({scaled}); gc.add_outputs({col});
+        lt ge(id++, dt::boolean, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op gop(id++, op::kind::GreaterEqual, "ge"); gop.add_inputs({rs, col}); gop.add_outputs({ge});
+        lt ninf(id++, dt::f32, lt::dims{1}, lt::layout_type::strided);
+        lt masked(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
+        op sel(id++, op::kind::Select, "sel"); sel.add_inputs({ge, scaled, ninf}); sel.add_outputs({masked});
+        ops.insert(ops.end(), {gr, add, sub, gc, gop, sel});
+        extra_ins = {lk, lq, ninf};
+        sm_in = masked;
+    }
+    lt probs(id++, dt::f16, {1, Hk, G, Q, L}, lt::layout_type::strided);
+    op sm(id++, op::kind::SoftMax, "softmax"); sm.set_attr<int64_t>(op::attr::axis, -1);
+    sm.set_attr<std::string>(op::attr::mode, "inf_as_zero");
+    sm.add_inputs({sm_in}); 
+    lt stats(id++, dt::f32, {1, Hk, G, Q, 1}, {Hq * Q, G * Q, Q, 1, 1});
+    if (with_lse) sm.add_outputs({probs, stats}); else sm.add_outputs({probs});
+    lt value(id++, dt::f16, {1, Hk, 1, L, D}, {Hk * L * D, L * D, L * D, D, 1});
+    lt output(id++, dt::f16, {1, Hk, G, Q, D}, {Hq * Q * D, G * Q * D, Q * D, D, 1});
+    op bmm2(id++, op::kind::MatMul, "bmm2"); bmm2.add_inputs({probs, value}); bmm2.add_outputs({output});
+    ops.insert(ops.end(), {sm, bmm2});
+    graph g(dnnl::engine::kind::gpu);
+    for (auto& o : ops) g.add_op(o);
+    g.finalize();
+    auto parts = g.get_partitions();
+    TORCH_CHECK(parts.size() == 1, "oneDNN SDPA: pattern not fused (", parts.size(), " partitions)");
+    std::vector<lt> ins{query, keyt, scale};
+    ins.insert(ins.end(), extra_ins.begin(), extra_ins.end());
+    ins.push_back(value);
+    std::vector<lt> outs{output};
+    if (with_lse) outs.push_back(stats);
+    auto cp = parts[0].compile(ins, outs, c.eng);
+    return cache.emplace(key, Entry{cp, ins, outs}).first->second;
+}
+}  // namespace sdpadnnl
+
+static void sdpa_impl(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
+                      int64_t len_k, int64_t len_q);
+void exl3_sdpa(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale) {
+    sdpa_impl(q, k, v, out, lse, causal, scale, k.size(1), q.size(1));
+}
+// Padded dims, real lengths for the bottom-right mask: keys >= len_k are masked for every row.
+void exl3_sdpa_len(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
+                   int64_t len_k, int64_t len_q) {
+    TORCH_CHECK(causal, "exl3_sdpa_len: causal only");
+    sdpa_impl(q, k, v, out, lse, causal, scale, len_k, len_q);
+}
+static void sdpa_impl(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
+                      int64_t len_k, int64_t len_q) {
+    TORCH_CHECK(q.scalar_type() == at::kHalf && k.scalar_type() == at::kHalf && v.scalar_type() == at::kHalf);
+    TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous() && out.is_contiguous());
+    int64_t Hq = q.size(0), Q = q.size(1), D = q.size(2), Hk = k.size(0), L = k.size(1);
+    auto& qq = queue_of(q);
+    auto& c = sdpadnnl::ctx(qq);
+    bool with_lse = lse.defined() && lse.numel() > 0;
+    auto& e = sdpadnnl::build(c, Q, L, Hq, Hk, D, causal, with_lse);
+    using dnnl::graph::tensor;
+    static std::vector<at::Tensor> sc(16), ni(16);
+    auto& st = sc.at(q.device().index());
+    if (!st.defined() || std::abs(st.item<float>() - (float)(1.0 / scale)) > 1e-3f) st = at::full({1}, (float)(1.0 / scale), q.options().dtype(at::kHalf));
+    auto& nt = ni.at(q.device().index());
+    if (!nt.defined()) nt = at::full({1}, -std::numeric_limits<float>::infinity(), q.options().dtype(at::kFloat));
+    int32_t lk = (int32_t)len_k, lq = (int32_t)len_q;
+    std::vector<tensor> ins{tensor(e.ins[0], c.eng, q.data_ptr()), tensor(e.ins[1], c.eng, k.data_ptr()),
+                            tensor(e.ins[2], c.eng, st.data_ptr())};
+    size_t vi = 3;
+    if (causal) {
+        ins.push_back(tensor::make_scalar_tensor(e.ins[3], &lk));
+        ins.push_back(tensor::make_scalar_tensor(e.ins[4], &lq));
+        ins.push_back(tensor(e.ins[5], c.eng, nt.data_ptr()));
+        vi = 6;
+    }
+    ins.push_back(tensor(e.ins[vi], c.eng, v.data_ptr()));
+    std::vector<tensor> outs{tensor(e.outs[0], c.eng, out.data_ptr())};
+    if (with_lse) outs.push_back(tensor(e.outs[1], c.eng, lse.data_ptr()));
+    dnnl::graph::sycl_interop::execute(e.cp, c.strm, ins, outs);
+}
+#endif
+
+// W8A8 prefill (opt-in): mul1 codebook values are bounded by 3.453125, one static int8 scale for every tensor
+static bool g_int8 = false;
+void exl3_set_int8(int64_t on) { g_int8 = on != 0; }
+constexpr float kQ8WMax = 3.453125f;
+
+template <int K>
+static void launch_reconstruct_q8(const at::Tensor& tr, at::Tensor& w, int n0, sycl::queue& q) {
+    int tk = tr.size(0), tiles_n = tr.size(1), n_out = w.size(1);
+    constexpr int NT = 8;
+    int n_strips = n_out / (16 * NT);
+    ReconstructKernel<K, 2, NT, int8_t> k{reinterpret_cast<const uint32_t*>(tr.data_ptr()),
+                                          reinterpret_cast<int8_t*>(w.data_ptr()), tiles_n, n0 / 16, n_out, n_strips, tk,
+                                          127.0f / kQ8WMax};
+    int n = n_strips * tk, local = 8;
+    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
+}
+
+void exl3_reconstruct(at::Tensor trellis, at::Tensor w, int64_t n0, int64_t K, int64_t cb) {
+    TORCH_CHECK(w.scalar_type() == at::kHalf && w.is_contiguous() && w.size(1) % 128 == 0 && n0 % 128 == 0);
+    TORCH_CHECK(w.size(0) == trellis.size(0) * 16 && n0 + w.size(1) <= trellis.size(1) * 16);
+    auto& q = queue_of(w);
+    bool ok = true;
+    if (K == 4 && cb == 2) launch_reconstruct<4, 2>(trellis, w, n0, q);
+    else if (K == 6 && cb == 2) launch_reconstruct<6, 2>(trellis, w, n0, q);
+    // K=3, K=4, K=6 / MCG (cb=1): the routed-expert, shared-expert, and LM-head
+    // formats of Qwen3.5-35B-A3B. Kept out of the ALL_CODEBOOKS block so the default
+    // build can always dequantize this checkpoint on the prefill (reconstruct + GEMM) path.
+    else if (K == 3 && cb == 1) launch_reconstruct<3, 1>(trellis, w, n0, q);
+    else if (K == 4 && cb == 1) launch_reconstruct<4, 1>(trellis, w, n0, q);
+    else if (K == 6 && cb == 1) launch_reconstruct<6, 1>(trellis, w, n0, q);
+#ifdef EXL3_ALL_CODEBOOKS
+    else if (K == 2 && cb == 2) launch_reconstruct<2, 2>(trellis, w, n0, q);
+    else if (K == 3 && cb == 2) launch_reconstruct<3, 2>(trellis, w, n0, q);
+    else if (K == 5 && cb == 2) launch_reconstruct<5, 2>(trellis, w, n0, q);
+    else if (K == 4 && cb == 0) launch_reconstruct<4, 0>(trellis, w, n0, q);
+#endif
+    else ok = false;
+    TORCH_CHECK(ok, "exl3_reconstruct: unsupported K/cb");
+}
+
+// Debug/verification: part = xh_blocked @ W_inner via a forced path (0 = vector, 1 = DPAS), summed over splits.
+at::Tensor exl3_gemm_raw(at::Tensor xh_blocked, at::Tensor trellis, at::Tensor shard_of_nb, int64_t N, int64_t K,
+                         int64_t cb, int64_t path) {
+    auto& q = queue_of(xh_blocked);
+    int S = xh_blocked.size(0), Kdim = xh_blocked.size(1) * 16, M = xh_blocked.size(2);
+    bool use_vec = path == 0;
+    if (!use_vec) {
+#if defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
+        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
+#elif defined(EXL3_DPAS_MB24)
+        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
+#else
+        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
+#endif
+        int Mp = (M + MBp - 1) / MBp * MBp;
+        if (Mp != M) xh_blocked = at::constant_pad_nd(xh_blocked, {0, 0, 0, Mp - M}).contiguous();
+    }
+    int MR = M <= 1 ? 1 : (M <= 2 ? 2 : (M <= 4 ? 4 : 8));
+#ifdef EXL3_DPAS_MB4
+    int MB = M <= 4 ? 4 : (M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64)));
+#elif defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
+#elif defined(EXL3_DPAS_MB24)
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
+#else
+    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
+#endif
+    int tk = Kdim / 16;
+    int P = 4, rps = (tk + P - 1) / P; P = (tk + rps - 1) / rps;
+    auto part = at::zeros({P, M, N}, xh_blocked.options().dtype(at::kFloat));
+    bool ok = false;
+    if (K == 4 && cb == 2) ok = use_vec ? dispatch_mr<4, 2>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q)
+                                        : dispatch_dpas<4, 2>(MB, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    if (K == 6 && cb == 2) ok = use_vec ? dispatch_mr<6, 2>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q)
+                                        : dispatch_dpas<6, 2>(MB, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    if (K == 3 && cb == 1) ok = use_vec && dispatch_mr<3, 1>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
+    TORCH_CHECK(ok);
+    (void)S;
+    return part.sum(0);
+}
+
+// Prefill helpers: row-major input Hadamard (GEMM operand) and fp16 output Hadamard.
+void exl3_had_in_rm(at::Tensor x, at::Tensor suh, at::Tensor xh) {
+    TORCH_CHECK(xh.scalar_type() == at::kHalf && xh.is_contiguous() && xh.size(1) == x.size(0));
+    auto& q = queue_of(x);
+    if (x.scalar_type() == at::kHalf) launch_had_in<fp16>(x, suh, xh, q, true);
+    else if (x.scalar_type() == at::kBFloat16) launch_had_in<sycl::ext::oneapi::bfloat16>(x, suh, xh, q, true);
+    else TORCH_CHECK(false, "x dtype");
+}
+
+void exl3_had_out_h(at::Tensor y, at::Tensor svh, at::Tensor out) {
+    TORCH_CHECK(y.scalar_type() == at::kHalf && y.is_contiguous() && y.sizes() == out.sizes());
+    auto& q = queue_of(y);
+    if (out.scalar_type() == at::kHalf) launch_had_out<fp16, fp16>(y, 1, svh, out, q);
+    else if (out.scalar_type() == at::kBFloat16) launch_had_out<sycl::ext::oneapi::bfloat16, fp16>(y, 1, svh, out, q);
+    else TORCH_CHECK(false, "out dtype");
+}
+
+// ---- flash-attention forward (prefill), fp16, head_dim 256, GQA; returns O and natural-log LSE
+void exl3_fa_fwd(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale) {
+    TORCH_CHECK(q.scalar_type() == at::kHalf && k.scalar_type() == at::kHalf && v.scalar_type() == at::kHalf);
+    TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous() && out.is_contiguous() && lse.is_contiguous());
+    TORCH_CHECK(q.size(2) == 256 && k.size(2) == 256, "head_dim 256 only");
+    int Lq = q.size(0), Hq = q.size(1), Lk = k.size(0), Hk = k.size(1);
+    TORCH_CHECK(Hq % Hk == 0);
+    int G = Hq / Hk;
+    auto& qq = queue_of(q);
+    exl3fa::FaKernel kern{reinterpret_cast<const sycl::half*>(q.data_ptr()), reinterpret_cast<const sycl::half*>(k.data_ptr()),
+                          reinterpret_cast<const sycl::half*>(v.data_ptr()), reinterpret_cast<sycl::half*>(out.data_ptr()),
+                          lse.data_ptr<float>(), Lq, Lk, Hq, Hk, G, (float)(scale * 1.4426950408889634), causal ? 1 : 0};
+    int qtiles = (Lq + exl3fa::QR - 1) / exl3fa::QR;
+    int n = qtiles * Hk * G;
+    sycl::ext::oneapi::experimental::properties props{sycl::ext::intel::experimental::grf_size<256>};
+    qq.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(n, G), props, kern); });
+}
+
+bool exl3_supported(int64_t K, int64_t cb);
+
+// ------------------------------------------------------------------------------------------------
+// The whole EXL3 linear as one C++ op (no Python on the per-call path).
+//   M <= small_m_max : fused decode-in-GEMM (vector / DPAS)
+//   otherwise        : row-major input Hadamard -> reconstruct W_inner slices -> oneDNN GEMM -> output Hadamard
+
+// NOTE: the large-M path used to reconstruct into a per-device static scratch
+// buffer. That buffer was not keyed by stream, so two in-flight calls on
+// different XPU streams would race on the same weight slice. Allocate the
+// slice per call instead: the caching allocator is stream-ordered, so
+// concurrent calls get distinct, safe buffers and the block is reused on the
+// same stream once the call returns. At RECON_SLICE_N=1024 this is a bounded
+// k*1024 fp16 slice (4 MiB at k=2048), never a persistent per-layer copy.
+
+at::Tensor exl3_linear(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
+                       std::vector<int64_t> group_bounds, int64_t K, int64_t cb, int64_t small_m_max,
+                       int64_t slice_n) {
+    auto shape = x.sizes().vec();
+    int64_t k = shape.back();
+    int64_t n = svh.size(0);
+    auto x2 = x.reshape({-1, k});
+    if (!x2.is_contiguous()) x2 = x2.contiguous();
+    int64_t M = x2.size(0);
+    shape.back() = n;
+    auto out = at::empty({M, n}, x.options());
+    if (M == 0) return out.view(shape);
+    if (M <= small_m_max && exl3_supported(K, cb)) {
+        exl3_gemm_small(x2, trellis, suh, svh, shard_of_nb, out, K, cb);
+        return out.view(shape);
+    }
+    int64_t S = suh.size(0);
+    if (g_int8 && cb == 2 && (K == 4 || K == 6) && M > 16) {
+        auto& q = queue_of(x2);
+#ifdef EXL3_DNNL
+        // GEMM rows padded to 256: bounds the number of oneDNN primitives (one per (Ms, K, N)) on real traffic
+        const int64_t Ms = (M + 255) / 256 * 256;
+#else
+        const int64_t Ms = M;
+#endif
+        auto xq = at::empty({S, Ms, k}, x.options().dtype(at::kChar));
+        auto sx = at::empty({S, Ms}, x.options().dtype(at::kFloat));
+        int n_in = S * M, local = 8;
+        auto run_in = [&](auto tag) {
+            using TIn = decltype(tag);
+            int kb_n = (int)(k / 128);
+            auto wg = [&](auto kern, int tpr) {
+                q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>((size_t)n_in * tpr, tpr), kern); });
+            };
+            if (kb_n <= 8 * 6) {
+                wg(HadInQ8WgKernel<TIn, 8, 6>{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
+                                              reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
+                                              (int)x2.stride(0), (int)Ms}, 8);
+                return;
+            }
+            if (kb_n <= 16 * 9) {
+                wg(HadInQ8WgKernel<TIn, 16, 9>{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
+                                               reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
+                                               (int)x2.stride(0), (int)Ms}, 16);
+                return;
+            }
+            HadInQ8Kernel<TIn> kin{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
+                                   reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
+                                   (int)x2.stride(0), (int)Ms};
+            q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n_in, local), local), kin); });
+        };
+        if (x2.scalar_type() == at::kHalf) run_in(fp16{});
+        else if (x2.scalar_type() == at::kBFloat16) run_in(sycl::ext::oneapi::bfloat16{});
+        else TORCH_CHECK(false, "x dtype");
+        const float sw = kQ8WMax / 127.0f;
+#ifdef EXL3_DNNL
+        {
+            static std::vector<at::Tensor> swd(16);
+            auto& swt = swd.at(x.device().index());
+            if (!swt.defined()) swt = at::full({1}, sw, x.options().dtype(at::kFloat));
+            auto y = at::empty({Ms, n}, x.options().dtype(at::kHalf));
+            for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
+                int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1], ng = g1 - g0;
+                auto w = at::empty({k, ng}, x.options().dtype(at::kChar));
+                if (K == 4) launch_reconstruct_q8<4>(trellis, w, g0, q); else launch_reconstruct_q8<6>(trellis, w, g0, q);
+                q8dnnl::gemm(q, x, reinterpret_cast<const int8_t*>(xq.data_ptr()) + g * Ms * k,
+                             reinterpret_cast<const int8_t*>(w.data_ptr()), swt.data_ptr<float>(),
+                             sx.data_ptr<float>() + g * Ms, reinterpret_cast<fp16*>(y.data_ptr()) + g0, Ms, k, ng, n);
+            }
+            exl3_had_out_h(y.narrow(0, 0, M), svh, out);
+            return out.view(shape);
+        }
+#endif
+        for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
+            int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1], ng = g1 - g0;
+            auto w = at::empty({k, ng}, x.options().dtype(at::kChar));
+            if (K == 4) launch_reconstruct_q8<4>(trellis, w, g0, q); else launch_reconstruct_q8<6>(trellis, w, g0, q);
+            auto y = at::_int_mm(xq[g], w);                                   // [M, ng] int32
+            int n_out = M * (ng / 128);
+            auto run_out = [&](auto tag) {
+                using TOut = decltype(tag);
+                HadOutQ8Kernel<TOut> ko{y.data_ptr<int32_t>(), sx.data_ptr<float>() + g * M,
+                                        reinterpret_cast<const fp16*>(svh.data_ptr()) + g0,
+                                        reinterpret_cast<TOut*>(out.data_ptr()) + g0, (int)M, (int)ng, (int)n, sw};
+                q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n_out, local), local), ko); });
+            };
+            if (out.scalar_type() == at::kHalf) run_out(fp16{});
+            else run_out(sycl::ext::oneapi::bfloat16{});
+        }
+        return out.view(shape);
+    }
+    auto xh = at::empty({S, M, k}, x.options().dtype(at::kHalf));
+    exl3_had_in_rm(x2, suh, xh);
+    auto y = at::empty({M, n}, x.options().dtype(at::kHalf));
+    for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
+        int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1];
+        for (int64_t n0 = g0; n0 < g1; n0 += slice_n) {
+            int64_t n1 = std::min(n0 + slice_n, g1);
+            auto w = at::empty({k, n1 - n0}, x.options().dtype(at::kHalf));
+            exl3_reconstruct(trellis, w, n0, K, cb);
+            auto yslice = y.narrow(1, n0, n1 - n0);
+            at::matmul_out(yslice, xh[g], w);
+        }
+    }
+    exl3_had_out_h(y, svh, out);
+    return out.view(shape);
+}
+
+at::Tensor exl3_linear_meta(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
+                            std::vector<int64_t> group_bounds, int64_t K, int64_t cb, int64_t small_m_max,
+                            int64_t slice_n) {
+    auto shape = x.sizes().vec();
+    shape.back() = svh.size(0);
+    return at::empty(shape, x.options());
+}
+
+bool exl3_supported(int64_t K, int64_t cb) {
+    if (cb == 2 && (K == 4 || K == 6)) return true;
+    if (cb == 1 && K == 3) return true;   // Qwen3.5-35B-A3B routed experts
+#ifdef EXL3_ALL_CODEBOOKS
+    if (cb == 2 && (K == 2 || K == 3 || K == 5)) return true;
+    if ((cb == 0 || cb == 1) && (K == 4 || K == 6)) return true;
+#endif
+    return false;
+}
+
+// Largest M the fused small-M path can serve for a given (K, cb).
+// Formats with a DPAS instantiation are bounded only by the caller's
+// SMALL_M_MAX (Python caps at 128); the vector-only K=3/mcg routed-expert
+// path is bounded by the vector kernel's row limit (g_vec_max_m == 8 on this
+// no-XMX part, where dispatch_dpas<K,1> is deliberately not instantiated).
+int64_t exl3_small_m_max(int64_t K, int64_t cb) {
+    if (!exl3_supported(K, cb)) return 0;
+    if (K == 3 && cb == 1) return g_vec_max_m;
+    return 1 << 20;
+}
+
+void exl3_set_target_threads(int64_t n) { g_target_threads = (int)n; }
+void exl3_set_target_threads_mb64(int64_t n) { g_target_threads_mb64 = (int)n; }
+void exl3_set_target_threads_mb16(int64_t n) { g_target_threads_mb16 = (int)n; }
+void exl3_set_vec_max_m(int64_t n) { g_vec_max_m = (int)n; }
+
+TORCH_LIBRARY(exl3xpu_C, m) {
+    m.def("exl3_set_int8(int on) -> ()", &exl3_set_int8);
+#ifdef EXL3_DNNL
+    m.def("exl3_sdpa(Tensor q, Tensor k, Tensor v, Tensor(a!) out, Tensor(b!) lse, bool causal, float scale) -> ()");
+    m.impl("exl3_sdpa", torch::kXPU, &exl3_sdpa);
+    m.def("exl3_sdpa_len(Tensor q, Tensor k, Tensor v, Tensor(a!) out, Tensor(b!) lse, bool causal, float scale, int len_k, int len_q) -> ()");
+    m.impl("exl3_sdpa_len", torch::kXPU, &exl3_sdpa_len);
+#endif
+    m.def("linear(Tensor x, Tensor trellis, Tensor suh, Tensor svh, Tensor shard_of_nb, int[] group_bounds, int K, int cb, int small_m_max, int slice_n) -> Tensor");
+    m.impl("linear", torch::kXPU, &exl3_linear);
+    m.def("exl3_gemm_small(Tensor x, Tensor trellis, Tensor suh, Tensor svh, Tensor shard_of_nb, Tensor(a!) out, int K, int cb) -> ()");
+    m.impl("exl3_gemm_small", torch::kXPU, &exl3_gemm_small);
+    m.def("exl3_supported(int K, int cb) -> bool", &exl3_supported);
+    m.def("exl3_small_m_max(int K, int cb) -> int", &exl3_small_m_max);
+    m.def("exl3_had_in_rm(Tensor x, Tensor suh, Tensor(a!) xh) -> ()");
+    m.impl("exl3_had_in_rm", torch::kXPU, &exl3_had_in_rm);
+    m.def("exl3_had_out_h(Tensor y, Tensor svh, Tensor(a!) out) -> ()");
+    m.impl("exl3_had_out_h", torch::kXPU, &exl3_had_out_h);
+    m.def("exl3_reconstruct(Tensor trellis, Tensor(a!) w, int n0, int K, int cb) -> ()");
+    m.impl("exl3_reconstruct", torch::kXPU, &exl3_reconstruct);
+    m.def("exl3_gemm_raw(Tensor xh_blocked, Tensor trellis, Tensor shard_of_nb, int N, int K, int cb, int path) -> Tensor");
+    m.impl("exl3_gemm_raw", torch::kXPU, &exl3_gemm_raw);
+    m.def("exl3_set_target_threads(int n) -> ()", &exl3_set_target_threads);
+    m.def("exl3_set_target_threads_mb64(int n) -> ()", &exl3_set_target_threads_mb64);
+    m.def("exl3_set_target_threads_mb16(int n) -> ()", &exl3_set_target_threads_mb16);
+    m.def("exl3_set_vec_max_m(int n) -> ()", &exl3_set_vec_max_m);
+    m.def("exl3_set_fused(int on) -> ()", &exl3_set_fused);
+    m.def("exl3_set_local(int n) -> ()", &exl3_set_local);
+    m.def("exl3_set_max_mb(int n) -> ()", &exl3_set_max_mb);
+    m.def("exl3_fa_fwd(Tensor q, Tensor k, Tensor v, Tensor(a!) out, Tensor(b!) lse, bool causal, float scale) -> ()");
+    m.impl("exl3_fa_fwd", torch::kXPU, &exl3_fa_fwd);
+}

## file: bench/moe_profile.py
--- a/bench/moe_profile.py	2026-10-21 22:05:50.341775534 +0200
+++ b/bench/moe_profile.py	2026-10-24 20:39:49.744585708 +0200
